                    {
                      "text": "#!/usr/bin/env python3\n\"\"\"\n项目评估与报价 — Excel 报价表单生成器\n\nUsage:\n    from gen_quotation import generate_quotation\n    generate_quotation(output_path, scheme_label, evo_license, deploy_fee,\n                       unit_price, dev_groups, notes, version)\n\nor CLI:\n    python3 gen_quotation.py --help\n\"\"\"\nimport openpyxl\nfrom openpyxl.styles import Font, Alignment, Border, Side, PatternFill\n\n# ── Styles ──\nthin = Side(style='thin')\nBA = Border(left=thin, right=thin, top=thin, bottom=thin)\nFONT_TITLE = Font(name='微软雅黑', bold=True, size=14)\nFONT_NORMAL = Font(name='微软雅黑', size=10)\nFONT_BOLD = Font(name='微软雅黑', bold=True, size=10)\nFONT_NOTE = Font(name='微软雅黑', size=9, color='666666')\nFILL_CAT = PatternFill(start_color='D9E2F3', end_color='D9E2F3', fill_type='solid')\nFILL_HEADER = PatternFill(start_color='4472C4', end_color='4472C4', fill_type='solid')\nFONT_HEADER = Font(name='微软雅黑', bold=True, size=10, color='FFFFFF')\nFILL_TOTAL = PatternFill(start_color='FFF2CC', end_color='FFF2CC', fill_type='solid')\nFILL_EVO = PatternFill(start_color='DAEEF3', end_color='DAEEF3', fill_type='solid')\nFILL_EVO2 = PatternFill(start_color='B7DEE8', end_color='B7DEE8', fill_type='solid')\nFILL_GREEN = PatternFill(start_color='E2EFDA', end_color='E2EFDA', fill_type='solid')\nALIGN_C = Alignment(horizontal='center', vertical='center', wrap_text=True)\nALIGN_L = Alignment(horizontal='left', vertical='center', wrap_text=True)\nALIGN_R = Alignment(horizontal='right', vertical='center')\n\n# ── EvoMind 底座能力清单（固定） ──\nEVO_ITEMS = [\n    ('EvoMind\\n底座平台\\n（授权使用）', '多智能体调度引擎', 'Multi-Agent调度',\n     '支持多智能体协同工作、动态任务分配与编排，Agent间可相互调用、传递上下文，实现复杂任务的自动拆解与并行处理'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '全链路记忆系统', 'Memory',\n     '持久化多轮对话记忆，支持跨会话上下文关联；Agent可自动提取关键信息写入长期记忆，实现知识的持续积累与个性化响应'),\n    ('EvoMind\\n底座平台\\n（授权使用）', 'Skills技能模块', 'Skills引擎',\n     '内置可扩展的技能插件体系，支持系统预置和用户安装技能；技能广场展示可用技能列表，一键激活；支持基于自然语言描述自主生成Skill脚本'),\n    ('EvoMind\\n底座平台\\n（授权使用）', 'MCP工具集框架', 'MCP工具协议',\n     '基于AI模型上下文协议的工具集成框架，支持连接外部数据源/API/数据库；Agent可动态调用已注册工具完成数据查询、计算、预测等任务'),\n    ('EvoMind\\n底座平台\\n（授权使用）', 'LLM Wiki知识库', '向量知识库引擎',\n     '支持PDF/Word/MD/TXT等多格式文档上传，自动文本提取、分块与向量化索引；提供关键词+语义混合检索接口，支持后台异步重索引'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '多模态处理能力', '文件解析引擎',\n     '支持图片/PDF/Word/PPT文件的纯文本内容提取与解析，Agent可基于提取内容进行对话应答'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '对话交互引擎', '流式对话引擎',\n     'SSE流式响应输出、多轮上下文管理（窗口滑动/压缩）、对话内文件附件上传处理(.pdf/.docx/.md/.txt ≤2GB)、历史会话管理（近100条）'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '定时任务引擎', 'Cron调度系统',\n     '支持通过自然语言设定定时任务、系统自动按时执行预设的查询、数据推送或提醒；支持定时任务的启动/暂停/修改/取消等生命周期管理'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '多模型支持', '模型路由层',\n     '支持多种AI大模型的灵活切换与配置管理，可根据任务类型自动选择最优模型，降低Token成本'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '安全防护体系', '鉴权与安全',\n     '统一JWT身份鉴权；提示词防注入引擎；基于关键词和正则的数据脱敏；API访问限流'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '用户权限管理', '用户体系',\n     '手机号注册+短信验证码登录（阿里云短信）；访客审批机制；正式用户权限回收；管理员可查看/删除用户，管理云盘空间'),\n    ('EvoMind\\n底座平台\\n（授权使用）', '项目工作区管理', '文件与项目管理',\n     '公共工作区+项目工作区；文件多层级管理（≤5级嵌套）；文件上传/重命名/删除/下载；批量操作（≤10文件）；新建/切换项目'),\n]\n\n\ndef _sc(cell, **kw):\n    kw = {k: v for k, v in kw.items() if v is not None}\n    for k, v in kw.items():\n        setattr(cell, k, v)\n\n\ndef generate_quotation(output_path, scheme_label, evo_license, deploy_fee,\n                       unit_price, dev_groups, notes, version='v1.0',\n                       title_suffix=''):\n    \"\"\"\n    生成报价 Excel 文件。\n\n    参数:\n        output_path: 输出 Excel 文件路径\n        scheme_label: 方案标签（如 \"方案A：基于EvoMind-KM一期增量开发\"）\n        evo_license: EvoMind 底座授权费（3年），0 表示不含授权\n        deploy_fee: 部署运维费（3年）\n        unit_price: 人日单价（如 1000）\n        dev_groups: list of (类别名, [(模块名, 功能名, 功能描述, 人天), ...])\n        notes: 备注文本\n        version: 版本号\n        title_suffix: 项目名称后缀\n    \"\"\"\n    wb = openpyxl.Workbook()\n    ws = wb.active\n    ws.title = '报价单'\n\n    # Column widths\n    for c, w in zip('ABCDEFG', [16, 22, 18, 36, 10, 11, 12]):\n        ws.column_dimensions[c].width = w\n\n    # Title area\n    ws.merge_cells('A1:G1')\n    _sc(ws.cell(row=1, column=1, value=f'上海胆大求索科技有限公司报价单 ({version})'),\n        font=FONT_TITLE, alignment=ALIGN_C)\n    ws.row_dimensions[1].height = 32\n\n    ws.merge_cells('A2:G2')\n    _sc(ws.cell(row=2, column=1, value=f'项目名称：水产智能决策Agent系统{title_suffix}'),\n        font=FONT_BOLD)\n\n    ws.merge_cells('A3:G3')\n    _sc(ws.cell(row=3, column=1, value=f'【{scheme_label}】'),\n        font=Font(name='微软雅黑', bold=True, size=11, color='C00000'), alignment=ALIGN_C)\n\n    ws.merge_cells('A4:G4')\n    _sc(ws.cell(row=4, column=1,\n        value=f'联系人：张文 | ***8572 | ***@*** | 报价有效期：30天 | 版本：{version}'),\n        font=FONT_NORMAL, alignment=ALIGN_C)\n    ws.row_dimensions[4].height = 20\n\n    # Header\n    headers = ['类别\\nType', '页面/模块\\nModule', '功能\\nFunctions',\n               '功能介绍\\nIntroduce', '人天/数量\\nQuantity', '单价\\nUnit Price', '总计\\nTotal']\n    for c, h in enumerate(headers, 1):\n        _sc(ws.cell(row=6, column=c, value=h), font=FONT_HEADER, fill=FILL_HEADER,\n            alignment=ALIGN_C, border=BA)\n    ws.row_dimensions[6].height = 36\n\n    r = 7\n\n    # ── EvoMind base section (if license > 0) ──\n    if evo_license > 0:\n        evo_start = r\n        for cat, mod, func, desc in EVO_ITEMS:\n            _sc(ws.cell(row=r, column=1, value=cat if r == evo_start else ''),\n                font=FONT_NORMAL, alignment=ALIGN_C, border=BA)\n            _sc(ws.cell(row=r, column=2, value=mod), font=FONT_BOLD, alignment=ALIGN_L, border=BA)\n            _sc(ws.cell(row=r, column=3, value=func), font=FONT_NORMAL, alignment=ALIGN_L, border=BA)\n            _sc(ws.cell(row=r, column=4, value=desc), font=FONT_NORMAL, alignment=ALIGN_L, border=BA)\n            _sc(ws.cell(row=r, column=5, value='✓'),\n                font=Font(name='微软雅黑', size=10, color='2E7D32'), alignment=ALIGN_C, border=BA)\n            _sc(ws.cell(row=r, column=6, value='授权'),\n                font=Font(name='微软雅黑', size=9, color='1565C0'), alignment=ALIGN_C, border=BA)\n            _sc(ws.cell(row=r, column=7, value='授权'),\n                font=Font(name='微软雅黑', size=9, color='1565C0'), alignment=ALIGN_C, border=BA)\n            r += 1\n        evo_end = r - 1\n        if evo_end > evo_start:\n            ws.merge_cells(start_row=evo_start, start_column=1, end_row=evo_end, end_column=1)\n            for rr in range(evo_start + 1, evo_end + 1):\n                ws.cell(row=rr, column=1).border = BA\n\n        # License total row\n        ws.merge_cells(start_row=r, start_column=1, end_row=r, end_column=4)\n        _sc(ws.cell(row=r, column=1, value='EvoMind底座 3年授权使用费（上述全部能力）'),\n            font=FONT_BOLD, alignment=ALIGN_R, border=BA, fill=FILL_EVO2)\n        for cc in range(1, 8):\n            _sc(ws.cell(row=r, column=cc), border=BA, fill=FILL_EVO2)\n        _sc(ws.cell(row=r, column=7, value=evo_license),\n            font=FONT_BOLD, alignment=ALIGN_R, border=BA, number_format='#,##0', fill=FILL_EVO2)\n        r += 1\n\n        # Separator\n        ws.row_dimensions[r].height = 8\n        r += 1\n\n    # ── Development sections ──\n    total_dev = 0\n    for cat_name, items in dev_groups:\n        cat_start = r\n        for i, (mod, func, desc, qty) in enumerate(items):\n            amt = qty * unit_price\n            total_dev += amt\n            _sc(ws.cell(row=r, column=1, value=cat_name if i == 0 else ''),\n                font=FONT_NORMAL, alignment=ALIGN_C, border=BA)\n            _sc(ws.cell(row=r, column=2, value=mod), font=FONT_BOLD, alignment=ALIGN_L, border=BA)\n            _sc(ws.cell(row=r, column=3, value=func), font=FONT_NORMAL, alignment=ALIGN_L, border=BA)\n            _sc(ws.cell(row=r, column=4, value=desc), font=FONT_NORMAL, alignment=ALIGN_L, border=BA)\n            _sc(ws.cell(row=r, column=5, value=qty), font=FONT_NORMAL, alignment=ALIGN_C, border=BA)\n            _sc(ws.cell(row=r, column=6, value=unit_price), font=FONT_NORMAL, alignment=ALIGN_R,\n                border=BA, number_format='#,##0')\n            _sc(ws.cell(row=r, column=7, value=amt), font=FONT_NORMAL, alignment=ALIGN_R,\n                border=BA, number_format='#,##0')\n            r += 1\n        cat_end = r - 1\n        if cat_\n…(truncated)…",
