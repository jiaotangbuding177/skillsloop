            "content": "模板本身没有 Word 表格（用制表符排版），所以输出格式完整保留。修复一个模块名重复\"模块\"的小问题：",
            "status": "done",
            "rawPayload": {
              "toolActivity": {
                "args": {
                  "content": "#!/usr/bin/env python3.12\n\"\"\"Generate contract docx from PRD content.\"\"\"\nfrom docx import Document\nfrom docx.shared import Pt, Cm\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\n\ndoc = Document()\n\nfor section in doc.sections:\n    section.top_margin = Cm(2.54)\n    section.bottom_margin = Cm(2.54)\n    section.left_margin = Cm(3.18)\n    section.right_margin = Cm(3.18)\n\nstyle = doc.styles['Normal']\nstyle.font.name = 'SimSun'\nstyle.font.size = Pt(12)\n\ntitle = doc.add_paragraph()\ntitle.alignment = WD_ALIGN_PARAGRAPH.CENTER\nrun = title.add_run('软件委托开发合同')\nrun.font.size = Pt(18)\nrun.font.bold = True\ndoc.add_paragraph()\n\ndef H(text, size=14):\n    p = doc.add_paragraph()\n    r = p.add_run(text)\n    r.font.size = Pt(size)\n    r.font.bold = True\n    return p\n\ndef B(text):\n    p = doc.add_paragraph(text)\n    return p\n\ndef T(headers, rows):\n    table = doc.add_table(rows=len(rows)+1, cols=len(headers))\n    table.style = 'Table Grid'\n    table.alignment = WD_TABLE_ALIGNMENT.CENTER\n    for i, h in enumerate(headers):\n        c = table.rows[0].cells[i]\n        c.text = h\n        for p in c.paragraphs:\n            for r in p.runs:\n                r.font.bold = True\n                r.font.size = Pt(10)\n    for ri, row in enumerate(rows):\n        for ci, val in enumerate(row):\n            c = table.rows[ri+1].cells[ci]\n            c.text = val\n            for p in c.paragraphs:\n                for r in p.runs:\n                    r.font.size = Pt(10)\n    doc.add_paragraph()\n\ndef M(title_text, body_text):\n    p = doc.add_paragraph()\n    r = p.add_run(title_text)\n    r.font.bold = True\n    r.font.size = Pt(12)\n    B(body_text)\n\n# === PARTIES ===\nH('甲方（委托方）')\nB('名称：华东师范大学')\nB('统一社会信用代码：***ID***')\nH('乙方（开发方）')\nB('名称：上海胆大求索科技有限公司')\nB('统一社会信用代码：91310117MA1J49651P')\nB('本合同各方经平等自愿协商，根据《中华人民共和国民法典》及相关法规，就甲方委托乙方进行软件开发事宜，签订本合同以共同遵守。')\ndoc.add_paragraph()\n\n# === SECTION 1: SOFTWARE ===\nH('一、开发软件')\nH('1.1 软件基本信息', 12)\nT(['项目', '内容'], [\n    ['软件名称', '华师学术论文智能核验平台'],\n    ['使用主体', '华东师范大学在编教师、校内科研人员'],\n    ['开发期限', '自CAS对接申请与服务器资源到位之日起计算，全部功能于2026年 月 日前完成开发部署并上线试运行'],\n    ['用户量级', '万级'],\n    ['同时使用用户', '≤100人'],\n])\n\nH('1.2 主要功能', 12)\nB('面向华东师范大学在编教师及科研人员，构建论文文件上传、智能数据核验、参考文献规范校对、校对报告自动生成、历史记录存档的全流程线上闭环管理平台。依托华师大内部专属大模型（deepseek-v4-flash）作为核心智能引擎，全流程本地化部署，数据不出校。')\n\nH('1.3 使用场景', 12)\nB('教师端（PC端）：教师通过华师大CAS统一认证登录后，可上传论文主文件及配套原始数据文件，填写自定义校对备注，提交智能校对任务，在线预览及下载带专属水印的PDF校对报告，检索与回溯历史校对记录。')\nB('后台管理端：管理员可监控系统服务运行状态、任务调度及用户数据，查看全局业务概览。')\n\nH('1.4 核心功能模块', 12)\nmodules = [\n    ('模块一：统一认证与平台首页',\n     '对接华东师范大学CAS统一身份认证系统，实现教师免注册单点登录，自动同步工号与姓名，拦截外部访问。登录后首页集中展示个人校对业务数据，提供「开始新的审查」与「查看历史报告」快捷入口，显示最近三条校对任务记录。'),\n    ('模块二：论文校对提交',\n     '支持上传论文主文件（必填，PDF/DOCX/CSV/XLSX，单文件≤500MB）及原始数据文件（选填，同格式，单文件≤100MB），提供拖拽上传、进度展示、失败重试、批量管理功能。设有多行文本输入框用于填写自定义校对备注，该内容作为提示词提交给LLM引擎。提交前强制弹出合规确认弹窗，用户须勾选阅读并同意《华东师范大学论文数据校对平台上传须知及数据处理说明》全部条款后方可提交。'),\n    ('模块三：智能校对引擎（双管线异步）',\n     '数据核验管线覆盖统计数据一致性校验、数字格式校验、公式推导校验、图表数据校验、数据范围合理性校验、日期时间校验六类规则，通过交叉验证、符号计算、OCR识别与数据比对技术实现自动化审核。引用校对管线覆盖参考文献格式校验、引用一致性校验、DOI有效性校验（调用外部权威API）、自引分析校验、网页引用可达性校验五类规则，全文交叉比对正文引用标注与文末参考文献列表。两条管线独立异步执行，覆盖文理科差异化校验需求。引擎层采用容器技术实现审完即焚——每次报告审核启动独立容器，完成后立即销毁。引擎部署于华师大内部服务器，数据不出校。'),\n    ('模块四：校对报告生成与输出',\n     '校对结果标准化整合为不可编辑PDF报告，包含专属水印（\"华东师范大学论文校对报告\"+教师工号+报告生成时间）。支持在线预览与一键下载。报告覆盖25个审核维度。本报告为平台工具性校对凭证，无行政盖章效力，仅用于论文投稿自查、成果存档、项目结题质量佐证。'),\n    ('模块五：历史校对记录管理',\n     '教师所有历史校对任务永久留存，无自动清理机制。支持按论文标题模糊搜索、提交时间范围筛选、任务状态筛选。列表按提交时间倒序排列，支持无限次预览与下载报告。账号、权限、任务状态及审计记录等业务数据库部署于华师大内网，不向互联网开放。'),\n    ('模块六：数据安全体系',\n     '报告文件及上传附件存入阿里云OSS，启用服务器端加密并使用华师大指定KMS密钥，文件名仅使用系统任务编号。应用层接入华师大OAuth统一身份认证，用户仅能查看个人名下任务与报告，运维人员不默认拥有查看报告内容的权限。所有访问经华师大入口服务进行，数据库、执行容器和存储服务不直接暴露在互联网。'),\n]\nfor mt, mb in modules:\n    M(mt, mb)\n\nH('1.5 系统性能指标', 12)\nT(['指标', '要求'], [\n    ['用户规模', '万级'],\n    ['并发支持', '登录并发≥50 TPS；AI审核并发≥10 TPS'],\n    ['响应时间', '核心页面加载≤2秒，操作响应≤1秒'],\n    ['文件上传', '单文件最大500MB，支持断点续传'],\n    ['系统可用性', '≥99.5%（不含计划维护窗口）'],\n])\n\nH('1.6 开发里程碑', 12)\nT(['阶段', '交付内容', '时间节点'], [\n    ['第一阶段', 'CAS对接完成、平台首页上线、论文提交模块上线', '自开发周期起第45天'],\n    ['第二阶段', '双管线智能校对引擎完成、LLM服务对接与本地部署', '自开发周期起第90天'],\n    ['第三阶段', '校对报告模块（含水印PDF输出）、历史记录模块上线', '自开发周期起第110天'],\n    ['第四阶段', '数据安全体系集成、全平台联调与试运行', '自开发周期起第130天'],\n])\nB('除本合同另有约定外，本合同中\"开发软件\"均指上述全部模块。')\ndoc.add_paragraph()\n\n# === SECTION 2: FEES ===\nH('二、开发费用')\nH('2.1 开发费用（合同价款）', 12)\nB('本次开发费用总价（合同总价款）为：¥320,000元（人民币：叁拾贰万元整）。')\nB('本合同约定价格为含税价，增值税率为1%（百分之一）。')\n\nH('2.2 费用调整', 12)\nB('开发过程中因需求变更导致费用调整的，由双方签署需求变更单；根据双方确认的变更单相应增减费用。')\nB('增减费用的付款方式以变更单约定为准；如无特别约定，则增加的费用按本合同约定的付款方式相应支付，减少的费用则从合同总价款中相应减少。')\n\nH('2.3 付款方式', 12)\nB('首笔款：¥300,000元（人民币：叁拾万元整），于本合同签订后15个工作日内支付；')\nB('尾款：¥20,000元（人民币：贰万元整），甲方书面验收通过后的15个工作日内支付。')\nB('乙方指定收款账号：')\nB('户名：上海胆大求索科技有限公司')\nB('账号：453379887648')\nB('开户行：中国银行上海市川沙支行')\nB('乙方未授权任何员工、第三方收款；付款方未向指定账号付款导致损失的，乙方不承担任何责任。')\n\nH('2.4 发票', 12)\nB('乙方应向甲方提供正规足额增值税专用发票。发票信息如下：')\nB('名称：华东师范大学')\nB('纳税人识别号：***ID***')\nB('地址、电话：')\nB('开户行及账号：')\ndoc.add_paragraph()\n\n# === SECTION 3: DEV ARRANGEMENT ===\nH('三、开发安排')\nH('3.1 委托方配合', 12)\nB('甲方应根据开发需求和乙方说明提供具体需求文档、背景文档（下称\"开发背景资料\"）等。')\nB('如因甲方未提供开发背景资料，导致乙方开发延迟，乙方不承担相关责任。')\n\nH('3.2 设计变更', 12)\nB('如甲方对设计方案提出变更，乙方有权根据变更内容进行费用调整，同时根据变更情况延期交付，乙方不承担延期交付的违约责任。')\n\nH('3.3 交付', 12)\nB('乙方应当按照本合同及附件的约定完成开发软件的安装、部署，并向甲方交付下列文件：')\nB('（1）计算机程序。包括源代码、目标程序、可执行程序。')\nB('（2）文档。包括技术文档、用户指南、操作手册、安装指南和测试报告等。')\nB('前述源代码必须可为熟练的程序员理解和使用，可打印以及被机器阅读或具备其他合理而必要的形式，包括对开发软件的评估、测试或其它技术文件。')\nB('乙方所提交的开发软件应符合如下要求：')\nB('（1）符合国家有关软件产品方面的规定和软件标准规范；')\nB('（2）不得包含任何可以自动终止或妨碍系统运作的软件。')\ndoc.add_paragraph()\n\n# === SECTION 4: ACCEPTANCE ===\nH('四、验收')\nH('4.1 验收', 12)\nB('上线前验收：正式上线前，甲乙双方应进行上线前验收。')\nB('上线后30天为试运行期间。甲乙双方应根据试运行期间情况进行最终调试。')\n\nH('4.2 验收期限', 12)\nB('试运行通过且完成最终调试经甲方认可后，甲方应在乙方通知验收后的5个工作日内或双方约定的验收期间内完成验收。')\nB('验收期间内甲方对开发软件有异议的，应以书面形式通知乙方。乙方应在收到甲方异议之日起5个工作日内提出解决方案。')\nB('验收合格的，甲方应当签署相应阶段的验收合格文件；验收期间内甲方未签署文件亦未提出书面异议的，视为验收合格。')\ndoc.add_paragraph()\n\n# === SECTION 5: SUPPORT ===\nH('五、配套服务')\nH('5.1 后期软件维护', 12)\nB('开发软件验收合格之日起12个月内，乙方为甲方提供后期软件维护服务。该维护服务费用已经包含在开发费用中，甲方无需另外支付。')\nB('前述软件维护服务是指：保证开发软件正常运行，排除、解决开发软件中出现的功能故障。')\nB('超过上述期限后，如仍需乙方提供服务，由双方另行签订协议。')\n\nH('5.2 不得转包', 12)\nB('乙方必须自行完成本合同约定的服务，不得将全部或部分工作交由第三方完成。')\ndoc.add_paragraph()\n\n# === SECTION 6: IP ===\nH('六、知识产权')\nH('6.1 开发背景资料', 12)\nB('甲方保证所提供的开发背景资料不侵犯任何第三方的著作权、商标权、专利权、商业秘密等。')\n\nH('6.2 开发软件知识产权归属', 12)\nB('双方一致同意，开发软件过程中形成的知识产权、技术秘密、技术信息等智力成果的所有权，均归甲方所有。')\n\nH('6.3 乙方自有软件许可', 12)\nB('涉及乙方自有软件许可的，乙方应向甲方披露，双方按约定处理；乙方承诺开发软件中不包含未披露的需另外经乙方许可的内容。')\n\nH('6.4 第三方软件许可', 12)\nB('开发软件中涉及第三方软件许可的，乙方应在使用前向甲方披露并获得甲方同意，甲方如同意使用该第三方软件，应自行获得第三方的许可并承担费用，按照约定方式使用，如甲方未同意使用该第三方软件，乙方应采用其他技术方式实现有关功能；乙方承诺开发软件中不包含未披露的需另外经第三方许可使用的内容。')\n\nH('6.5 不侵权', 12)\nB('乙方保证所提交的开发软件不侵犯任何第三方的著作权、商标权、专利权、商业秘密等；也不违反乙方（包括乙方开发人员）与任何第三方的保密义务或有关知识产权约定。')\nB('若开发软件侵犯第三方知识产权的，由此造成的一切经济和法律责任由乙方承担，并且乙方应选择下列措施之一进行补救：')\nB('（1）取得第三方的许可。')\nB('（2）修改或更换开发软件使其不侵权。')\ndoc.add_paragraph()\n\n# === SECTION 7: CONFIDENTIALITY ===\nH('七、保密')\nB('乙方保证对在讨论、签订、履行本合同过程中所获悉的属于甲方及甲方关联方的且无法自公开渠道获取的保密信息予以保密。未经甲方同意，乙方不得超出本合同约定的目的和范围使用甲方提供的信息，不得向任何第三方泄露该信息的全部或部分内容，否则给甲方造成的全部损失由乙方承担。')\nB('上述保密义务，在本合同终止或解除之后仍需履行。')\nB('保密信息是指信息披露方向信息接收方在本合同签订之前或之后披露的任何非公开的信息，不论书面、口头或其他形式，包括但不限于作品、技术及经营的相关信息。作品相关信息包括艺术作品原作、照片、草稿、参数；技术信息包括技术、设计、图样、译文、图标、模型、制程、计数法、软件程序、软件来源文件、有关研究与实验工作的记录或成果等；经营信息包括营运信息、投标文件、财务/业务数据、人事数据、采购资料、客户资料或销售数据、项目组及科研人员信息、未公开的科技成果信息、技术秘密、未公开发表的科研数据等。')\ndoc.add_paragraph()\n\n# === SECTION 8: BREACH ===\nH('八、违约责任')\nH('8.1', 12)\nB('甲方逾期付款的，每逾期一天，应按逾期金额的5‱（万分之五）向乙方支付违约金，同时仍应履行付款义务。')\n\nH('8.2', 12)\nB('乙方应当在本协议约定的期限内完成软件开发义务，逾期履行合同义务的，每逾期一天，应按合同价款的5‱（万分之五）向甲方支付违约金，甲方有权从合同价款中扣除。如因甲方未在规定的期限内提供基础资料导致乙方逾期开展工作的，乙方不承担逾期违约金赔偿责任，且相应软件交付日期顺延。')\n\nH('8.3', 12)\nB('乙方有下列情形之一的，甲方有权解除本合同：')\nB('（1）逾期交付超过15天的；')\nB('（2）乙方违约，经甲方通知后15天仍不改正的；')\nB('（3）连续两次因乙方技术原因导致验收仍不合格的；')\nB('（4）乙方有其他违约行为，依照法定或约定甲方有权解除的。')\n\nH('8.4', 12)\nB('因乙方原因导致甲方解除本合同的，乙方应当同时承担下列责任：')\nB('（1）退还甲方已经支付的开发费用。')\nB('但是，经甲方同意接收、使用乙方已完成的部分开发软件的，该部分开发软件的开发费用应正常结算，不予返还。')\nB('（2）本合同约定的其他违约责任。')\n\nH('8.5', 12)\nB('任何一方有其他违反本合同情形的，应赔偿守约方全部损失。')\ndoc.add_paragraph()\n\n# === SECTION 9: CONTACTS ===\nH('九、合同联系方式')\nH('9.1 甲方项目联系人', 12)\nB('甲方确认如下项目联系信息：')\nB('联系人：')\nB('地址：')\nB('手机：')\nB('电子邮箱：')\nB('甲方确认，甲方项目联系人的权限仅限于下列：')\nB('代表甲方提交、接受项目有关资料、文档、工作成果。')\nB('代表甲方对服务提出意见。')\nB('代表甲方验收乙方提供的工作成果与服务。')\nB('代表甲方确认服务工作量及结算服务费用。')\n\nH('9.2 乙方项目联系人', 12)\nB('乙方确认如下项目联系信息：')\nB('联系人：嵇轶伦')\nB('地址：上海市浦东新区东方路18号保利E座1101室')\nB('手机：***0586')\nB('电子邮箱：***@***')\nB('乙方确认，乙方项目联系人的权限仅限于下列：')\nB('代表乙方提交、接受项目有关资料、文档、工作成果。')\nB('代表乙方对服务进行沟通、提出意见。')\nB('代表甲方确认服务工作量及结算服务费用。')\nB('除非双方另有约定，合同双方可通过指定电子邮箱提供资料、文档、工作成果电子版。')\nB('双方确认上述联系方式同时作为有效司法送达地址。')\ndoc.add_paragraph()\n\n# === SECTION 10: OTHER ===\nH('十、其他约定')\nH('10.1 不可抗力', 12)\nB('不可抗力定义：指在本合同签署后发生的、本合同签署时不能预见的、其发生与后果是无法避免或克服的、妨碍任何一方全部或部分履约的所有事件。上述事件包括地震、台风、水灾、火灾、战争、国际或国内运输中断、流行病、罢工，以及根据中国法律或一般国际商业惯例认作不可抗力的其他事件。一方缺少资金非为不可抗力事件。')\nB('不可抗力的后果：')\nB('（1）如果发生不可抗力事件，影响一方履行其在本合同项下的义务，则在不可抗力造成的延误期内中止履行，而不视为违约。')\nB('（2）宣称发生不可抗力的一方应迅速书面通知其他各方，并在其后的十五(15)天内提供证明不可抗力发生及其持续时间的足够证据。')\nB('（3）如果发生不可抗力事件，各方应立即互相协商，以找到公平的解决办法，并且应尽一切合理努力将不可抗力的影响减少到最低限度。')\nB('（4）金钱债务的迟延责任不得因不可抗力而免除。')\nB('（5）迟延履行期间发生的不可抗力不具有免责效力。')\n\nH('10.2 争议解决', 12)\nB('因本合同以及本合同项下订单/附件/补充协议等（如有）引起或有关的任何争议，由合同各方协商解决，也可由有关部门调解。协商或调解不成的，应向甲方所在地有管辖权的人民法院起诉。')\n\nH('10.3 附则', 12)\nB('本合同一式二份，合同各方各执一份。各份合同文本具有同等法律效力。')\nB('本合同未尽事宜，双方应另行协商并签订补充协议。')\nB('本合同包含如下附件：附件一：开发工作清单')\nB('上述附件是本合同的一部分，具有与本合同同等的法律效力。')\nB('本合同经各方签名或盖章后生效。')\ndoc.add_paragraph()\ndoc.add_paragraph()\n\nB('（以下无合同正文）')\ndoc.add_paragraph()\ndoc.add_paragraph()\n\nB('甲方（盖章）：')\nB('签订时间：    年    月    日')\ndoc.add_paragraph()\nB('乙方（盖章）：')\nB('签订时间：    年    月    日')\n\n# === PAGE BREAK for ATTACHMENT ===\ndoc.add_page_break()\n\nH('附件一：开发工作清单')\ndoc.add_paragraph()\nT(['序号', '模块', '工作内容', '交付物'], [\n    ['1', '统一认证模块', 'CAS协议对接、单点登录实现、用户身份自动甄别、账号自动创建与信息同步', '接口文档、部署配置'],\n    ['2', '平台首页模块', '快捷操作入口、个人业务数据概览、最近任务记录展示', '前端页面、后端接口'],\n    ['3', '论文提交模块', '多格式文件上传（PDF/DOCX/CSV/XLSX）、拖拽上传、进度展示、失败重试、自定义备注输入、合规确认弹窗', '前端组件、文件处理服务'],\n    ['4', '数据核验管线', '六类校验规则引擎（统计一致性、数字格式、公式推导、图表比对、范围合理性、日期时间）', '规则引擎、API接口'],\n    ['5', '引用校对管线', '五类校验规则引擎（参考文献格式、引用一致性、DOI有效性、自引分析、网页引用可达性）、外部API对接', '规则引擎、API接口'],\n    ['6', 'LLM服务对接', 'deepseek-v4-flash模型集成、提示词工程、异步任务调度、容器化部署', '部署脚本、配置文档'],\n    ['7', '校对报告模块', '25维审核报告模板、水印生成（工号+时间）、在线预览、不可编辑PDF导出', '报告模板、导出服务'],\n    ['8', '历史记录模块', '记录列表、多条件筛选检索、状态管理、永久存档与回溯', '前端页面、后端接口'],\n    ['9', '后台管理模块', '服务运行状态监控、任务调度管理、用户数据查看', '管理后台'],\n    ['10', '数据安全模块', 'OSS加密存储、KMS密钥管理、OAuth认证接入、容器审完即焚机制、数据不出校策略', '安全配置文档'],\n    ['11', '测试与文档', '功能测试、性能测试、安全测试、用户手册、操作指南、安装部署文档', '测试报告、技术文档'],\n])\n\noutput_path = '/workspace/软件委托开发合同_华师学术论文智能核验平台.docx'\ndoc.save(output_path)\nprint(f'✅ Contract saved: {output_path}')\n",
