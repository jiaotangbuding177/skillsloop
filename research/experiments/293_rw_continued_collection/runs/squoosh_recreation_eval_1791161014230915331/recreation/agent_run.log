hoices ?? []).map((c) => (\n              <option key={c}>{c}</option>\n            ))}\n          </select>\n          <CaretIcon className=\"sel-arrow\" />\n        </div>\n      </div>\n    );\n  }\n\n  // Range (default).\n  const min = opt.min ?? 0;\n  const max = opt.max ?? 100;\n  const num = typeof value === \"number\" ? value : Number(value) || 0;\n  return (\n    <div className=\"range-row\">\n      <span className=\"range-label\">\n        {opt.label}\n        {opt.suffix ? ` (${opt.suffix})` : \"\"}\n      </span>\n      <input\n        className=\"range-number\"\n        type=\"number\"\n        min={min}\n        max={max}\n        value={num}\n        aria-label={opt.label}\n        onChange={(e) => onChange(opt.key, Number(e.target.value))}\n      />\n      <div className=\"range-track-wrap\">\n        <input\n          type=\"range\"\n          min={min}\n          max={max}\n          step={opt.step ?? 1}\n          value={num}\n          aria-label={`${opt.label} ${num}`}\n          onChange={(e) => onChange(opt.key, Number(e.target.value))}\n        />\n      </div>\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":324,"oldLines":6,"newStart":324,"newLines":7,"lines":["         <span>{opt.label}</span>","         <Toggle","           label={opt.label}","+          name={opt.key}","           checked={Boolean(value)}","           onChange={(v) => onChange(opt.key, v)}","         />"]},{"oldStart":338,"oldLines":6,"newStart":339,"newLines":7,"lines":["         <div className=\"sel-wrap\">","           <select","             aria-label={opt.label}","+            name={opt.key}","             value={String(value)}","             onChange={(e) => onChange(opt.key, e.target.value)}","           >"]}],"userModified":false,"replaceAll":false}}
