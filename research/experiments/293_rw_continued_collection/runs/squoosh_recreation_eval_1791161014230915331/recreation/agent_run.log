-theme-color);\n  border-color: var(--main-theme-color);\n}\n.blue-check .box svg {\n  width: 12px;\n  height: 12px;\n  fill: var(--white);\n  opacity: 0;\n}\n.blue-check input:checked + .box svg {\n  opacity: 1;\n}\n.blue-check input:focus-visible + .box {\n  outline: #fff solid 2px;\n}\n\n/* --- expander (advanced settings) --- */","originalFile":"@import \"tailwindcss\";\n\n/* ---------------------------------------------------------------\n   Design tokens\n   --------------------------------------------------------------- */\n:root {\n  --pink: #ff3385;\n  --hot-pink: #f06;\n  --white: #fff;\n  --black: #000;\n  --off-black: #1d1d1d;\n  --blue: #5fb4e4;\n  --dim-blue: #0a7bcc;\n  --deep-blue: #09f;\n  --light-blue: #76c8ff;\n  --less-light-gray: #bcbcbc;\n  --medium-light-gray: #d1d1d1;\n  --light-gray: #eaeaea;\n  --dark-gray: #333;\n  --dim-text: #343a3e;\n  --dark-text: #142630;\n\n  --ui-font: \"HelveticaNeue-Light\", \"Helvetica Neue Light\", \"Helvetica Neue\",\n    Helvetica, Arial, \"Lucida Grande\", sans-serif;\n  --mono-font: ui-monospace, \"SFMono-Regular\", \"DejaVu Sans Mono\", Menlo,\n    Consolas, monospace;\n\n  --options-radius: 7px;\n  --checker: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2 2'%3E%3Cpath d='M1 2V0h1v1H0v1z' fill-opacity='.05'/%3E%3C/svg%3E\");\n}\n\n/* ---------------------------------------------------------------\n   Base\n   --------------------------------------------------------------- */\nhtml {\n  font-size: 12px;\n}\n\nhtml,\nbody {\n  padding: 0;\n  margin: 0;\n  font: 12px/1.3 var(--ui-font);\n  overscroll-behavior: none;\n  background: var(--checker);\n  background-size: 20px 20px;\n}\n\nhtml,\nbody,\n#app {\n  height: 100%;\n  overflow: hidden;\n}\n\n#app {\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 100%;\n}\n\na,\nbutton,\nimg,\ninput,\nselect,\ntextarea {\n  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);\n}\n\na,\nbutton,\nimg,\n[inert] {\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-user-drag: none;\n  -webkit-touch-callout: none;\n}\n\n.abs-fill {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  box-sizing: border-box;\n}\n\n.plain-btn {\n  cursor: pointer;\n  background: none;\n  border: none;\n  font: inherit;\n  padding: 0;\n  margin: 0;\n  color: inherit;\n}\n.plain-btn:focus {\n  outline: none;\n}\n\n/* ===============================================================\n   INTRO PAGE\n   =============================================================== */\n.intro-view {\n  -webkit-overflow-scrolling: touch;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  display: grid;\n  grid-template-rows: 1fr max-content max-content;\n  font-size: 1.2rem;\n  color: var(--dim-text);\n}\n\n.intro-hero {\n  min-height: 541px;\n  display: grid;\n  grid-template-rows: max-content max-content;\n  justify-items: center;\n  position: relative;\n  --blob-pink: var(--hot-pink);\n  --center-blob-opacity: 0.3;\n}\n@media (min-width: 600px) {\n  .intro-hero {\n    min-height: 688px;\n  }\n}\n\n.logo-row {\n  margin: 5rem 0 1rem;\n}\n.logo-mark {\n  transform: translate(-1%);\n  width: 189px;\n  height: auto;\n  display: block;\n}\n\n/* --- the big pink drop target --- */\n.drop-zone {\n  position: relative;\n  color: var(--white);\n  font-style: italic;\n  font-size: 1.2rem;\n  width: max-content;\n  max-width: 100vw;\n  display: grid;\n  justify-items: center;\n}\n\n.drop-blob {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  fill: var(--blob-pink);\n}\n.drop-blob path {\n  opacity: var(--center-blob-opacity);\n  transform-origin: center;\n  animation: blob-drift 14s ease-in-out infinite;\n}\n.drop-blob path:nth-child(2) {\n  animation-duration: 18s;\n  animation-direction: reverse;\n}\n.drop-blob path:nth-child(3) {\n  animation-duration: 22s;\n}\n.drop-blob path:nth-child(4) {\n  animation-duration: 17s;\n  animation-direction: reverse;\n}\n\n/* Slow, low-amplitude drift that reads like the reference's living blob. */\n@keyframes blob-drift {\n  0%,\n  100% {\n    transform: rotate(0deg) scale(1);\n  }\n  50% {\n    transform: rotate(6deg) scale(1.04);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .drop-blob path {\n    animation: none;\n  }\n}\n\n.drop-inner {\n  position: relative;\n  --size: 29rem;\n  max-width: var(--size);\n  width: 100vw;\n  height: var(--size);\n  display: grid;\n  grid-template-rows: max-content max-content;\n  justify-items: center;\n  align-content: center;\n  gap: 0.7rem;\n}\n@media (min-width: 600px) {\n  .drop-inner {\n    --size: 36rem;\n  }\n}\n\n.drop-icon-btn {\n  --size: 5rem;\n  width: var(--size);\n  height: var(--size);\n  fill: var(--white);\n  transform: translate(4.3%, -1%);\n}\n.drop-icon-btn svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.paste-link {\n  text-decoration: underline;\n  font: inherit;\n  color: inherit;\n}\n\n.drop-hint {\n  font-style: italic;\n}\n@media (max-width: 599px) {\n  .drop-hint .drop-word {\n    display: none;\n  }\n}\n\n/* --- blue demos band --- */\n.demos-band {\n  position: relative;\n  background: var(--deep-blue);\n  padding-bottom: 5.2vw;\n}\n@media (max-width: 599px) {\n  .demos-band {\n    padding-bottom: 12vw;\n  }\n}\n\n.band-wave {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 100%;\n  width: 100%;\n  display: block;\n  height: auto;\n  aspect-ratio: 1920 / 140;\n}\n.band-wave .wave-main {\n  fill: var(--deep-blue);\n}\n.band-wave .wave-sub {\n  fill: var(--light-blue);\n}\n\n.demos-pad {\n  padding: 2em 0;\n}\n\n.demos-heading {\n  color: var(--white);\n  margin: 0;\n  font-size: 2rem;\n  text-align: center;\n  font-weight: 400;\n}\n.demos-heading strong {\n  font-weight: 700;\n}\n\n.demo-list {\n  display: grid;\n  gap: 3rem;\n  justify-items: center;\n  justify-content: center;\n  padding: 0;\n  margin: 3rem auto;\n  --demo-size: 80px;\n  grid-template-columns: repeat(auto-fit, var(--demo-size));\n  list-style: none;\n}\n@media (min-width: 740px) {\n  .demo-list {\n    --demo-size: 100px;\n    gap: 6rem;\n  }\n}\n.demo-list > li {\n  display: block;\n}\n\n.demo-card {\n  transition: scale 0.4s ease-in-out;\n}\n.demo-card:hover {\n  scale: 1.05;\n}\n\n.demo-avatar {\n  border-radius: var(--demo-size);\n  position: relative;\n  overflow: hidden;\n  width: var(--demo-size);\n  height: var(--demo-size);\n}\n.demo-avatar img {\n  width: var(--demo-size);\n  height: var(--demo-size);\n  display: block;\n}\n\n.demo-badge {\n  background: var(--dim-blue);\n  border-radius: 1000px;\n  color: var(--white);\n  width: max-content;\n  padding: 0.5rem 1.2rem;\n  margin: 0.7rem auto 0;\n}\n\n/* --- transition wave under the blue band --- */\n.band-tail {\n  position: relative;\n  height: 0;\n}\n.band-tail svg {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  width: 100%;\n  height: auto;\n  display: block;\n  aspect-ratio: 1920 / 79;\n}\n.band-tail .wave-info {\n  fill: var(--white);\n}\n\n/* --- feature sections --- */\n.info-block {\n  position: relative;\n  background: var(--white);\n  padding: 5em 2em;\n}\n@media (min-width: 1200px) {\n  .info-block {\n    padding: 5em 0;\n  }\n}\n\n.info-inner {\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.info-grid {\n  display: grid;\n  align-items: center;\n  grid-template-columns: 1fr;\n  gap: 1em;\n  grid-template-areas: \"text\" \"img\";\n}\n@media (min-width: 712px) {\n  .info-grid {\n    grid-template-columns: 1fr 1fr;\n    grid-template-areas: \"text img\";\n  }\n  .info-block:nth-of-type(2n) .info-grid {\n    grid-template-areas: \"img text\";\n  }\n}\n\n.info-copy {\n  display: flex;\n  flex-flow: column wrap;\n  max-width: 27em;\n  justify-self: center;\n  grid-area: text;\n}\n@media (min-width: 712px) {\n  .info-copy {\n    justify-self: start;\n  }\n  .info-block:nth-of-type(2n) .info-copy {\n    text-align: right;\n    justify-self: end;\n  }\n}\n\n.info-heading {\n  color: var(--pink);\n  font-size: 3em;\n  margin: 0;\n  font-weight: 400;\n}\n\n.info-body {\n  font-size: 1.5em;\n  line-height: 1.75;\n  margin: 1em 0 0.5em;\n}\n\n.info-figure {\n  grid-area: img;\n  margin: 0;\n}\n.info-figure img {\n  display: block;\n  width: 100%;\n  height: auto;\n  max-width: 400px;\n  margin: 0 auto;\n}\n@media (min-width: 768px) {\n  .info-figure img {\n    margin: 0 0 0 auto;\n  }\n  .info-block:nth-of-type(2n) .info-figure img {\n    margin: 0;\n  }\n}\n\n/* --- footer --- */\n.site-footer {\n  background: var(--white);\n  padding-top: 5em;\n}\n\n.footer-band {\n  position: relative;\n  background: var(--light-gray);\n}\n.footer-band > svg {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 100%;\n  width: 100%;\n  height: auto;\n  display: block;\n  aspect-ratio: 1920 / 79;\n}\n.footer-band .wave-footer {\n  fill: var(--light-gray);\n}\n\n.footer-pad {\n  padding: 2em;\n}\n\n.footer-links {\n  display: grid;\n  grid-auto-rows: max-content;\n  justify-items: center;\n  gap: 2rem;\n}\n@media (min-width: 480px) {\n  .footer-links {\n    justify-content: end;\n    grid-auto-flow: column;\n    align-items: center;\n    gap: 4rem;\n  }\n}\n\n.footer-link {\n  text-decoration: none;\n  color: inherit;\n}\n.footer-link:hover {\n  color: var(--dim-blue);\n}\n.footer-link.with-mark {\n  display: grid;\n  grid-template-columns: 1.8em max-content;\n  align-items: center;\n  gap: 0.6em;\n}\n.footer-link.with-mark img {\n  width: 100%;\n  height: auto;\n}\n\n/* --- install button --- */\n.install-btn {\n  position: absolute;\n  top: 1rem;\n  right: 1rem;\n  background: var(--deep-blue);\n  border-radius: 0.4em;\n  color: var(--white);\n  padding: 0.5em 1em;\n  font-size: 1.6rem;\n  cursor: pointer;\n  border: none;\n  animation: fade-in 0.6s ease-in-out;\n  z-index: 5;\n}\n.install-btn:hover {\n  background: #0a8ae6;\n}\n\n@keyframes fade-in {\n  0% {\n    opacity: 0;\n  }\n}\n\n/* ===============================================================\n   SNACKBAR\n   =============================================================== */\n.snackbar {\n  position: fixed;\n  display: flex;\n  box-sizing: border-box;\n  left: 50%;\n  bottom: 24px;\n  width: 344px;\n  margin-left: -172px;\n  background: #2a2a2a;\n  border-radius: 2px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);\n  transform-origin: center;\n  color: #eee;\n  z-index: 100;\n  animation: snack-show 0.3s ease 1 forwards;\n}\n.snackbar.hiding {\n  animation: snack-hide 0.3s ease 1 forwards;\n}\n.snackbar-text {\n  flex: 1 1 auto;\n  padding: 16px;\n  font-size: 100%;\n}\n.snackbar-action {\n  position: relative;\n  flex: 0 1 auto;\n  padding: 8px;\n  height: 100%;\n  margin: auto 8px auto -8px;\n  min-width: 5em;\n  background: none;\n  border: none;\n  border-radius: 3px;\n  color: #90ee90;\n  font-weight: inherit;\n  letter-spacing: 0.05em;\n  font-size: 100%;\n  text-transform: uppercase;\n  text-align: center;\n  cursor: pointer;\n  transition: background-color 0.2s ease;\n}\n.snackbar-action:hover {\n  background-color: rgba(0, 0, 0, 0.15);\n}\n@media (max-width: 400px) {\n  .snackbar {\n    width: 100%;\n    bottom: 0;\n    left: 0;\n    margin-left: 0;\n    border-radius: 0;\n  }\n}\n@keyframes snack-show {\n  0% {\n    opacity: 0;\n    transform: scale(0.5);\n  }\n}\n@keyframes snack-hide {\n  to {\n    opacity: 0;\n    transform: translateY(100%);\n  }\n}\n\n/* ===============================================================\n   EDITOR\n   =============================================================== */\n.editor-root {\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n}\n\n.editor-stage {\n  touch-action: none;\n}\n.editor-stage::after {\n  content: \"\";\n  position: absolute;\n  display: block;\n  inset: 10px;\n  background-color: rgba(0, 0, 0, 0.1);\n  border: 2px dashed var(--pink);\n  border-radius: 10px;\n  opacity: 0;\n  transform: scale(0.95);\n  transition: transform 0.2s ease-in, opacity 0.2s ease-in;\n  pointer-events: none;\n  z-index: 20;\n}\n.editor-stage.drag-valid::after {\n  opacity: 1;\n  transform: scale(1);\n  transition-timing-function: ease-out;\n}\n\n.editor-shell {\n  width: 100%;\n  height: 100%;\n  display: grid;\n  grid-template-rows: max-content 1fr;\n  grid-template-areas: \"header\" \"opts\";\n}\n@media (min-width: 600px) {\n  .editor-shell {\n    grid-template:\n      \"header header header\" max-content\n      \"optsLeft viewportOpts optsRight\" 1fr\n      / max-content 1fr max-content;\n  }\n}\n/*\n * Narrow screens lay the controls over the image: a full-height options\n * column down the right, the original-image panel pinned bottom-left.\n */\n\n\n/* --- back button --- */\n.back-btn {\n  position: relative;\n  grid-area: header;\n  margin: 9px;\n  place-self: start;\n  width: 58px;\n  height: 55px;\n  background: none;\n  border: none;\n  padding: 0;\n  cursor: pointer;\n  z-index: 6;\n}\n.back-btn svg {\n  width: 47px;\n  overflow: visible;\n  display: block;\n}\n@media (min-width: 600px) {\n  .back-btn {\n    margin: 14px;\n  }\n  .back-btn svg {\n    width: 58px;\n  }\n}\n.back-blob {\n  fill: var(--hot-pink);\n  opacity: 0.77;\n}\n.back-x {\n  fill: var(--white);\n}\n\n/* --- viewer --- */\n.viewer {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  background: transparent;\n}\n/*\n * Backdrop behind the bitmap. Squoosh defaults to the transparent checker\n * (opaque images hide it entirely); toggling the background dims the stage\n * so alpha channels read clearly.\n */\n.viewer-overlay {\n  position: absolute;\n  inset: 0;\n  background: #000;\n  opacity: 0;\n  transition: opacity 0.5s;\n  z-index: 0;\n}\n.viewer-overlay.alt {\n  opacity: 0.8;\n}\n/* The canvas fills the viewport; the bitmaps live inside each compare layer. */\n.viewer-canvas {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n}\n.viewer-canvas img {\n  display: block;\n}\n.viewer-canvas.smooth img {\n  image-rendering: auto;\n}\n.viewer-canvas.crisp img {\n  image-rendering: pixelated;\n}\n\n/* --- two-up --- */\n.two-up {\n  --split-point: 50%;\n  --bar-size: 4px;\n  --bar-touch-size: 30px;\n  --track-color: var(--pink);\n  position: absolute;\n  inset: 0;\n}\n/* Each side is a viewport-sized layer clipped at the divider. */\n.two-up .layer {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n}\n.two-up .layer.clip-left {\n  clip-path: inset(0 calc(100% - var(--split-point)) 0 0);\n}\n.two-up .layer.clip-right {\n  clip-path: inset(0 0 0 var(--split-point));\n}\n/* The bitmap sits at its natural size, centred within the layer. */\n.two-up .layer img {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  max-width: none;\n  max-height: none;\n  transform-origin: center center;\n  will-change: transform;\n  pointer-events: none;\n}\n.two-up-handle {\n  touch-action: none;\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  /* `left` percentages resolve against the viewport, unlike translateX. */\n  left: var(--split-point);\n  width: var(--bar-touch-size);\n  margin-left: calc(var(--bar-touch-size) / -2);\n  cursor: ew-resize;\n  z-index: 3;\n}\n.two-up-handle::before {\n  content: \"\";\n  display: block;\n  height: 100%;\n  width: var(--bar-size);\n  margin: 0 auto;\n  background: var(--track-color);\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);\n}\n.two-up-knob {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 40px;\n  height: 40px;\n  transform: translate(-50%, -50%);\n  pointer-events: none;\n}\n\n/* --- viewport controls --- */\n.viewer-controls {\n  display: flex;\n  justify-content: center;\n  overflow: hidden;\n  flex-wrap: wrap;\n  grid-area: header;\n  align-self: center;\n  padding: 9px 66px;\n  position: relative;\n  gap: 6px;\n  pointer-events: none;\n  z-index: 4;\n}\n.viewer-controls > * {\n  pointer-events: auto;\n}\n@media (min-width: 860px) {\n  .viewer-controls {\n    padding: 9px;\n    grid-area: viewportOpts;\n    align-self: end;\n    flex-wrap: wrap-reverse;\n  }\n}\n\n.vc-btn,\n.vc-zoom {\n  display: flex;\n  align-items: center;\n  box-sizing: border-box;\n  background-color: rgba(29, 29, 29, 0.92);\n  border: 1px solid rgba(0, 0, 0, 0.67);\n  border-right-width: 0;\n  line-height: 1.1;\n  white-space: nowrap;\n  height: 39px;\n  padding: 0 8px;\n  font-size: 1.2rem;\n  cursor: pointer;\n  color: #fff;\n}\n.vc-btn:hover {\n  background: rgba(50, 50, 50, 0.92);\n}\n.vc-btn.is-active {\n  background: rgba(72, 72, 72, 0.92);\n}\n.vc-btn:focus-visible,\n.vc-zoom:focus-visible {\n  box-shadow: #fff 0 0 0 2px;\n  outline: none;\n  z-index: 1;\n}\n.vc-btn svg {\n  width: 21px;\n  height: 21px;\n  display: block;\n  fill: #fff;\n}\n\n.zoom-group,\n.tool-group {\n  display: flex;\n  align-items: stretch;\n}\n.zoom-group .vc-btn:first-child,\n.tool-group .vc-btn:first-child {\n  border-radius: 4px 0 0 4px;\n}\n.zoom-group .vc-btn:last-child,\n.tool-group .vc-btn:last-child {\n  border-right-width: 1px;\n  border-radius: 0 4px 4px 0;\n}\n\n.vc-zoom {\n  cursor: text;\n  width: 7rem;\n  text-align: center;\n  justify-content: center;\n}\n.vc-zoom .zoom-value {\n  font-size: 1.2rem;\n  letter-spacing: 0.05rem;\n  font-weight: 700;\n  color: #fff;\n  margin: 0 3px 0 0;\n  padding: 0 2px;\n  border-bottom: 1px dashed #999;\n}\n.vc-zoom .zoom-unit {\n  color: #939393;\n  font-size: 0.8rem;\n  font-weight: 100;\n}\n.vc-zoom input {\n  width: 4rem;\n  background: none;\n  border: none;\n  color: #fff;\n  font: inherit;\n  font-size: 1.2rem;\n  font-weight: 700;\n  text-align: right;\n  text-indent: 0;\n  outline: none;\n}\n\n/* --- options panels --- */\n.opts-panel {\n  position: relative;\n  color: #fff;\n  font-size: 1.2rem;\n  max-width: 400px;\n  margin: 0 auto;\n  width: calc(100% - 60px);\n  max-height: 100%;\n  grid-area: opts;\n  display: grid;\n  grid-template-rows: 1fr max-content;\n  align-content: end;\n  align-self: end;\n  z-index: 5;\n}\n@media (min-width: 600px) {\n  .opts-panel {\n    width: 300px;\n    margin: 0;\n  }\n}\n.opts-panel.side-a {\n  grid-area: optsLeft;\n  --main-theme-color: var(--pink);\n  --hot-theme-color: var(--hot-pink);\n  --header-text-color: var(--white);\n  --rotate-copyoverbutton-angle: 90deg;\n}\n.opts-panel.side-b {\n  grid-area: optsRight;\n  --main-theme-color: var(--blue);\n  --hot-theme-color: var(--deep-blue);\n  --header-text-color: var(--dark-text);\n  --rotate-copyoverbutton-angle: -90deg;\n  align-content: center;\n}\n\n.opts-stack {\n  position: relative;\n  display: flex;\n  flex-flow: column;\n  overflow: hidden;\n  gap: 10px;\n}\n\n.opts-scroller {\n  --horizontal-padding: 15px;\n  border-radius: var(--options-radius) var(--options-radius) 0 0;\n  overflow: hidden auto;\n  max-height: 100%;\n}\n.opts-scroller::-webkit-scrollbar {\n  width: 8px;\n}\n.opts-scroller::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.25);\n  border-radius: 4px;\n}\n\n.panel-title {\n  background-color: var(--main-theme-color);\n  color: var(--header-text-color);\n  margin: 0;\n  padding: 10px var(--horizontal-padding);\n  font-weight: 700;\n  font-size: 1.4rem;\n  border-bottom: 1px solid var(--off-black);\n  transition: background-color 0.3s ease-in-out, color 0.3s;\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-auto-columns: max-content;\n  grid-auto-flow: column;\n  gap: 0.8rem;\n  align-items: center;\n}\n.panel-title .title-actions {\n  display: grid;\n  grid-auto-columns: max-content;\n  grid-auto-flow: column;\n  gap: 0.8rem;\n  align-items: center;\n}\n/* Original-image panel uses a black header instead of the pink/blue theme. */\n.panel-title.is-original-title {\n  background-color: var(--black);\n  color: var(--white);\n}\n.title-btn {\n  background: none;\n  border: none;\n  padding: 0;\n  cursor: pointer;\n  color: inherit;\n  display: block;\n}\n.title-btn svg {\n  --size: 20px;\n  display: block;\n  width: var(--size);\n  height: var(--size);\n}\n.title-btn:focus {\n  outline: var(--header-text-color) solid 2px;\n  outline-offset: 0.25em;\n}\n.title-btn[disabled] {\n  pointer-events: none;\n  cursor: not-allowed;\n}\n.title-btn[disabled] svg {\n  opacity: 0.5;\n}\n.copy-over-btn {\n  transform: rotate(var(--rotate-copyoverbutton-angle));\n}\n.copy-over-btn svg {\n  fill: var(--header-text-color);\n}\n.save-btn svg,\n.import-btn svg,\n.rotate-copy-btn svg {\n  stroke: var(--header-text-color);\n}\n\n.option-row {\n  display: grid;\n  align-items: center;\n  gap: 0.7em;\n  padding: 10px var(--horizontal-padding);\n}\n/* Toggle rows are taller than the plain option rows. */\n.option-toggle {\n  cursor: pointer;\n  grid-template-columns: 1fr auto;\n  padding-block: 15px;\n}\n.option-one-cell {\n  display: grid;\n  grid-template-columns: 1fr;\n  padding: 10px var(--horizontal-padding);\n}\n.option-reveal {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  align-items: center;\n  gap: 1em;\n  padding: 10px var(--horizontal-padding);\n  border-top: 1px solid rgba(255, 255, 255, 0.27);\n  transition: background-color 0.25s;\n}\n.option-reveal:hover,\n.option-reveal:focus-within {\n  background-color: rgba(255, 255, 255, 0.13);\n}\n\n.section-enabler {\n  background: var(--dark-gray);\n  padding: 15px var(--horizontal-padding);\n  border-bottom: 1px solid var(--off-black);\n}\n\n.opt-section {\n  background: var(--off-black);\n}\n\n/* --- select --- */\n.sel-wrap {\n  position: relative;\n}\n.sel-wrap select {\n  appearance: none;\n  -webkit-appearance: none;\n  width: 100%;\n  box-sizing: border-box;\n  padding: 10px 35px 10px 10px;\n  background: var(--dark-gray);\n  color: #fff;\n  font: inherit;\n  font-size: 1.2rem;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n}\n.sel-wrap .sel-arrow {\n  position: absolute;\n  right: 13px;\n  top: 50%;\n  transform: translateY(-50%);\n  fill: #fff;\n  width: 10px;\n  pointer-events: none;\n}\n\n/* --- toggle switch --- */\n.switch {\n  display: inline-block;\n  position: relative;\n}\n/* The real input stretches over the visual track and takes the clicks. */\n.switch input {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  opacity: 0;\n  margin: 0;\n  width: 100%;\n  height: 100%;\n  cursor: pointer;\n}\n.switch .track {\n  --thumb-size: 14px;\n  background: var(--black);\n  border-radius: 1000px;\n  width: 24px;\n  padding: 3px calc(var(--thumb-size) / 2 + 3px);\n  display: block;\n  box-sizing: content-box;\n  /* Visual only — the wrapping label / real input receives the clicks. */\n  pointer-events: none;\n}\n.switch input:focus-visible + .track {\n  outline: #fff solid 2px;\n}\n.switch .thumb-track {\n  transition: transform 0.2s;\n  display: block;\n}\n.switch .thumb {\n  position: relative;\n  width: var(--thumb-size);\n  height: var(--thumb-size);\n  background: var(--less-light-gray);\n  border-radius: 100%;\n  transform: translateX(calc(var(--thumb-size) / -2));\n  overflow: hidden;\n  display: block;\n}\n.switch .thumb::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: var(--main-theme-color);\n  opacity: 0;\n  transition: opacity 0.2s;\n}\n.switch input:checked + .track .thumb-track {\n  transform: translateX(100%);\n}\n.switch input:checked + .track .thumb::before {\n  opacity: 1;\n}\n\n/* --- expander (advanced settings) --- */\n.expander-head {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 0.6em;\n  align-items: center;\n  padding: 10px var(--horizontal-padding);\n  border-top: 1px solid rgba(255, 255, 255, 0.27);\n  cursor: pointer;\n  color: #fff;\n}\n.expander-head .caret {\n  width: 10px;\n  height: 10px;\n  fill: #fff;\n  transition: transform 0.2s;\n  transform: rotate(-90deg);\n  display: block;\n}\n.expander.open .expander-head .caret {\n  transform: none;\n}\n.expander-body {\n  background: var(--off-black);\n}\n\n/* --- range input --- */\n.range-row {\n  position: relative;\n  z-index: 0;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  padding