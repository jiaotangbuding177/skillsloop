if caps else ''})","     return page"," "," os.makedirs(OUT, exist_ok=True)","-summary = {}"," for fn in sorted(glob.glob(ROOT + '/*.html')):","     name = os.path.basename(fn).replace('.html', '')","     pg = parse_page(fn)","-    if pg is None:","-        continue","+    if pg is None: continue","     with open(f'{OUT}/{name}.json', 'w') as f:","         json.dump(pg, f, indent=1)","-    summary[name] = {'title': pg.get('title'), 'blocks': len(pg['navBlocks']), 'feat': len(pg['features']), 'sec': len(pg['secondary'])}","-for k, v in summary.items():","-    print(k, '=>', v)","\\ No newline at end of file","+    print(name, '=> title:', pg.get('title'), '| blocks:', len(pg['navBlocks']), '| sec:', len(pg['secondary']), '| feat:', len(pg['features']))","\\ No newline at end of file"]}],"originalFile":"#!/usr/bin/env python3\n\"\"\"Extract structured page data from the reference site into JSON for the rebuild.\"\"\"\nimport re, json, glob, html as H, os\n\nROOT = '/tmp/site'\nOUT = '/tmp/refdata'\n\ndef clean(s):\n    s = re.sub(r'<[^>]+>', '', s)\n    return H.unescape(s).strip()\n\ndef link_info(a):\n    \"\"\"Extract (text, href, has_arrow) from an <a ...>...</a>\"\"\"\n    href = ''\n    m = re.search(r'href=\"([^\"]*)\"', a)\n    if m: href = m.group(1)\n    text = clean(a)\n    text = re.sub(r'\\s+', ' ', text).strip()\n    has_arrow = 'fa-arrow-circle' in a\n    return {'text': text, 'href': href, 'arrow': has_arrow}\n\ndef parse_li(li):\n    \"\"\"One <li>. Returns dict {type:'link'|'dropdown'|'image'|'plain', ...}\"\"\"\n    d = {'type': 'link'}\n    if 'class=\"dropdown\"' in li or '<summary>' in li:\n        m = re.search(r'<summary>(.*?)</summary>', li, re.S)\n        summary = clean(m.group(1)) if m else ''\n        ch = re.search(r'<div class=\"dropdown-content\">(.*?)</div>', li, re.S)\n        items = []\n        for x in re.findall(r'<li>(.*?)</li>', ch.group(1), re.S):\n            a = re.search(r'<a[^>]*>(.*?)</a>', x, re.S)\n            items.append(link_info(a.group(0)) if a else {'text': clean(x), 'href': ''})\n        return {'type': 'dropdown', 'title': summary, 'items': items}\n    a = re.search(r'<a[^>]*>(.*?)</a>', li, re.S)\n    if a:\n        return {'type': 'link', **link_info(a.group(0))}\n    img = re.search(r'<img[^>]*>', li)\n    if img:\n        alt = re.search(r'alt=\"([^\"]*)\"', img.group(0))\n        src = re.search(r'src=\"([^\"]*)\"', img.group(0))\n        return {'type': 'image', 'alt': alt.group(1) if alt else '', 'src': src.group(1) if src else ''}\n    return {'type': 'plain', 'text': clean(li)}\n\ndef parse_nav_blocks(body):\n    \"\"\"Extract nav-block sections with columns.\"\"\"\n    blocks = []\n    for nb in re.findall(r'<nav class=\"nav-block\">(.*?)</nav>', body, re.S):\n        m = re.search(r'<h4>(.*?)</h4>', nb, re.S)\n        title = clean(m.group(1)) if m else ''\n        items = []\n        for li in re.findall(r'<li[^>]*>(.*?)</li>', nb, re.S):\n            items.append(parse_li(li))\n        blocks.append({'title': title, 'items': items})\n    return blocks\n\ndef parse_page(fn):\n    h = open(fn, encoding='utf-8').read()\n    i = h.find('id=\"content\"'); j = h.find('id=\"footer\"')\n    if i < 0:\n        return None\n    body = h[i:j]\n    body = re.sub(r'<script.*?</script>', '', body, flags=re.S)\n    page = {'file': fn, 'navBlocks': [], 'description': '', 'features': [], 'secondary': []}\n\n    # Title (h2 inside .header)\n    m = re.search(r'<div class=\"header\">\\s*<h2[^>]*>(.*?)</h2>', body, re.S)\n    if m: page['title'] = clean(m.group(1))\n    m = re.search(r'<div class=\"header\">\\s*<h2 class=\"hidden\"[^>]*>(.*?)</h2>', body, re.S)\n    if m: page['title'] = clean(m.group(1))\n\n    # Description paragraph\n    m = re.search(r'<div class=\"description\">\\s*<p>(.*?)</p>', body, re.S)\n    if m: page['description'] = clean(m.group(1))\n\n    # Nav blocks\n    page['navBlocks'] = parse_nav_blocks(body)\n\n    # Secondary feature (image + caption)\n    m = re.search(r'<div class=\"secondary\">(.*?)</div>', body, re.S)\n    if m:\n        sec = m.group(1)\n        img = re.search(r'<img[^>]*>', sec)\n        cap = re.search(r'<p class=\"caption\">(.*?)</p>', sec, re.S)\n        page['secondary'] = [{\n            'src': re.search(r'src=\"([^\"]*)\"', img.group(0)).group(1) if img and re.search(r'src=\"([^\"]*)\"', img.group(0)) else '',\n            'alt': re.search(r'alt=\"([^\"]*)\"', img.group(0)).group(1) if img and re.search(r'alt=\"([^\"]*)\"', img.group(0)) else '',\n            'caption': clean(cap.group(1)) if cap else ''\n        }]\n\n    # Features: #sharing-our-stories + any full-width image region\n    m = re.search(r'<div aria-label=\"Voices of Our Campus\"[^>]*>(.*?)</div>\\s*</div>\\s*</div>', body, re.S)\n    if m:\n        rg = m.group(1)\n        img = re.search(r'<img[^>]*>', rg)\n        cap = re.search(r'<div class=\"sharing-caption\"[^>]*>\\s*<i[^>]*></i>(.*?)</div>', rg, re.S)\n        page['features'].append({\n            'src': re.search(r'src=\"([^\"]*)\"', img.group(0)).group(1) if img and re.search(r'src=\"([^\"]*)\"', img.group(0)) else '',\n            'alt': re.search(r'alt=\"([^\"]*)\"', img.group(0)).group(1) if img and re.search(r'alt=\"([^\"]*)\"', img.group(0)) else '',\n            'caption': clean(cap.group(1)) if cap else ''\n        })\n    return page\n\nos.makedirs(OUT, exist_ok=True)\nsummary = {}\nfor fn in sorted(glob.glob(ROOT + '/*.html')):\n    name = os.path.basename(fn).replace('.html', '')\n    pg = parse_page(fn)\n    if pg is None:\n        continue\n    with open(f'{OUT}/{name}.json', 'w') as f:\n        json.dump(pg, f, indent=1)\n    summary[name] = {'title': pg.get('title'), 'blocks': len(pg['navBlocks']), 'feat': len(pg['features']), 'sec': len(pg['secondary'])}\nfor k, v in summary.items():\n    print(k, '=>', v)","userModified":false}}
