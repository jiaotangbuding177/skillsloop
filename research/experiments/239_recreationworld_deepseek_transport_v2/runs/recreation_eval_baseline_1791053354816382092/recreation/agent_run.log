, setQuickOpen] = useState(false);\n  const loc = useLocation();\n\n  return (\n    <div className=\"clear\" id=\"header\" role=\"banner\">\n      <a className=\"skip\" href=\"#content\">\n        Skip to main content\n      </a>\n      <div id=\"zone-branding\">\n        <div className=\"cuv-wrap\">\n          <h1 className=\"logo\">\n            <Link to=\"/\">Corravale University</Link>\n          </h1>\n        </div>\n      </div>\n      <div id=\"zone-utility-bar\">\n        <div className=\"cuv-wrap cuv-wrap--flex\">\n          <div className=\"sexual-misconduct\">\n            <Link to=\"/_404\">\n              Report Sexual Misconduct, Discrimination, and Bias Concerns{\" \"}\n              <ArrowCircleRight className=\"smic-icon\" />\n            </Link>\n          </div>\n          <div className=\"search\">\n            <form action=\"/search/\" role=\"search\">\n              <label htmlFor=\"keywords\">\n                <span className=\"hidden-vis\">Search for:</span>\n                <input\n                  id=\"keywords\"\n                  name=\"keywords\"\n                  placeholder=\"Search\"\n                  title=\"Search for:\"\n                  type=\"search\"\n                />\n              </label>\n              <button type=\"submit\">\n                <span className=\"hidden-vis\">Search</span>\n                <Search aria-hidden=\"true\" />\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n      <div id=\"zone-audience-quick-links\">\n        <div className=\"cuv-wrap cuv-wrap--flex\">\n          <details id=\"quick-links\" open={quickOpen} onToggle={(e) => setQuickOpen((e.target as HTMLDetailsElement).open)}>\n            <summary>Quick Links</summary>\n            <nav aria-labelledby=\"quick-links-heading\">\n              <ul id=\"quick-links-content\">\n                {QUICK_LINKS.map((l) => (\n                  <li key={l.label}>\n                    <Link to={l.href}>{l.label}</Link>\n                  </li>\n                ))}\n              </ul>\n            </nav>\n          </details>\n          <div aria-label=\"Audiences\" className=\"clear\" id=\"audience-nav\" role=\"navigation\">\n            <ul className=\"clear\">\n              <li aria-hidden=\"true\">For:</li>\n              {AUDIENCE_LINKS.map((l) => (\n                <li key={l.href}>\n                  <Link to={l.href}>{l.label}</Link>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n      </div>\n      <div aria-labelledby=\"main-menu-header\" id=\"zone-main-nav\" role=\"navigation\">\n        <div className=\"cuv-wrap\">\n          <div id=\"main-nav\">\n            <Link\n              className=\"hamburger-header\"\n              to=\"#\"\n              onClick={(e) => {\n                e.preventDefault();\n                setMenuOpen((o) => !o);\n              }}\n            >\n              <h3 id=\"main-menu-header\">Main Menu</h3>\n            </Link>\n            <ul aria-hidden={!menuOpen} className={cn(\"clear\", menuOpen && \"menu-open\")}>\n              {MAIN_NAV.map((item) => {\n                const active = loc.pathname === item.href || (item.href !== \"/\" && loc.pathname.startsWith(item.href));\n                return (\n                  <li key={item.href} className={cn(item.home && \"home-item\", active && \"active\")}>\n                    <Link aria-current={active ? \"page\" : undefined} to={item.href}>\n                      {item.home ? (\n                        <Home className=\"nav-home-icon\">\n                          <span className=\"hidden-vis\">Home</span>\n                        </Home>\n                      ) : (\n                        item.label\n                      )}\n                    </Link>\n                  </li>\n                );\n              })}\n            </ul>\n          </div>\n        </div>\n      </div>\n      <div className=\"menu-panel\" style={{ display: menuOpen ? \"block\" : \"none\" }}>\n        <div className=\"menu-panel-inner\">\n          <div className=\"menu-panel-head\">\n            <h3>Main Menu</h3>\n            <button aria-label=\"Close menu\" onClick={() => setMenuOpen(false)}>\n              ×\n            </button>\n          </div>\n          <nav aria-label=\"Main\">\n            <ul>\n              {MAIN_NAV.map((item) => (\n                <li key={item.href}>\n                  <Link to={item.href} onClick={() => setMenuOpen(false)}>\n                    {item.home ? \"Home\" : item.label}\n                  </Link>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/** Placeholder icon usage to keep imports used in the module. */\nexport const _hdrIcons = { ArrowCircleRight, Search, Home, ChevronLeft, ChevronRight, Plus };"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":201897,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"00ab4dff-b78b-4d55-b22f-84bc3198b5d8","uuid":"890fb94d-0fa2-409a-ae87-f5cfe3f3bc72"}
