','base','col','embed','param','track','wbr'}\n\nclass Tree(HTMLParser):\n    def __init__(self):\n        super().__init__()\n        self.root = Node('#root', {})\n        self.stack = [self.root]\n    def handle_starttag(self, tag, attrs):\n        n = Node(tag, dict(attrs), self.stack[-1])\n        self.stack[-1].children.append(n)\n        if tag not in VOID:\n            self.stack.append(n)\n    def handle_endtag(self, tag):\n        for i in range(len(self.stack)-1, 0, -1):\n            if self.stack[i].tag == tag:\n                del self.stack[i:]\n                break\n    def handle_data(self, data):\n        if data:\n            self.stack[-1].children.append(data)\n\ndef build(body):\n    t = Tree(); t.feed(body); return t.root\n\ndef link_info(a):\n    if a is None: return {'text': '', 'href': '', 'arrow': False}\n    ' '.join\n    href = a.attrs.get('href', '')\n    text = re.sub(r'\\s+', ' ', a.text()).strip()\n    arrow = bool(a.findAll(cls='fa-arrow-circle-right')) or 'fa-arrow-circle' in str(a.attrs)\n    return {'text': text, 'href': href, 'arrow': arrow}\n\ndef parse_li(li):\n    a = li.find('a')\n    if a:\n        return {'type': 'link', **link_info(a[0])}\n    summ = li.find('summary')\n    if summ:\n        ch = li.findAll('div', cls='dropdown-content')\n        items = []\n        if ch:\n            for sub in ch[0].find('li'):\n                items.extend(parse_li(sub))\n        return {'type': 'dropdown', 'title': summ[0].text(), 'items': items}\n    return {'type': 'plain', 'text': li.text()}\n\ndef first_img(scope):\n    imgs = scope.findAll('img')\n    if not imgs: return {'src': '', 'alt': ''}\n    return {'src': imgs[0].attrs.get('src', ''), 'alt': imgs[0].attrs.get('alt', '')}\n\ndef parse_page(fn):\n    h = open(fn, encoding='utf-8').read()\n    i = h.find('id=\"content\"'); j = h.find('id=\"footer\"')\n    if i < 0: return None\n    body = h[i:j]\n    body = re.sub(r'<script.*?</script>', '', body, flags=re.S)\n    root = build(body)\n    page = {'file': os.path.basename(fn), 'navBlocks': [], 'secondary': [], 'features': []}\n\n    # Title\n    hdrs = root.findAll('div', cls='header')\n    if hdrs:\n        h2 = hdrs[0].find('h2')\n        if h2: page['title'] = h2[0].text()\n\n    descs = root.findAll('div', cls='description')\n    if descs:\n        p = descs[0].find('p')\n        page['description'] = p[0].text() if p else descs[0].text()\n\n    # nav-blocks, grouped into rows by data-row\n    blocks = root.findAll('nav', cls='nav-block')\n    for nb in blocks:\n        divs = nb.find('div')\n        row = divs[0].attrs.get('data-row') if divs else None\n        h4 = nb.find('h4')\n        title = h4[0].text() if h4 else ''\n        items = []\n        ul = nb.find('ul')\n        if ul:\n            for li in ul[0].find('li'):\n                items.append(parse_li(li))\n        page['navBlocks'].append({'title': title, 'items': items, 'row': row})\n\n    # secondary sidebar feature\n    secs = root.findAll('div', cls='secondary')\n    for sec in secs:\n        feats = sec.findAll('div', cls='feature')\n        for ft in feats:\n            im = first_img(ft)\n            cap = ft.findAll('p', cls='caption')\n            page['secondary'].append({'src': im['src'], 'alt': im['alt'],\n                                      'caption': cap[0].text() if cap else ''})\n\n    # full-width imagery region: Voices of Our Campus\n    for rg in root.findAll('div'):\n        if rg.attrs.get('aria-label') == 'Voices of Our Campus':\n            im = first_img(rg)\n            caps = rg.findAll('div', cls='sharing-caption')\n            page['features'].append({'src': im['src'], 'alt': im['alt'],\n                                     'caption': caps[0].text() if caps else ''})\n    return page\n\nos.makedirs(OUT, exist_ok=True)\nfor fn in sorted(glob.glob(ROOT + '/*.html')):\n    name = os.path.basename(fn).replace('.html', '')\n    pg = parse_page(fn)\n    if pg is None: continue\n    with open(f'