ome {\n  // Callers pass a trailing-slash route (\"/about/\"); the table is keyed\n  // without it, so normalize before looking up.\n  const key = path.length > 1 && path.endsWith(\"/\") ? path.slice(0, -1) : path;\n  return routeChrome[key] ?? HOME_CHROME;\n}\n\nexport const footerCampuses = [\n  { label: \"Fairhaven\", to: \"/\" },\n  { label: \"Westgate\", to: \"/_404.html\" },\n  { label: \"Alden\", to: \"/_404.html\" },\n];\n\nexport const socialFeeds = [\n  { label: \"Streamly\", icon: \"streamly\" },\n  { label: \"Z\", icon: \"z\" },\n  { label: \"Skylark\", icon: \"skylark\" },\n  { label: \"Vidcast\", icon: \"vidcast\" },\n  { label: \"Photogram\", icon: \"photogram\" },\n  { label: \"Loopit\", icon: \"loopit\" },\n  { label: \"Careerly\", icon: \"careerly\" },\n];\n","numLines":287,"startLine":1,"totalLines":287}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_uvmh2uQUPtOLqNsrw9Ta6924","type":"tool_result","content":"1\timport { Link } from \"@/lib/router\";\n2\timport { img } from \"@/data/assets\";\n3\timport { ProsePage, PageTitle } from \"@/components/Layout\";\n4\timport { CircleArrowRight } from \"@/components/Icons\";\n5\timport { SearchGlyph } from \"@/components/Header\";\n6\t\n7\ttype GalleryItem = { src: string; alt: string; time?: string };\n8\t\n9\t/* ---------------- Gallery section (Onward Now / Seize the Day) ---------------- */\n10\texport function HomeGallery({\n11\t  title,\n12\t  items,\n13\t  heading = \"All Corravale, all the time\",\n14\t  blurb = \"There's always something remarkable unfolding at Corravale. Whether it's across our campuses or somewhere far beyond them, our students, faculty, staff and alumni are busy chasing what's next. A selection of moments gathered over the years fills the gallery below.\",\n15\t}: {\n16\t  title: string;\n17\t  items: GalleryItem[];\n18\t  heading?: string;\n19\t  blurb?: string;\n20\t}) {\n21\t  return (\n22\t    <section aria-label={title} className=\"bg-white py-10\">\n23\t      <h2 className=\"mb-8 text-center font-cond text-[26px] tracking-[0.22em] text-[#555] uppercase\">\n24\t        {title}\n25\t      </h2>\n26\t      <div className=\"mx-auto max-w-[1180px] px-5\">\n27\t        <div className=\"mb-8 grid items-center gap-6 md:grid-cols-[220px_1fr]\">\n28\t          <div className=\"flex items-center gap-6\">\n29\t            <img src={img.blockm} alt=\"Block C\" className=\"h-[96px] w-[96px] object-contain\" />\n30\t            <img src={img.hours24} alt=\"24 Hours\" className=\"h-[96px] w-[96px] object-contain\" />\n31\t          </div>\n32\t          <div>\n33\t            <h3 className=\"mb-3 font-cond text-[22px] tracking-[0.08em] text-navy uppercase\">\n34\t              {heading}\n35\t            </h3>\n36\t            <p className=\"text-[14px] leading-relaxed text-[#333]\">{blurb}</p>\n37\t          </div>\n38\t        </div>\n39\t        <ul className=\"grid grid-cols-2 gap-[3px] md:grid-cols-4 lg:grid-cols-6\">\n40\t          {items.map((g) => (\n41\t            <li key={(g.time ?? \"\") + g.src} className=\"group relative cursor-pointer overflow-hidden\">\n42\t              <img src={g.src} alt={g.alt} className=\"h-[150px] w-full object-cover transition group-hover:scale-105\" loading=\"lazy\" />\n43\t              {g.time && (\n44\t                <span className=\"absolute bottom-0 left-0 bg-[#0b1b2b]/75 px-2 py-1 font-cond text-[12px] text-white\">\n45\t                  {g.time}\n46\t                </span>\n47\t              )}\n48\t            </li>\n49\t          ))}\n50\t        </ul>\n51\t      </div>\n52\t    </section>\n53\t  );\n54\t}\n55\t\n56\t/* ---------------- Contact ---------------- */\n57\tconst departments: {\n58\t  name: string;\n59\t  to?: string;\n60\t  phone?: string;\n61\t  email?: string;\n62\t  website?: string;\n63\t  chat?: string;\n64\t}[] = [\n65\t  { name: \"Operators\", phone: \"734-764-1817\" },\n66\t  { name: \"Undergraduate Admissions\", to: \"/_404.html\", phone: \"734-764-7433\" },\n67\t  { name: \"Graduate Admissions\", to: \"/_404.html\", phone: \"734-764-8129\", email: \"admissions@corravale.edu\" },\n68\t  { name: \"Central Information Desk\", to: \"/_404.html\", phone: \"734-764-INFO (4636)\", email: \"info@corravale.edu\" },\n69\t  { name: \"Aid & Funding\", to: \"/_404.html\", phone: \"734-763-6600\", email: \"financial.aid@corravale.edu\" },\n70\t  { name: \"Housing & Residence\", to: \"/_404.html\", phone: \"734-763-3164\", email: \"housing@corravale.edu\" },\n71\t  { name: \"Technology Support Desk\", to: \"/_404.html\", phone: \"734-764-HELP (4357)\", email: \"ithelp@corravale.edu\", chat: \"Chat with a support agent\" },\n72\t  { name: \"Web Accessibility\", to: \"/_404.html\", website: \"Report a Web Accessibility Issue\" },\n73\t  { name: \"Corravale News\", to: \"/_404.html\", phone: \"734-764-7260\" },\n74\t  { name: \"Social Media Listings\", to: \"/_404.html\" },\n75\t  { name: \"Corravale Health\", to: \"/_404.html\", phone: \"734-936-6641\" },\n76\t];\n77\t\n78\texport function ContactPage() {\n79\t  return (\n80\t    <>\n81\t      <PageTitle>Contact Us</PageTitle>\n82\t      <section className=\"bg-[#333] py-8\">\n83\t        <div className=\"mx-auto max-w-[1180px] px-5\">\n84\t          <p className=\"mb-8 text-[14px] leading-relaxed text-white/85\">\n85\t            Have a question but unsure where to start or whom to reach? To point you in the right direction,\n86\t            we've gathered some of the most frequently contacted Corravale departments in the table below.\n87\t            Should you not find the office tied to your particular need, please try our site search to locate\n88\t            the right resource.\n89\t          </p>\n90\t          <div className=\"grid gap-6 lg:grid-cols-[1fr_360px]\">\n91\t            <nav aria-label=\"Most Frequently Reached Campus\" className=\"bg-navy-panel\">\n92\t              <h4 className=\"bg-[#123a66] px-4 py-2 font-cond text-[13px] tracking-[0.1em] text-maize uppercase\">\n93\t                Most Frequently Reached Campus\n94\t              </h4>\n95\t              <dl className=\"px-4\">\n96\t                {departments.map((d) => (\n97\t                  <div\n98\t                    key={d.name}\n99\t                    className=\"grid gap-1 border-b border-white/15 py-[10px] sm:grid-cols-[1fr_auto] sm:items-center\"\n100\t                  >\n101\t                    <dt className=\"sr-only\">Department</dt>\n102\t                    <dd className=\"text-[13.5px] text-maize\">\n103\t                      {d.to ? <Link to={d.to} className=\"hover:underline\">{d.name}</Link> : d.name}\n104\t                    </dd>\n105\t                    <dd className=\"flex flex-wrap justify-end gap-x-5 text-[13px] text-white/85\">\n106\t                      {d.phone && <span>{d.phone}</span>}\n107\t                      {d.email && <span>{d.email}</span>}\n108\t                      {d.website && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.website}</Link>}\n109\t                      {d.chat && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.chat}</Link>}\n110\t                    </dd>\n111\t                  </div>\n112\t                ))}\n113\t              </dl>\n114\t            </nav>\n115\t            <nav aria-label=\"More Contact Options and Links\">\n116\t              <h4 className=\"mb-3 font-cond text-[13px] tracking-[0.1em] text-white uppercase\">\n117\t                More Contact Options and Links\n118\t              </h4>\n119\t              <ul className=\"mb-6 space-y-1\">\n120\t                {[\n121\t                  [\"Find a Department or Unit\", \"/schools-colleges/\"],\n122\t                  [\"Find People on Campus\", \"/_404.html\"],\n123\t                  [\"Request Transcripts\", \"/_404.html\"],\n124\t                  [\"Public Records Requests\", \"/_404.html\"],\n125\t                ].map(([l, to]) => (\n126\t                  <li key={l}>\n127\t                    <Link to={to} className=\"flex items-center justify-between gap-2 text-[14px] text-maize hover:underline\">\n128\t                      {l} <CircleArrowRight size={13} />\n129\t                    </Link>\n130\t                  </li>\n131\t                ))}\n132\t              </ul>\n133\t              <h4 className=\"mb-2 font-cond text-[13px] tracking-[0.1em] text-maize uppercase\">Mailing Addresses</h4>\n134\t              <p className=\"mb-6 text-[13.5px] leading-relaxed text-white/85\">\n135\t                Every campus office at Corravale maintains a unique mailing address. Please{\" \"}\n136\t                <Link to=\"/search/\" className=\"text-maize underline\">browse</Link> our website for a college or\n137\t                unit page to locate the mailing addresses for specific offices.\n138\t              </p>\n139\t              <h4>\n140\t                <Link to=\"/_404.html\" className=\"flex items-center justify-between gap-2 font-cond text-[13px] tracking-[0.1em] text-white uppercase hover:underline\">\n141\t                  Getting Here/Maps/Directions <CircleArrowRight size={13} className=\"text-maize\" />\n142\t                </Link>\n143\t              </h4>\n144\t            </nav>\n145\t          </div>\n146\t        </div>\n147\t      </section>\n148\t    </>\n149\t  );\n150\t}\n151\t\n152\t/* ---------------- Search ---------------- */\n153\texport function SearchPage() {\n154\t  return (\n155\t    <>\n156\t      <PageTitle>Search</PageTitle>\n157\t      <section className=\"min-h-[420px] bg-[#f4f4f4] py-10\">\n158\t        <div className=\"mx-auto max-w-[1100px] px-5\">\n159\t          <form\n160\t            className=\"flex items-center gap-4\"\n161\t            onSubmit={(e) => e.preventDefault()}\n162\t            role=\"search\"\n163\t          >\n164\t            <label htmlFor=\"site-search\" className=\"text-[15px] text-[#333]\">\n165\t              Keywords\n166\t            </label>\n167\t            <span className=\"flex h-[26px] items-center border border-[#8a8a8a] bg-white pl-2\">\n168\t              <input\n169\t                id=\"site-search\"\n170\t                type=\"text\"\n171\t                className=\"h-full w-[218px] bg-transparent text-[14px] text-[#333] outline-none\"\n172\t              />\n173\t              <button type=\"submit\" aria-label=\"Search\" className=\"grid h-full w-[24px] place-items-center text-[#333]\">\n174\t                <SearchGlyph />\n175\t              </button>\n176\t            </span>\n177\t          </form>\n178\t        </div>\n179\t      </section>\n180\t    </>\n181\t  );\n182\t}\n183\t\n184\t/* ---------------- Privacy Notice ---------------- */\n185\texport function PrivacyPage() {\n186\t  return (\n187\t    <ProsePage title=\"Corravale Privacy Notice\">\n188\t      <p className=\"mb-4\">Last Revision Date — May 12, 2024</p>\n189\t      <p className=\"mb-6\">\n190\t        Corravale University recognizes and values the privacy of its community members and guests. We work\n191\t        to set the standard in the ways we handle your personal information. We are dedicated to transparency\n192\t        by helping you understand what personal information we gather, how we make use of it, and when we\n193\t        choose to share it.\n194\t      </p>\n195\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">At a Glance</h4>\n196\t      <p className=\"mb-3\">If you don't have time for the full privacy notice below, here is what you should know:</p>\n197\t      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n198\t        <li>Corravale University is a large institution that operates many different websites. This notice applies to our primary website, corravale.edu. Individual Corravale units and organizations may maintain their own privacy notices.</li>\n199\t        <li>Our aim is to limit the information we gather to only what we need to support our academic, research, and healthcare missions.</li>\n200\t        <li>We are committed to using your personal information only for the purposes for which it was originally gathered.</li>\n201\t        <li>We never sell your personal information, and when we share it beyond Corravale, we do so only to enable operations and services carried out on the university's behalf, to satisfy legal obligations, or to protect the safety, property, or rights of the university, its community and guests.</li>\n202\t        <li>We aim to provide you <Link to=\"/about/privacy/#choices\" className=\"text-[#1a5fa8] underline\">choices</Link> regarding the personal information gathered on our website.</li>\n203\t        <li>If you have questions or concerns about your privacy on the corravale.edu website, please contact the <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Data Privacy Office</Link>.</li>\n204\t      </ul>\n205\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Reach</h4>\n206\t      <p className=\"mb-3\">\n207\t        This privacy notice explains how we handle personal information gathered on the Corravale primary\n208\t        website (corravale.edu). The broader <Link to=\"/about/privacy-statement/\" className=\"text-[#1a5fa8] underline\">privacy overview</Link>{\" \"}\n209\t        outlines the activities carried out across Corravale that involve the gathering and processing of your\n210\t        personal information.\n211\t      </p>\n212\t      <p className=\"mb-6\">\n213\t        Corravale schools, departments, units, clubs, labs, and other groups may keep privacy notices specific\n214\t        to their own collection and processing of your personal information, especially where it differs from\n215\t        the practices set out in this notice.\n216\t      </p>\n217\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Information That We Gather</h4>\n218\t      <p className=\"mb-3\">The Corravale website gathers personal information through the following channels:</p>\n219\t      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n220\t        <li>When you provide it to us directly, such as when you subscribe to a newsletter. This information may include your name and contact details.</li>\n221\t        <li>\n222\t          When technology records your information <em>in real time</em>, such as when a small file is stored\n223\t          on your device. Information gathered this way may include:\n224\t          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n225\t            <li>The network domain you use</li>\n226\t            <li>The device's IP address</li>\n227\t            <li>The browser you use</li>\n228\t            <li>The visit's date and time</li>\n229\t            <li>The address of the site that referred you to corravale.edu.</li>\n230\t          </ul>\n231\t        </li>\n232\t        <li>\n233\t          Once <em>external advertising and analytics partners</em>, such as PageMetrics, gather your\n234\t          information on our behalf. Examples of the details collected by these external service partners\n235\t          include:\n236\t          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n237\t            <li>Pages viewed during the session</li>\n238\t            <li>Time and date of access</li>\n239\t            <li>Total time spent browsing the site</li>\n240\t            <li>Approximate location from IP address</li>\n241\t            <li>General demographic data</li>\n242\t            <li>Search queries typed into the site.</li>\n243\t          </ul>\n244\t        </li>\n245\t      </ul>\n246\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">How Your Information Is Used</h4>\n247\t      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n248\t        <li>Keep our website running smoothly by tracking site performance and improving its functionality and overall user experience.</li>\n249\t        <li>Connect more effectively with prospective students and the wider global community by sharing relevant details about university services, events, and academic programs.</li>\n250\t        <li>On occasion we may use personal information for other legitimate and clearly defined purposes. When such cases arise, we will make every effort to notify you.</li>\n251\t      </ul>\n252\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Parties We Share Your Information With</h4>\n253\t      <p className=\"mb-3\">\n254\t        We neither sell nor rent the personal information collected here. We may share it with service\n255\t        providers that help support our operations and activities. We ask every service provider to keep your\n256\t        personal information secure and to use or share it solely to deliver services on our behalf.\n257\t      </p>\n258\t      <p className=\"mb-6\">\n259\t        We may also disclose your personal information when the law requires it, or when we believe doing so\n260\t        will help safeguard the safety, property, or rights of the university, members of the university\n261\t        community, and university guests.\n262\t      </p>\n263\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">The Choices You Are Able to Make About Your Data</h4>\n264\t      <p className=\"mb-3\">\n265\t        When you browse corravale.edu, \"cookies\" are stored on your computer or device. Cookies are small\n266\t        files that record information about your visits and interactions with the site.\n267\t      </p>\n268\t      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Our Cookies</h5>\n269\t      <table className=\"mb-6 w-full border-collapse text-[13px]\">\n270\t        <thead>\n271\t          <tr className=\"bg-[#e6e6e6] text-left\">\n272\t            <th className=\"border border-[#ccc] p-2\">Cookie label</th>\n273\t            <th className=\"border border-[#ccc] p-2\">Function</th>\n274\t            <th className=\"border border-[#ccc] p-2\">Lifespan</th>\n275\t          </tr>\n276\t        </thead>\n277\t        <tbody>\n278\t          {[\n279\t            [\"alerts-collapsed\", \"Stores whether the user has dismissed the alert bar.\", \"Session (cleared once you close your browser)\"],\n280\t            [\"cv_privacy_consent\", \"Saves the visitor's current consent choice.\", \"1 Year\"],\n281\t            [\"um_cookie_consent\", \"Saves the visitor's current consent choice. (deprecated)\", \"1 Year\"],\n282\t          ].map((r) => (\n283\t            <tr key={r[0]}>\n284\t              {r.map((c, i) => (\n285\t                <td key={i} className=\"border border-[#ccc] p-2 align-top\">{c}</td>\n286\t              ))}\n287\t            </tr>\n288\t          ))}\n289\t        </tbody>\n290\t      </table>\n291\t      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Third-Party Trackers</h5>\n292\t      <table className=\"mb-6 w-full border-collapse text-[13px]\">\n293\t        <thead>\n294\t          <tr className=\"bg-[#e6e6e6] text-left\">\n295\t            <th className=\"border border-[#ccc] p-2\">Cookie type</th>\n296\t            <th className=\"border border-[#ccc] p-2\">Purpose</th>\n297\t            <th className=\"border border-[#ccc] p-2\">Opt-out</th>\n298\t          </tr>\n299\t        </thead>\n300\t        <tbody>\n301\t          <tr>\n302\t            <td className=\"border border-[#ccc] p-2 align-top\">Cloudvane Cookies</td>\n303\t            <td className=\"border border-[#ccc] p-2 align-top\">\n304\t              Cloudvane relies on many <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookies</Link>{\" \"}\n305\t              to optimize network capacity, balance traffic loads, and shield sites from malicious requests.\n306\t              See Cloudvane's <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">privacy policy</Link>.\n307\t            </td>\n308\t            <td className=\"border border-[#ccc] p-2 align-top\">\n309\t              These <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookies</Link> are treated as strictly essential.\n310\t            </td>\n311\t          </tr>\n312\t          <tr>\n313\t            <td className=\"border border-[#ccc] p-2 align-top\">AdReach Ad Cookies</td>\n314\t            <td className=\"border border-[#ccc] p-2 align-top\">\n315\t              AdReach, which is operated by Verano, uses cookies to refine advertising. These cookies gather\n316\t              information tied to your browsing activity and keep it linked to your unique cookie ID. See\n317\t              AdReach's <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookie policy</Link>.\n318\t            </td>\n319\t            <td className=\"border border-[#ccc] p-2 align-top\">\n320\t              You can opt out of Verano's ad personalization within Verano Ads{\" \"}\n321\t              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Settings</Link>.\n322\t            </td>\n323\t          </tr>\n324\t          <tr>\n325\t            <td className=\"border border-[#ccc] p-2 align-top\">Verano Analytics Cookies</td>\n326\t            <td className=\"border border-[#ccc] p-2 align-top\">\n327\t              Verano Analytics cookies tally visits and referral sources so we can measure and improve how our\n328\t              website performs. See details about Verano Analytics'{\" \"}\n329\t              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">use of cookies across websites</Link> and{\" \"}\n330\t              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">privacy policy</Link>.\n331\t            </td>\n332\t            <td className=\"border border-[#ccc] p-2 align-top\">\n333\t              Learn more about controlling{\" \"}\n334\t              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookies within your browser</Link>.\n335\t            </td>\n336\t          </tr>\n337\t          <tr>\n338\t            <td className=\"border border-[#ccc] p-2 align-top\">ClickMap Cookies</td>\n339\t            <td className=\"border border-[#ccc] p-2 align-top\">\n340\t              ClickMap Cookies reveal insights into how visitors use our website. See here the{\" \"}\n341\t              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Privacy Policy</Link> and the{\" \"}\n342\t              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Cookie Policy</Link> of ClickMap.\n343\t            </td>\n344\t            <td className=\"border border-[#ccc] p-2 align-top\">\n345\t              Learn here about how to <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">opt out</Link>.\n346\t            </td>\n347\t          </tr>\n348\t        </tbody>\n349\t      </table>\n350\t      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Adjust Privacy Preferences</h5>\n351\t      <p className=\"mb-2\">Here you can control which categories of cookies our website places on your device.</p>\n352\t      <button className=\"mb-6 border border-[#999] bg-[#eee] px-4 py-2 text-[14px]\">Privacy Preferences</button>\n353\t      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Social Sharing Tools</h5>\n354\t      <p className=\"mb-6\">\n355\t        Several pages across our website include embedded buttons for sharing content on social media. When\n356\t        you use these buttons, the social media platforms may store cookies or apply other tracking\n357\t        technologies on your device. For details on how a particular platform uses cookies, please review the\n358\t        cookie policies of <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Z</Link>,{\" \"}\n359\t        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Streamly</Link>,{\" \"}\n360\t        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Pinstack</Link>,{\" \"}\n361\t        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Careerly</Link>,{\" \"}\n362\t        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Photogram</Link> and{\" \"}\n363\t        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Vidcast</Link>.\n364\t      </p>\n365\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">How We Protect and Safeguard Your Data</h4>\n366\t      <p className=\"mb-6\">\n367\t        Corravale University understands how vital it is to safeguard the information gathered across our\n368\t        community. We work diligently to shield your data from unauthorized access, loss, or misuse, and we\n369\t        maintain sensible safeguards designed to keep the personal information you share with us protected at\n370\t        all times.\n371\t      </p>\n372\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Changes to This Notice</h4>\n373\t      <p className=\"mb-6\">\n374\t        We may revise this privacy notice periodically as our practices evolve. The date of the most recent\n375\t        revision will always appear near the top of this page for your reference.\n376\t      </p>\n377\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Who to Reach with Questions or Concerns</h4>\n378\t      <p className=\"mb-6\">\n379\t        If you have concerns or questions about how your personal information is handled, please reach out to\n380\t        the <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Data Privacy Office</Link>.\n381\t      </p>\n382\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Specific Notices</h4>\n383\t      <ul className=\"list-disc space-y-2 pl-6\">\n384\t        <li><Link to=\"/about/privacy-statement/#coppa\" className=\"text-[#1a5fa8] underline\">Individuals under the age of 13 or their parents or guardians</Link></li>\n385\t        <li><Link to=\"/about/privacy-statement/#eu\" className=\"text-[#1a5fa8] underline\">Individuals within the European Union</Link></li>\n386\t      </ul>\n387\t    </ProsePage>\n388\t  );\n389\t}\n390\t"}]},"parent_tool_use_id":null,"session_id":"1eaa6c29-60a4-48e2-abd6-c10828342ccd","uuid":"8d2366ef-3e62-49c3-854d-f95bd3a7ae09","timestamp":"2026-10-04T04:58:20.043Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/recreation/src/pages/MorePages.tsx","content":"import { Link } from \"@/lib/router\";\nimport { img } from \"@/data/assets\";\nimport { ProsePage, PageTitle } from \"@/components/Layout\";\nimport { CircleArrowRight } from \"@/components/Icons\";\nimport { SearchGlyph } from \"@/components/Header\";\n\ntype GalleryItem = { src: string; alt: string; time?: string };\n\n/* ---------------- Gallery section (Onward Now / Seize the Day) ---------------- */\nexport function HomeGallery({\n  title,\n  items,\n  heading = \"All Corravale, all the time\",\n  blurb = \"There's always something remarkable unfolding at Corravale. Whether it's across our campuses or somewhere far beyond them, our students, faculty, staff and alumni are busy chasing what's next. A selection of moments gathered over the years fills the gallery below.\",\n}: {\n  title: string;\n  items: GalleryItem[];\n  heading?: string;\n  blurb?: string;\n}) {\n  return (\n    <section aria-label={title} className=\"bg-white py-10\">\n      <h2 className=\"mb-8 text-center font-cond text-[26px] tracking-[0.22em] text-[#555] uppercase\">\n        {title}\n      </h2>\n      <div className=\"mx-auto max-w-[1180px] px-5\">\n        <div className=\"mb-8 grid items-center gap-6 md:grid-cols-[220px_1fr]\">\n          <div className=\"flex items-center gap-6\">\n            <img src={img.blockm} alt=\"Block C\" className=\"h-[96px] w-[96px] object-contain\" />\n            <img src={img.hours24} alt=\"24 Hours\" className=\"h-[96px] w-[96px] object-contain\" />\n          </div>\n          <div>\n            <h3 className=\"mb-3 font-cond text-[22px] tracking-[0.08em] text-navy uppercase\">\n              {heading}\n            </h3>\n            <p className=\"text-[14px] leading-relaxed text-[#333]\">{blurb}</p>\n          </div>\n        </div>\n        <ul className=\"grid grid-cols-2 gap-[3px] md:grid-cols-4 lg:grid-cols-6\">\n          {items.map((g) => (\n            <li key={(g.time ?? \"\") + g.src} className=\"group relative cursor-pointer overflow-hidden\">\n              <img src={g.src} alt={g.alt} className=\"h-[150px] w-full object-cover transition group-hover:scale-105\" loading=\"lazy\" />\n              {g.time && (\n                <span className=\"absolute bottom-0 left-0 bg-[#0b1b2b]/75 px-2 py-1 font-cond text-[12px] text-white\">\n                  {g.time}\n                </span>\n              )}\n            </li>\n          ))}\n        </ul>\n      </div>\n    </section>\n  );\n}\n\n/* ---------------- Contact ---------------- */\nconst departments: {\n  name: string;\n  to?: string;\n  phone?: string;\n  email?: string;\n  website?: string;\n  chat?: string;\n}[] = [\n  { name: \"Operators\", phone: \"734-764-1817\" },\n  { name: \"Undergraduate Admissions\", to: \"/_404.html\", phone: \"734-764-7433\" },\n  { name: \"Graduate Admissions\", to: \"/_404.html\", phone: \"734-764-8129\", email: \"admissions@corravale.edu\" },\n  { name: \"Central Information Desk\", to: \"/_404.html\", phone: \"734-764-INFO (4636)\", email: \"info@corravale.edu\" },\n  { name: \"Aid & Funding\", to: \"/_404.html\", phone: \"734-763-6600\", email: \"financial.aid@corravale.edu\" },\n  { name: \"Housing & Residence\", to: \"/_404.html\", phone: \"734-763-3164\", email: \"housing@corravale.edu\" },\n  { name: \"Technology Support Desk\", to: \"/_404.html\", phone: \"734-764-HELP (4357)\", email: \"ithelp@corravale.edu\", chat: \"Chat with a support agent\" },\n  { name: \"Web Accessibility\", to: \"/_404.html\", website: \"Report a Web Accessibility Issue\" },\n  { name: \"Corravale News\", to: \"/_404.html\", phone: \"734-764-7260\" },\n  { name: \"Social Media Listings\", to: \"/_404.html\" },\n  { name: \"Corravale Health\", to: \"/_404.html\", phone: \"734-936-6641\" },\n];\n\nexport function ContactPage() {\n  return (\n    <>\n      <PageTitle>Contact Us</PageTitle>\n      <section className=\"bg-[#333] py-8\">\n        <div className=\"mx-auto max-w-[1180px] px-5\">\n          <p className=\"mb-8 text-[14px] leading-relaxed text-white/85\">\n            Have a question but unsure where to start or whom to reach? To point you in the right direction,\n            we've gathered some of the most frequently contacted Corravale departments in the table below.\n            Should you not find the office tied to your particular need, please try our site search to locate\n            the right resource.\n          </p>\n          <div className=\"grid gap-6 lg:grid-cols-[1fr_360px]\">\n            <nav aria-label=\"Most Frequently Reached Campus\" className=\"bg-navy-panel\">\n              <h4 className=\"bg-[#123a66] px-4 py-2 font-cond text-[13px] tracking-[0.1em] text-maize uppercase\">\n                Most Frequently Reached Campus\n              </h4>\n              <dl className=\"px-4\">\n                {departments.map((d) => (\n                  <div\n                    key={d.name}\n                    className=\"grid gap-1 border-b border-white/15 py-[10px] sm:grid-cols-[1fr_auto] sm:items-center\"\n                  >\n                    <dt className=\"sr-only\">Department</dt>\n                    <dd className=\"text-[13.5px] text-maize\">\n                      {d.to ? <Link to={d.to} className=\"hover:underline\">{d.name}</Link> : d.name}\n                    </dd>\n                    <dd className=\"flex flex-wrap justify-end gap-x-5 text-[13px] text-white/85\">\n                      {d.phone && <span>{d.phone}</span>}\n                      {d.email && <span>{d.email}</span>}\n                      {d.website && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.website}</Link>}\n                      {d.chat && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.chat}</Link>}\n                    </dd>\n                  </div>\n                ))}\n              </dl>\n            </nav>\n            <nav aria-label=\"More Contact Options and Links\">\n              <h4 className=\"mb-3 font-cond text-[13px] tracking-[0.1em] text-white uppercase\">\n                More Contact Options and Links\n              </h4>\n              <ul className=\"mb-6 space-y-1\">\n                {[\n                  [\"Find a Department or Unit\", \"/schools-colleges/\"],\n                  [\"Find People on Campus\", \"/_404.html\"],\n                  [\"Request Transcripts\", \"/_404.html\"],\n                  [\"Public Records Requests\", \"/_404.html\"],\n                ].map(([l, to]) => (\n                  <li key={l}>\n                    <Link to={to} className=\"flex items-center justify-between gap-2 text-[14px] text-maize hover:underline\">\n                      {l} <CircleArrowRight size={13} />\n                    </Link>\n                  </li>\n                ))}\n              </ul>\n              <h4 className=\"mb-2 font-cond text-[13px] tracking-[0.1em] text-maize uppercase\">Mailing Addresses</h4>\n              <p className=\"mb-6 text-[13.5px] leading-relaxed text-white/85\">\n                Every campus office at Corravale maintains a unique mailing address. Please{\" \"}\n                <Link to=\"/search/\" className=\"text-maize underline\">browse</Link> our website for a college or\n                unit page to locate the mailing addresses for specific offices.\n              </p>\n              <h4>\n                <Link to=\"/_404.html\" className=\"flex items-center justify-between gap-2 font-cond text-[13px] tracking-[0.1em] text-white uppercase hover:underline\">\n                  Getting Here/Maps/Directions <CircleArrowRight size={13} className=\"text-maize\" />\n                </Link>\n              </h4>\n            </nav>\n          </div>\n        </div>\n      </section>\n    </>\n  );\n}\n\n/* ---------------- Search ---------------- */\nexport function SearchPage() {\n  return (\n    <>\n      <PageTitle>Search</PageTitle>\n      <section className=\"min-h-[420px] bg-[#f4f4f4] py-10\">\n        <div className=\"mx-auto max-w-[1100px] px-5\">\n          <form\n            className=\"flex items-center gap-4\"\n            onSubmit={(e) => e.preventDefault()}\n            role=\"search\"\n          >\n            <label htmlFor=\"site-search\" className=\"text-[15px] text-[#333]\">\n              Keywords\n            </label>\n            <span className=\"flex h-[26px] items-center border border-[#8a8a8a] bg-white pl-2\">\n              <input\n                id=\"site-search\"\n                type=\"text\"\n                className=\"h-full w-[218px] bg-transparent text-[14px] text-[#333] outline-none\"\n              />\n              <button type=\"submit\" aria-label=\"Search\" className=\"grid h-full w-[24px] place-items-center text-[#333]\">\n                <SearchGlyph />\n              </button>\n            </span>\n          </form>\n        </div>\n      </section>\n    </>\n  );\n}\n\n/* ---------------- Privacy Notice ---------------- */\nexport function PrivacyPage() {\n  return (\n    <ProsePage title=\"Corravale Privacy Notice\">\n      <p className=\"mb-4\">Last Revision Date — May 12, 2024</p>\n      <p className=\"mb-6\">\n        Corravale University recognizes and values the privacy of its community members and guests. We work\n        to set the standard in the ways we handle your personal information. We are dedicated to transparency\n        by helping you understand what personal information we gather, how we make use of it, and when we\n        choose to share it.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">At a Glance</h4>\n      <p className=\"mb-3\">If you don't have time for the full privacy notice below, here is what you should know:</p>\n      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n        <li>Corravale University is a large institution that operates many different websites. This notice applies to our primary website, corravale.edu. Individual Corravale units and organizations may maintain their own privacy notices.</li>\n        <li>Our aim is to limit the information we gather to only what we need to support our academic, research, and healthcare missions.</li>\n        <li>We are committed to using your personal information only for the purposes for which it was originally gathered.</li>\n        <li>We never sell your personal information, and when we share it beyond Corravale, we do so only to enable operations and services carried out on the university's behalf, to satisfy legal obligations, or to protect the safety, property, or rights of the university, its community and guests.</li>\n        <li>We aim to provide you <Link to=\"/about/privacy/#choices\" className=\"text-[#1a5fa8] underline\">choices</Link> regarding the personal information gathered on our website.</li>\n        <li>If you have questions or concerns about your privacy on the corravale.edu website, please contact the <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Data Privacy Office</Link>.</li>\n      </ul>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Reach</h4>\n      <p className=\"mb-3\">\n        This privacy notice explains how we handle personal information gathered on the Corravale primary\n        website (corravale.edu). The broader <Link to=\"/about/privacy-statement/\" className=\"text-[#1a5fa8] underline\">privacy overview</Link>{\" \"}\n        outlines the activities carried out across Corravale that involve the gathering and processing of your\n        personal information.\n      </p>\n      <p className=\"mb-6\">\n        Corravale schools, departments, units, clubs, labs, and other groups may keep privacy notices specific\n        to their own collection and processing of your personal information, especially where it differs from\n        the practices set out in this notice.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Information That We Gather</h4>\n      <p className=\"mb-3\">The Corravale website gathers personal information through the following channels:</p>\n      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n        <li>When you provide it to us directly, such as when you subscribe to a newsletter. This information may include your name and contact details.</li>\n        <li>\n          When technology records your information <em>in real time</em>, such as when a small file is stored\n          on your device. Information gathered this way may include:\n          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n            <li>The network domain you use</li>\n            <li>The device's IP address</li>\n            <li>The browser you use</li>\n            <li>The visit's date and time</li>\n            <li>The address of the site that referred you to corravale.edu.</li>\n          </ul>\n        </li>\n        <li>\n          Once <em>external advertising and analytics partners</em>, such as PageMetrics, gather your\n          information on our behalf. Examples of the details collected by these external service partners\n          include:\n          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n            <li>Pages viewed during the session</li>\n            <li>Time and date of access</li>\n            <li>Total time spent browsing the site</li>\n            <li>Approximate location from IP address</li>\n            <li>General demographic data</li>\n            <li>Search queries typed into the site.</li>\n          </ul>\n        </li>\n      </ul>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">How Your Information Is Used</h4>\n      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n        <li>Keep our website running smoothly by tracking site performance and improving its functionality and overall user experience.</li>\n        <li>Connect more effectively with prospective students and the wider global community by sharing relevant details about university services, events, and academic programs.</li>\n        <li>On occasion we may use personal information for other legitimate and clearly defined purposes. When such cases arise, we will make every effort to notify you.</li>\n      </ul>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Parties We Share Your Information With</h4>\n      <p className=\"mb-3\">\n        We neither sell nor rent the personal information collected here. We may share it with service\n        providers that help support our operations and activities. We ask every service provider to keep your\n        personal information secure and to use or share it solely to deliver services on our behalf.\n      </p>\n      <p className=\"mb-6\">\n        We may also disclose your personal information when the law requires it, or when we believe doing so\n        will help safeguard the safety, property, or rights of the university, members of the university\n        community, and university guests.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">The Choices You Are Able to Make About Your Data</h4>\n      <p className=\"mb-3\">\n        When you browse corravale.edu, \"cookies\" are stored on your computer or device. Cookies are small\n        files that record information about your visits and interactions with the site.\n      </p>\n      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Our Cookies</h5>\n      <table className=\"mb-6 w-full border-collapse text-[13px]\">\n        <thead>\n          <tr className=\"bg-[#e6e6e6] text-left\">\n            <th className=\"border border-[#ccc] p-2\">Cookie label</th>\n            <th className=\"border border-[#ccc] p-2\">Function</th>\n            <th className=\"border border-[#ccc] p-2\">Lifespan</th>\n          </tr>\n        </thead>\n        <tbody>\n          {[\n            [\"alerts-collapsed\", \"Stores whether the user has dismissed the alert bar.\", \"Session (cleared once you close your browser)\"],\n            [\"cv_privacy_consent\", \"Saves the visitor's current consent choice.\", \"1 Year\"],\n            [\"um_cookie_consent\", \"Saves the visitor's current consent choice. (deprecated)\", \"1 Year\"],\n          ].map((r) => (\n            <tr key={r[0]}>\n              {r.map((c, i) => (\n                <td key={i} className=\"border border-[#ccc] p-2 align-top\">{c}</td>\n              ))}\n            </tr>\n          ))}\n        </tbody>\n      </table>\n      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Third-Party Trackers</h5>\n      <table className=\"mb-6 w-full border-collapse text-[13px]\">\n        <thead>\n          <tr className=\"bg-[#e6e6e6] text-left\">\n            <th className=\"border border-[#ccc] p-2\">Cookie type</th>\n            <th className=\"border border-[#ccc] p-2\">Purpose</th>\n            <th className=\"border border-[#ccc] p-2\">Opt-out</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td className=\"border border-[#ccc] p-2 align-top\">Cloudvane Cookies</td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              Cloudvane relies on many <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookies</Link>{\" \"}\n              to optimize network capacity, balance traffic loads, and shield sites from malicious requests.\n              See Cloudvane's <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">privacy policy</Link>.\n            </td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              These <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookies</Link> are treated as strictly essential.\n            </td>\n          </tr>\n          <tr>\n            <td className=\"border border-[#ccc] p-2 align-top\">AdReach Ad Cookies</td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              AdReach, which is operated by Verano, uses cookies to refine advertising. These cookies gather\n              information tied to your browsing activity and keep it linked to your unique cookie ID. See\n              AdReach's <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookie policy</Link>.\n            </td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              You can opt out of Verano's ad personalization within Verano Ads{\" \"}\n              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Settings</Link>.\n            </td>\n          </tr>\n          <tr>\n            <td className=\"border border-[#ccc] p-2 align-top\">Verano Analytics Cookies</td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              Verano Analytics cookies tally visits and referral sources so we can measure and improve how our\n              website performs. See details about Verano Analytics'{\" \"}\n              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">use of cookies across websites</Link> and{\" \"}\n              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">privacy policy</Link>.\n            </td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              Learn more about controlling{\" \"}\n              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">cookies within your browser</Link>.\n            </td>\n          </tr>\n          <tr>\n            <td className=\"border border-[#ccc] p-2 align-top\">ClickMap Cookies</td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              ClickMap Cookies reveal insights into how visitors use our website. See here the{\" \"}\n              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Privacy Policy</Link> and the{\" \"}\n              <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Cookie Policy</Link> of ClickMap.\n            </td>\n            <td className=\"border border-[#ccc] p-2 align-top\">\n              Learn here about how to <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">opt out</Link>.\n            </td>\n          </tr>\n        </tbody>\n      </table>\n      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Adjust Privacy Preferences</h5>\n      <p className=\"mb-2\">Here you can control which categories of cookies our website places on your device.</p>\n      <button className=\"mb-6 border border-[#999] bg-[#eee] px-4 py-2 text-[14px]\">Privacy Preferences</button>\n      <h5 className=\"mt-4 mb-2 font-cond text-[16px] text-[#444]\">Social Sharing Tools</h5>\n      <p className=\"mb-6\">\n        Several pages across our website include embedded buttons for sharing content on social media. When\n        you use these buttons, the social media platforms may store cookies or apply other tracking\n        technologies on your device. For details on how a particular platform uses cookies, please review the\n        cookie policies of <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Z</Link>,{\" \"}\n        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Streamly</Link>,{\" \"}\n        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Pinstack</Link>,{\" \"}\n        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Careerly</Link>,{\" \"}\n        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Photogram</Link> and{\" \"}\n        <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Vidcast</Link>.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">How We Protect and Safeguard Your Data</h4>\n      <p className=\"mb-6\">\n        Corravale University understands how vital it is to safeguard the information gathered across our\n        community. We work diligently to shield your data from unauthorized access, loss, or misuse, and we\n        maintain sensible safeguards designed to keep the personal information you share with us protected at\n        all times.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Changes to This Notice</h4>\n      <p className=\"mb-6\">\n        We may revise this privacy notice periodically as our practices evolve. The date of the most recent\n        revision will always appear near the top of this page for your reference.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Who to Reach with Questions or Concerns</h4>\n      <p className=\"mb-6\">\n        If you have concerns or questions about how your personal information is handled, please reach out to\n        the <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Data Privacy Office</Link>.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Specific Notices</h4>\n      <ul className=\"list-disc space-y-2 pl-6\">\n        <li><Link to=\"/about/privacy-statement/#coppa\" className=\"text-[#1a5fa8] underline\">Individuals under the age of 13 or their parents or guardians</Link></li>\n        <li><Link to=\"/about/privacy-statement/#eu\" className=\"text-[#1a5fa8] underline\">Individuals within the European Union</Link></li>\n      </ul>\n    </ProsePage>\n  );\n}\n","numLines":390,"startLine":1,"totalLines":390}}}
