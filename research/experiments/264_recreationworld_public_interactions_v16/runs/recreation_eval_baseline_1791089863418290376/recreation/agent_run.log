-[420px] bg-[#f4f4f4] py-10\">\n        <div className=\"mx-auto max-w-[1100px] px-5\">\n          <form className=\"flex items-center gap-4\" onSubmit={onSubmit} role=\"search\">\n            <label htmlFor=\"site-search\" className=\"text-[15px] text-[#333]\">\n              Keywords\n            </label>\n            <span className=\"flex h-[26px] items-center border border-[#8a8a8a] bg-white pl-2\">\n              <input\n                id=\"site-search\"\n                name=\"keywords\"\n                type=\"text\"\n                className=\"h-full w-[218px] bg-transparent text-[14px] text-[#333] outline-none\"\n              />\n            </span>\n          </form>\n          <p className=\"mt-4\">\n            <button\n              type=\"submit\"\n              form=\"\"\n              onClick={(e) => {\n                const form = e.currentTarget.closest(\"form\");\n                form?.requestSubmit();\n              }}\n              className=\"flex items-center gap-1 font-cond text-[15px] tracking-[0.04em] text-[#1a5fa8] hover:underline\"\n            >\n              <span className=\"text-[#4a9fe0]\">▸</span>\n              Search\n            </button>\n          </p>\n        </div>\n      </section>\n    </>\n  );\n}"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":336590,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1eaa6c29-60a4-48e2-abd6-c10828342ccd","uuid":"5d977ab6-1e21-47e2-a659-a5734a2eeeb0"}
