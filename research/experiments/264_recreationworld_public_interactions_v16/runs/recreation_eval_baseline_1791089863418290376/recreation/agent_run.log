{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00_s1lZy2jPh8jCcMUNAsUH6511","type":"tool_result","content":"1\timport { useState, type FormEvent } from \"react\";\n2\timport { Link, useRouter } from \"@/lib/router\";\n3\timport { cn } from \"@/utils/cn\";\n4\timport { audiences, chromeFor, mainMenu } from \"@/data/site\";\n5\timport { img } from \"@/data/assets\";\n6\timport {\n7\t  ChevronDown,\n8\t  ChevronRight,\n9\t  Close,\n10\t  Home,\n11\t} from \"./Icons\";\n12\t\n13\t/** Normalize a route to a trailing-slash form so label lookups stay stable. */\n14\tfunction withTrailingSlash(path: string) {\n15\t  if (path === \"/\" || path.endsWith(\"/\")) return path;\n16\t  return path + \"/\";\n17\t}\n18\t\n19\texport function Header({ path }: { path: string }) {\n20\t  const [quickOpen, setQuickOpen] = useState(false);\n21\t  const [menuOpen, setMenuOpen] = useState(false);\n22\t  const route = withTrailingSlash(path);\n23\t  const chrome = chromeFor(route);\n24\t  const { navigate } = useRouter();\n25\t\n26\t  function onSearch(e: FormEvent<HTMLFormElement>) {\n27\t    e.preventDefault();\n28\t    const value = new FormData(e.currentTarget).get(\"keywords\");\n29\t    const q = typeof value === \"string\" ? value.trim() : \"\";\n30\t    navigate(q ? `/search/?keywords=${encodeURIComponent(q)}` : \"/search/\");\n31\t  }\n32\t  const activeIndex = mainMenu.findIndex(\n33\t    (item) => item.to !== \"/\" && (route === item.to || route.startsWith(item.to))\n34\t  );\n35\t\n36\t  return (\n37\t    <header className=\"relative z-30 bg-navy\">\n38\t      <div className=\"mx-auto flex max-w-[1440px] items-start px-4 lg:px-0\">\n39\t        <h1 className=\"relative z-40 mt-0 shrink-0\">\n40\t          <Link to=\"/\" className=\"block\" aria-label=\"Corravale University\">\n41\t            <img src={img.logo} alt=\"Corravale University\" className=\"w-[130px] shadow-lg lg:w-[170px]\" />\n42\t          </Link>\n43\t        </h1>\n44\t\n45\t        <div className=\"flex min-w-0 flex-1 flex-col\">\n46\t          <div className=\"flex flex-col gap-2 py-2 lg:flex-row lg:items-center lg:justify-end lg:gap-3 lg:pt-3\">\n47\t            <Link\n48\t              to=\"/_404.html\"\n49\t              className=\"flex items-center justify-center gap-2 bg-maize px-3 py-[6px] text-center font-cond text-[13px] text-[#0b1b2b] hover:bg-[#ffd633] lg:text-[14px]\"\n50\t            >\n51\t              <span>{chrome.report}</span>\n52\t              <span className=\"grid h-[14px] w-[14px] shrink-0 place-items-center rounded-full border border-[#0b1b2b] text-[9px] leading-none\">\n53\t                i\n54\t              </span>\n55\t            </Link>\n56\t            <form className=\"flex items-center\" onSubmit={onSearch} role=\"search\">\n57\t              <label className=\"sr-only\" htmlFor=\"header-search\">\n58\t                {chrome.searchLabel}\n59\t              </label>\n60\t              <span className=\"flex h-[30px] w-full items-center rounded-[3px] bg-white pl-3 lg:w-[300px]\">\n61\t                <input\n62\t                  id=\"header-search\"\n63\t                  name=\"keywords\"\n64\t                  type=\"search\"\n65\t                  placeholder=\"Search\"\n66\t                  className=\"h-full w-full bg-transparent text-[13px] text-[#333] outline-none\"\n67\t                />\n68\t                <button\n69\t                  type=\"submit\"\n70\t                  aria-label={chrome.searchButton ?? \"Search\"}\n71\t                  className=\"grid h-full w-[30px] shrink-0 place-items-center text-[#333]\"\n72\t                >\n73\t                  <SearchGlyph />\n74\t                </button>\n75\t              </span>\n76\t            </form>\n77\t          </div>\n78\t\n79\t          <div className=\"flex flex-col gap-2 pb-2 lg:flex-row lg:items-stretch lg:justify-between lg:pb-3\">\n80\t            <nav aria-label={chrome.audienceLabel}>\n81\t              <ul className=\"grid grid-cols-2 border-t border-l border-white/25 sm:grid-cols-3 lg:flex lg:border-0\">\n82\t                <li className=\"border-r border-b border-white/25 px-3 py-[7px] font-cond text-[12px] tracking-[0.1em] text-white uppercase lg:border-0 lg:bg-white/10\">\n83\t                  For:\n84\t                </li>\n85\t                {audiences.map((a) => (\n86\t                  <li key={a.to} className=\"border-r border-b border-white/25 lg:border-0\">\n87\t                    <Link\n88\t                      to={a.to}\n89\t                      className=\"block h-full px-3 py-[7px] font-cond text-[12px] tracking-[0.08em] text-white uppercase hover:bg-white/15\"\n90\t                    >\n91\t                      {a.label}\n92\t                    </Link>\n93\t                  </li>\n94\t                ))}\n95\t              </ul>\n96\t            </nav>\n97\t            <div className=\"relative shrink-0\">\n98\t              <button\n99\t                onClick={() => setQuickOpen((v) => !v)}\n100\t                aria-expanded={quickOpen}\n101\t                className=\"block w-full bg-maize px-4 py-[6px] font-cond text-[13px] tracking-[0.12em] text-[#0b1b2b] uppercase hover:bg-[#ffd633] lg:w-auto\"\n102\t              >\n103\t                {chrome.quickTitle}\n104\t              </button>\n105\t              {quickOpen && (\n106\t                <nav className=\"absolute top-[calc(100%+8px)] right-0 z-50 w-[220px] bg-band py-3 shadow-xl\">\n107\t                  <ul className=\"divide-y divide-white/10\">\n108\t                    {chrome.quick.map(([label, to]) => (\n109\t                      <li key={label}>\n110\t                        <Link\n111\t                          to={to}\n112\t                          onClick={() => setQuickOpen(false)}\n113\t                          className=\"block px-4 py-[7px] text-[14px] text-white/90 hover:bg-white/10 hover:text-white\"\n114\t                        >\n115\t                          {label}\n116\t                        </Link>\n117\t                      </li>\n118\t                    ))}\n119\t                  </ul>\n120\t                </nav>\n121\t              )}\n122\t            </div>\n123\t          </div>\n124\t        </div>\n125\t      </div>\n126\t\n127\t      <nav aria-label={chrome.menuLabel} className=\"bg-nav\">\n128\t        <div className=\"mx-auto flex max-w-[1440px] items-stretch\">\n129\t          <ul className=\"hidden flex-1 items-stretch lg:flex\">\n130\t            {mainMenu.map((item, i) => (\n131\t              <li key={item.to} className=\"flex-1\">\n132\t                <Link\n133\t                  to={item.to}\n134\t                  className={cn(\n135\t                    \"flex h-full items-center justify-center gap-2 border-r border-white/15 px-2 py-[12px] font-cond text-[15px] text-white hover:bg-navhover\",\n136\t                    i === activeIndex && \"bg-navy\"\n137\t                  )}\n138\t                >\n139\t                  {item.label === \"Home\" ? (\n140\t                    <>\n141\t                      <Home size={15} />\n142\t                      <span className=\"sr-only\">Home</span>\n143\t                    </>\n144\t                  ) : (\n145\t                    item.label\n146\t                  )}\n147\t                </Link>\n148\t              </li>\n149\t            ))}\n150\t          </ul>\n151\t          <a\n152\t            href=\"javascript:void(0);\"\n153\t            onClick={(event) => {\n154\t              event.preventDefault();\n155\t              setMenuOpen((v) => !v);\n156\t            }}\n157\t            aria-expanded={menuOpen}\n158\t            className=\"flex w-full items-center justify-between gap-3 bg-nav px-4 py-3 lg:hidden\"\n159\t          >\n160\t            <h3 className=\"font-cond text-[18px] font-normal tracking-[0.08em] text-maize uppercase\">\n161\t              {chrome.menuLabel}\n162\t            </h3>\n163\t          </a>\n164\t        </div>\n165\t        {menuOpen && (\n166\t          <ul className=\"lg:hidden\">\n167\t            {mainMenu.map((item) => (\n168\t              <li key={item.to}>\n169\t                <Link\n170\t                  to={item.to}\n171\t                  onClick={() => setMenuOpen(false)}\n172\t                  className=\"flex items-center justify-between border-b border-white/15 bg-nav px-5 py-3 font-cond text-[16px] text-white\"\n173\t                >\n174\t                  {item.label}\n175\t                  <ChevronRight size={14} />\n176\t                </Link>\n177\t              </li>\n178\t            ))}\n179\t          </ul>\n180\t        )}\n181\t      </nav>\n182\t    </header>\n183\t  );\n184\t}\n185\t\n186\texport function SearchGlyph() {\n187\t  return (\n188\t    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.4\">\n189\t      <circle cx=\"11\" cy=\"11\" r=\"6.5\" />\n190\t      <path d=\"M20 20l-4.2-4.2\" strokeLinecap=\"round\" />\n191\t    </svg>\n192\t  );\n193\t}\n194\t"}]},"parent_tool_use_id":null,"session_id":"1eaa6c29-60a4-48e2-abd6-c10828342ccd","uuid":"3c7ff929-2933-431d-9396-adb0cb6b0f65","timestamp":"2026-10-04T05:00:54.377Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/recreation/src/components/Header.tsx","content":"import { useState, type FormEvent } from \"react\";\nimport { Link, useRouter } from \"@/lib/router\";\nimport { cn } from \"@/utils/cn\";\nimport { audiences, chromeFor, mainMenu } from \"@/data/site\";\nimport { img } from \"@/data/assets\";\nimport {\n  ChevronDown,\n  ChevronRight,\n  Close,\n  Home,\n} from \"./Icons\";\n\n/** Normalize a route to a trailing-slash form so label lookups stay stable. */\nfunction withTrailingSlash(path: string) {\n  if (path === \"/\" || path.endsWith(\"/\")) return path;\n  return path + \"/\";\n}\n\nexport function Header({ path }: { path: string }) {\n  const [quickOpen, setQuickOpen] = useState(false);\n  const [menuOpen, setMenuOpen] = useState(false);\n  const route = withTrailingSlash(path);\n  const chrome = chromeFor(route);\n  const { navigate } = useRouter();\n\n  function onSearch(e: FormEvent<HTMLFormElement>) {\n    e.preventDefault();\n    const value = new FormData(e.currentTarget).get(\"keywords\");\n    const q = typeof value === \"string\" ? value.trim() : \"\";\n    navigate(q ? `/search/?keywords=${encodeURIComponent(q)}` : \"/search/\");\n  }\n  const activeIndex = mainMenu.findIndex(\n    (item) => item.to !== \"/\" && (route === item.to || route.startsWith(item.to))\n  );\n\n  return (\n    <header className=\"relative z-30 bg-navy\">\n      <div className=\"mx-auto flex max-w-[1440px] items-start px-4 lg:px-0\">\n        <h1 className=\"relative z-40 mt-0 shrink-0\">\n          <Link to=\"/\" className=\"block\" aria-label=\"Corravale University\">\n            <img src={img.logo} alt=\"Corravale University\" className=\"w-[130px] shadow-lg lg:w-[170px]\" />\n          </Link>\n        </h1>\n\n        <div className=\"flex min-w-0 flex-1 flex-col\">\n          <div className=\"flex flex-col gap-2 py-2 lg:flex-row lg:items-center lg:justify-end lg:gap-3 lg:pt-3\">\n            <Link\n              to=\"/_404.html\"\n              className=\"flex items-center justify-center gap-2 bg-maize px-3 py-[6px] text-center font-cond text-[13px] text-[#0b1b2b] hover:bg-[#ffd633] lg:text-[14px]\"\n            >\n              <span>{chrome.report}</span>\n              <span className=\"grid h-[14px] w-[14px] shrink-0 place-items-center rounded-full border border-[#0b1b2b] text-[9px] leading-none\">\n                i\n              </span>\n            </Link>\n            <form className=\"flex items-center\" onSubmit={onSearch} role=\"search\">\n              <label className=\"sr-only\" htmlFor=\"header-search\">\n                {chrome.searchLabel}\n              </label>\n              <span className=\"flex h-[30px] w-full items-center rounded-[3px] bg-white pl-3 lg:w-[300px]\">\n                <input\n                  id=\"header-search\"\n                  name=\"keywords\"\n                  type=\"search\"\n                  placeholder=\"Search\"\n                  className=\"h-full w-full bg-transparent text-[13px] text-[#333] outline-none\"\n                />\n                <button\n                  type=\"submit\"\n                  aria-label={chrome.searchButton ?? \"Search\"}\n                  className=\"grid h-full w-[30px] shrink-0 place-items-center text-[#333]\"\n                >\n                  <SearchGlyph />\n                </button>\n              </span>\n            </form>\n          </div>\n\n          <div className=\"flex flex-col gap-2 pb-2 lg:flex-row lg:items-stretch lg:justify-between lg:pb-3\">\n            <nav aria-label={chrome.audienceLabel}>\n              <ul className=\"grid grid-cols-2 border-t border-l border-white/25 sm:grid-cols-3 lg:flex lg:border-0\">\n                <li className=\"border-r border-b border-white/25 px-3 py-[7px] font-cond text-[12px] tracking-[0.1em] text-white uppercase lg:border-0 lg:bg-white/10\">\n                  For:\n                </li>\n                {audiences.map((a) => (\n                  <li key={a.to} className=\"border-r border-b border-white/25 lg:border-0\">\n                    <Link\n                      to={a.to}\n                      className=\"block h-full px-3 py-[7px] font-cond text-[12px] tracking-[0.08em] text-white uppercase hover:bg-white/15\"\n                    >\n                      {a.label}\n                    </Link>\n                  </li>\n                ))}\n              </ul>\n            </nav>\n            <div className=\"relative shrink-0\">\n              <button\n                onClick={() => setQuickOpen((v) => !v)}\n                aria-expanded={quickOpen}\n                className=\"block w-full bg-maize px-4 py-[6px] font-cond text-[13px] tracking-[0.12em] text-[#0b1b2b] uppercase hover:bg-[#ffd633] lg:w-auto\"\n              >\n                {chrome.quickTitle}\n              </button>\n              {quickOpen && (\n                <nav className=\"absolute top-[calc(100%+8px)] right-0 z-50 w-[220px] bg-band py-3 shadow-xl\">\n                  <ul className=\"divide-y divide-white/10\">\n                    {chrome.quick.map(([label, to]) => (\n                      <li key={label}>\n                        <Link\n                          to={to}\n                          onClick={() => setQuickOpen(false)}\n                          className=\"block px-4 py-[7px] text-[14px] text-white/90 hover:bg-white/10 hover:text-white\"\n                        >\n                          {label}\n                        </Link>\n                      </li>\n                    ))}\n                  </ul>\n                </nav>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <nav aria-label={chrome.menuLabel} className=\"bg-nav\">\n        <div className=\"mx-auto flex max-w-[1440px] items-stretch\">\n          <ul className=\"hidden flex-1 items-stretch lg:flex\">\n            {mainMenu.map((item, i) => (\n              <li key={item.to} className=\"flex-1\">\n                <Link\n                  to={item.to}\n                  className={cn(\n                    \"flex h-full items-center justify-center gap-2 border-r border-white/15 px-2 py-[12px] font-cond text-[15px] text-white hover:bg-navhover\",\n                    i === activeIndex && \"bg-navy\"\n                  )}\n                >\n                  {item.label === \"Home\" ? (\n                    <>\n                      <Home size={15} />\n                      <span className=\"sr-only\">Home</span>\n                    </>\n                  ) : (\n                    item.label\n                  )}\n                </Link>\n              </li>\n            ))}\n          </ul>\n          <a\n            href=\"javascript:void(0);\"\n            onClick={(event) => {\n              event.preventDefault();\n              setMenuOpen((v) => !v);\n            }}\n            aria-expanded={menuOpen}\n            className=\"flex w-full items-center justify-between gap-3 bg-nav px-4 py-3 lg:hidden\"\n          >\n            <h3 className=\"font-cond text-[18px] font-normal tracking-[0.08em] text-maize uppercase\">\n              {chrome.menuLabel}\n            </h3>\n          </a>\n        </div>\n        {menuOpen && (\n          <ul className=\"lg:hidden\">\n            {mainMenu.map((item) => (\n              <li key={item.to}>\n                <Link\n                  to={item.to}\n                  onClick={() => setMenuOpen(false)}\n                  className=\"flex items-center justify-between border-b border-white/15 bg-nav px-5 py-3 font-cond text-[16px] text-white\"\n                >\n                  {item.label}\n                  <ChevronRight size={14} />\n                </Link>\n              </li>\n            ))}\n          </ul>\n        )}\n      </nav>\n    </header>\n  );\n}\n\nexport function SearchGlyph() {\n  return (\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.4\">\n      <circle cx=\"11\" cy=\"11\" r=\"6.5\" />\n      <path d=\"M20 20l-4.2-4.2\" strokeLinecap=\"round\" />\n    </svg>\n  );\n}\n","numLines":194,"startLine":1,"totalLines":194}}}
