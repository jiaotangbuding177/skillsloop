For(path)}\n      </main>\n      <Footer />\n    </div>\n  );\n}\n\nexport function App() {\n  return (\n    <RouterProvider>\n      <Shell />\n    </RouterProvider>\n  );\n}\n=== PAGES ===\nContentPages.tsx\nHomePage.tsx\nMorePages.tsx\nOfflinePage.tsx\n=== COMPONENTS ===\nBits.tsx\nFooter.tsx\nHeader.tsx\nIcons.tsx\nLayout.tsx\n=== LIB ===\nrouter.tsx\n=== DATA ===\nassets.ts\nsite.ts\n=== CHECKLIST ===\n=== check root ===","is_error":true,"tool_use_id":"chatcmpl-tool-92fcbc4fac99db1c"}]},"parent_tool_use_id":null,"session_id":"1eaa6c29-60a4-48e2-abd6-c10828342ccd","uuid":"58462049-37de-49c6-8d64-d1c4536f804f","timestamp":"2026-10-04T04:58:09.899Z","tool_use_result":"Error: Exit code 2\nimport { useEffect } from \"react\";\nimport { RouterProvider, useRouter } from \"@/lib/router\";\nimport { chromeFor } from \"@/data/site\";\nimport { Header } from \"@/components/Header\";\nimport { Footer } from \"@/components/Footer\";\nimport { HomePage } from \"@/pages/HomePage\";\nimport {\n  AboutPage,\n  AcademicsPage,\n  LifePage,\n  AthleticsPage,\n  ResearchPage,\n  HealthPage,\n  InitiativesPage,\n  GivingPage,\n  ProspectivePage,\n  CurrentStudentsPage,\n  FacultyStaffPage,\n  ParentsPage,\n  AlumniPage,\n  SchoolsCollegesPage,\n  FactsFiguresPage,\n} from \"@/pages/ContentPages\";\nimport { ContactPage, SearchPage, PrivacyPage } from \"@/pages/MorePages\";\nimport { OfflinePage } from \"@/pages/OfflinePage\";\n\nconst offlinePaths = new Set([\"/_404.html\", \"/404\", \"/not-found\"]);\n\nfunction routeFor(path: string) {\n  if (offlinePaths.has(path)) return <OfflinePage />;\n  switch (path) {\n    case \"/\":\n      return <HomePage />;\n    case \"/about\":\n      return <AboutPage />;\n    case \"/academics\":\n      return <AcademicsPage />;\n    case \"/life-at-michigan\":\n      return <LifePage />;\n    case \"/athletics\":\n      return <AthleticsPage />;\n    case \"/research\":\n      return <ResearchPage />;\n    case \"/health-medicine\":\n      return <H