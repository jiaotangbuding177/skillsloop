{
  "task_id": "minipaint.training",
  "version": "rw_evolution_collection_v1",
  "domain": "minipaint.training",
  "input": {
    "site_url": "runtime-provided",
    "template": "react-vite"
  },
  "constraints": {
    "target_pages": [
      "homepage"
    ],
    "max_pages": 1,
    "required_features": [
      "interactive_drawing",
      "editor_menus",
      "document_export"
    ],
    "delivery_format": {
      "framework": "react",
      "build_tool": "vite",
      "entry_point": "src/App.tsx",
      "build_command": "npm run build",
      "output_dir": "dist/"
    }
  },
  "time_limit_seconds": 7200
}