186]\n        - generic [ref=f34e187]:\n          - generic [ref=f34e188]:\n            - generic [ref=f34e189]:\n              - img \"Block C\" [ref=f34e191]\n              - img \"24 Hours\" [ref=f34e193]\n            - generic [ref=f34e194]:\n              - heading \"All Corravale, all day long\" [level=3] [ref=f34e195]\n              - paragraph [ref=f34e196]: There's always something remarkable unfolding at Corravale. Whether it happens on campus or across the globe, our students, faculty, staff and alumni are busy making the most of each day. A selection of photos gathered over the years appears in the gallery below.\n          - list [ref=f34e197]:\n            - listitem [ref=f34e198] [cursor=pointer]:\n              - img \"Rare books are researched and restored at the Hartley Library.\" [ref=f34e199]\n              - generic [ref=f34e200]: 8:35 am\n            - listitem [ref=f34e201] [cursor=pointer]:\n              - img \"A rare book collection at the Hartley Library.\" [ref=f34e202]\n              - generic [ref=f34e203]: 8:42 am\n            - listitem [ref=f34e204] [cursor=pointer]:\n              - img \"The Aldous P. Vantry Reserve provides research and education opportunities in the natural sciences.\" [ref=f34e205]\n              - generic [ref=f34e206]: 8:32 am\n            - listitem [ref=f34e207] [cursor=pointer]:\n              - img \"A researcher working in the Harlan and Rose Delmont Cardiovascular Center.\" [ref=f34e208]\n              - generic [ref=f34e209]: 8:11 am\n            - listitem [ref=f34e210] [cursor=pointer]:\n              - img \"A view into a snowy Law Quad from under the archway.\" [ref=f34e211]\n              - generic [ref=f34e212]: 8:49 am\n            - listitem [ref=f34e213] [cursor=pointer]:\n              - img \"A new graduate belts into a microphone during a student a cappella set in front of the stage at the 2024 Spring Commencement ceremony.\" [ref=f34e214]\n              - generic [ref=f34e215]: 8:57 am\n            - listitem [ref=f34e216] [cursor=pointer]:\n              - img \"A graduate in a cap decorated with a Block C made of sequins and crimson and gold gemstones waves to someone across the crowd outside Corravale Stadium.\" [ref=f34e217]\n              - generic [ref=f34e218]: 8:02 am\n            - listitem [ref=f34e219] [cursor=pointer]:\n              - img \"A long exposure shot of students walking past the Homeward Bound sculpture on an early Fall day with the North Campus Building, Whitmore Hall, and the Ellsworth Building in the background.\" [ref=f34e220]\n              - generic [ref=f34e221]: 8:44 am\n            - listitem [ref=f34e222] [cursor=pointer]:\n              - img \"A group of four students wearing backpacks and each wearing tee shirts walks out of the tunnel running through Weston Hall toward the Green. The building’s tall red brick exterior and ornamental spires loom tall above the students in the background. Small trees grow in gardens on either side of the tunnel entrance.\" [ref=f34e223]\n              - generic [ref=f34e224]: 8:46 am\n            - listitem [ref=f34e225] [cursor=pointer]:\n              - img \"A machinist working in the CAS Scientific Instrument Shop.\" [ref=f34e226]\n              - generic [ref=f34e227]: 8:31 am\n            - listitem [ref=f34e228] [cursor=pointer]:\n              - img \"A research technician working in a Harlan and Rose Delmont Cardiovascular Center lab.\" [ref=f34e229]\n              - generic [ref=f34e230]: 9:16 am\n            - listitem [ref=f34e231] [cursor=pointer]:\n              - img \"Student musicians drum on five gallon buckets as part of the pre-show entertainment at Spring Commencement.\" [ref=f34e232]\n              - generic [ref=f34e233]: 9:25 am\n            - listitem [ref=f34e234] [cursor=pointer]:\n              - img \"Students walk to class on the sidewalks in the Green, surrounded by trees covered in orange and yellow fall leaves. One of the faces of Barrett Memorial Tower is visible through a gap in the trees, framed perfectly by the fall colors.\" [ref=f34e235]\n              - generic [ref=f34e236]: 9:16 am\n            - listitem [ref=f34e237] [cursor=pointer]:\n              - img \"A student volunteer in a light blue shirt smiles for the camera and pushes a blue bin into Weston Quad during Move-In. They are followed by a line of people holding a variety of items and pulling roller bags.\" [ref=f34e238]\n              - generic [ref=f34e239]: 9:13 am\n            - listitem [ref=f34e240] [cursor=pointer]:\n              - img \"A graduate student gives a presentation beneath the dome of the Corravale Planetarium theater\" [ref=f34e241]\n              - generic [ref=f34e242]: 10:46 am\n            - listitem [ref=f34e243] [cursor=pointer]:\n              - img \"The Genome Sequencing Core delivers DNA analysis to Corravale scholars.\" [ref=f34e244]\n              - generic [ref=f34e245]: 10:28 am\n            - listitem [ref=f34e246] [cursor=pointer]:\n              - img \"A student in a gray Corravale hoodie with earbuds in works on their laptop before tall windows overlooking the limestone spires of Merrow Hall from inside the Alden Undergraduate Library.\" [ref=f34e247]\n              - generic [ref=f34e248]: 10:43 am\n    - contentinfo [ref=f34e249]:\n      - generic [ref=f34e250]:\n        - generic [ref=f34e251]:\n          - heading [level=1] [ref=f34e252]:\n            - link \"Corravale University\" [ref=f34e253] [cursor=pointer]:\n              - /url: /\n          - navigation \"Our Campuses\" [ref=f34e254]:\n            - list [ref=f34e255]:\n              - listitem [ref=f34e256]:\n                - link \"Fairhaven\" [ref=f34e257] [cursor=pointer]:\n                  - /url: /\n              - listitem [ref=f34e258]:\n                - link \"Westgate\" [ref=f34e259] [cursor=pointer]:\n                  - /url: /_404.html\n              - listitem [ref=f34e260]:\n                - link \"Alden\" [ref=f34e261] [