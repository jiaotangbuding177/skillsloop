}\n\nexport function SidebarPage({\n  title,\n  intro,\n  groups,\n  sidebarImage,\n  sidebarCaption,\n}: {\n  title: string;\n  intro: string;\n  groups: SidebarGroup[];\n  sidebarImage?: string;\n  sidebarCaption?: string;\n}) {\n  return (\n    <>\n      <PageTitle>{title}</PageTitle>\n      <section className=\"bg-[#333] py-8\">\n        <div className=\"mx-auto max-w-[1180px] px-5\">\n          <p className=\"mx-auto mb-8 max-w-[900px] text-center text-[15px] leading-relaxed text-white/85\">\n            {intro}\n          </p>\n          <div className=\"grid gap-6 lg:grid-cols-[1fr_300px]\">\n            <div className=\"grid gap-4 sm:grid-cols-2 xl:grid-cols-3\">\n              {groups.map((g) => (\n                <LinkPanel key={g.heading} group={g} />\n              ))}\n            </div>\n            {sidebarImage && (\n              <figure className=\"self-start\">\n                <img\n                  src={sidebarImage}\n                  alt={sidebarCaption ?? \"\"}\n                  className=\"w-full object-cover\"\n                  loading=\"lazy\"\n                />\n                {sidebarCaption && (\n                  <figcaption className=\"mt-2 text-[13px] leading-snug text-maize/90\">\n                    {sidebarCaption}\n                  </figcaption>\n                )}\n              </figure>\n            )}\n          </div>\n        </div>\n      </section>\n    </>\n  );\n}\n\nexport function Voices({\n  label,\n  image,\n  caption,\n}: {\n  label: string;\n  image: string;\n  caption: string;\n}) {\n  return (\n    <section aria-label={label} className=\"relative\">\n      <img src={image} alt={caption} className=\"h-[420px] w-full object-cover md:h-[540px]\" />\n      <div className=\"absolute bottom-8 left-1/2 w-[min(92%,680px)] -translate-x-1/2 bg-[#1c1c1c]/80 px-5 py-4 md:left-16 md:translate-x-0\">\n        <p className=\"flex items-start gap-3 text-[13px] leading-snug text-white/85\">\n          <span className=\"mt-[3px] text-maize\">\n            <ChevronRight size={12} />\n          </span>\n          {caption}\n        </p>\n      </div>\n    </section>\n  );\n}\n\nexport function ProsePage({\n  title,\n  children,\n}: {\n  title: string;\n  children: ReactNode;\n}) {\n  return (\n    <>\n      <PageTitle>{title}</PageTitle>\n      <section className=\"bg-[#f4f4f4] py-10\">\n        <div className=\"prose-page mx-auto max-w-[820px] px-5 text-[14px] leading-relaxed text-[#333]\">\n          {children}\n        </div>\n      </section>\n    </>\n  );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":773667,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f0c9ab75-decc-42ca-abdc-7dfb67bdae3a","uuid":"9aeca793-af58-4afa-8077-7b32cf28cace"}
