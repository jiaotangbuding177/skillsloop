itiativesPage />;\n    case \"/giving\":\n      return <GivingPage />;\n    case \"/prospective-students\":\n      return <ProspectivePage />;\n    case \"/current-students\":\n      return <CurrentStudentsPage />;\n    case \"/faculty-staff\":\n      return <FacultyStaffPage />;\n    case \"/parents\":\n      return <ParentsPage />;\n    case \"/alumni\":\n      return <AlumniPage />;\n    case \"/schools-colleges\":\n      return <SchoolsCollegesPage />;\n    case \"/facts-figures\":\n      return <FactsFiguresPage />;\n    case \"/contact\":\n      return <ContactPage />;\n    case \"/search\":\n      return <SearchPage />;\n    case \"/about/privacy\":\n      return <PrivacyPage />;\n    default:\n      return <HomePage />;\n  }\n}\n\nfunction Shell() {\n  const { path } = useRouter();\n  return (\n    <div className=\"flex min-h-screen flex-col\">\n      <a href=\"#content\" className=\"sr-only focus:not-sr-only\">\n        Skip to main content\n      </a>\n      <Header path={path} />\n      <main id=\"content\" className=\"flex-1\">\n        {routeFor(path)}\n      </main>\n      <Footer />\n    </div>\n  );\n}\n\nexport function App() {\n  return (\n    <RouterProvider>\n      <Shell />\n    </RouterProvider>\n  );\n}\n","structuredPatch":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":4,"lines":["+import { useEffect } from \"react\";"," import { RouterProvider, useRouter } from \"@/lib/router\";"," import { Header } from \"@/components/Header\";"," import { Footer } from \"@/components/Footer\";"]}],"userModified":false,"replaceAll":false}}
