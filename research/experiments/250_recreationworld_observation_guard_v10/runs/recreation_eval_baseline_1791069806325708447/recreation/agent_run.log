item [ref=f30e315] [cursor=pointer]:\n              - img \"A student worker readies the register for a new day at the Corravale Union.\" [ref=f30e316]\n              - generic [ref=f30e317]: 7:09 am\n            - listitem [ref=f30e318] [cursor=pointer]:\n              - img \"A machinist working in the Corravale Scientific Instrument Shop.\" [ref=f30e319]\n              - generic [ref=f30e320]: 8:05 am\n            - listitem [ref=f30e321] [cursor=pointer]:\n              - img \"A research technician working in a laboratory at the Whitfield Cardiovascular Center.\" [ref=f30e322]\n              - generic [ref=f30e323]: 8:48 am\n            - listitem [ref=f30e324] [cursor=pointer]:\n              - img \"Student musicians pound out rhythms on five gallon buckets during the pre-show entertainment at Spring Commencement.\" [ref=f30e325]\n              - generic [ref=f30e326]: 9:11 am\n            - listitem [ref=f30e327] [cursor=pointer]:\n              - img \"ROTC cadets work together to hold and unfold a large national flag outside the Chemistry building near the central green flagpole during the annual Veterans Day flag-raising ceremony. In the background, cadets from the various ROTC programs stand at attention.\" [ref=f30e328]\n              - generic [ref=f30e329]: 9:37 am\n            - listitem [ref=f30e330] [cursor=pointer]:\n              - img \"Medical students and residents speak with a patient and her mother during morning rounds at the Cranmore Children's Hospital.\" [ref=f30e331]\n              - generic [ref=f30e332]: 9:53 am\n            - listitem [ref=f30e333] [cursor=pointer]:\n              - img \"A group of seven students in Corravale gear smile and pose for a photo taken by a parent in a blue tee shirt at the Parents and Family Weekend Tailgate event in the Calder Field House.\" [ref=f30e334]\n              - generic [ref=f30e335]: 9:20 am\n            - listitem [ref=f30e336] [cursor=pointer]:\n              - img \"A research scientist at the Corravale Herbarium sorts seeds from plant specimens collected in the field.\" [ref=f30e337]\n              - generic [ref=f30e338]: 10:34 am\n            - listitem [ref=f30e339] [cursor=pointer]:\n              - img \"A Halverson Center audio resource manager works on three-dimensional sound for digital preservation, academic research and entertainment.\" [ref=f30e340]\n              - generic [ref=f30e341]: 10:07 am\n            - listitem [ref=f30e342] [cursor=pointer]:\n              - img \"A student in a gray hooded sweatshirt with headphones in works on their laptop in front of large windows looking out on the Hartwell Hall spires in the Ellison Undergraduate Library.\" [ref=f30e343]\n              - generic [ref=f30e344]: 10:29 am\n            - listitem [ref=f30e345] [cursor=pointer]:\n              - img \"A worker enters the campus Nanofabrication Facility on North Ridge.\" [ref=f30e346]\n              - generic [ref=f30e347]: 10:51 am\n            - listitem [ref=f30e348] [cursor=pointer]:\n              - img \"A toddler enjoys the playroom at the Cranmore Children's Hospital.\" [ref=f30e349]\n              - generic [ref=f30e350]: 10:45 am\n            - listitem [ref=f30e351] [cursor=pointer]:\n              - img \"A professor of applied physics, electrical engineering and computer science, holds a chariot posture in his office on North Ridge.\" [ref=f30e352]\n              - generic [ref=f30e353]: 10:26 am\n            - listitem [ref=f30e354] [cursor=pointer]:\n              - img \"A research scientist at the Corravale Herbarium.\" [ref=f30e355]\n              - generic [ref=f30e356]: 11:12 am\n    - contentinfo [ref=f30e357]:\n      - generic [ref=f30e358]:\n        - generic [ref=f30e359]:\n          - heading [level=1] [ref=f30e360]:\n            - link \"Corravale University\" [ref=f30e361] [cursor=pointer]:\n              - /url: /\n          - navigation \"Our Campuses\" [ref=f30e362]:\n            - list [ref=f30e363]:\n             