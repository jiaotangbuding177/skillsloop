\n    case \"/about/privacy\":\n      return <PrivacyPage />;\n    default:\n      return <HomePage />;\n  }\n}\n\nfunction Shell() {\n  const { path } = useRouter();\n  return (\n    <div className=\"flex min-h-screen flex-col\">\n      <a href=\"#content\" className=\"sr-only focus:not-sr-only\">\n        Skip to main content\n      </a>\n      <Header path={path} />\n      <main id=\"content\" className=\"flex-1\">\n        {routeFor(path)}\n      </main>\n      <Footer />\n    </div>\n  );\n}\n\nexport function App() {\n  return (\n    <RouterProvider>\n      <Shell />\n    </RouterProvider>\n  );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":774854,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f0c9ab75-decc-42ca-abdc-7dfb67bdae3a","uuid":"faca4c80-799f-4ff0-8a47-10de5f59f143"}
