 #sharing-our-stories{background-color:#ffffff;overflow: hidden;position: relative;}#sharing-our-stories .panel-header{padding-bottom:0;}#sharing-our-stories ul{margin:0;padding:0;list-style: none;}#sharing-our-stories ul li{}#sharing-our-stories img{position:absolute;height:100%;width:100%;object-fit:cover;}#sharing-our-stories .sharing-caption{position:absolute;bottom:6%;width:270px;padding:40px;background-color: rgba(51,51,51,0.85);color:#c1c1c1;border-radius:2px;}#sharing-our-stories .sharing-caption .fa{position:absolute;right:10px;top:10px;}#sharing-our-stories .sharing-caption p{font-family: 'Roboto',sans-serif;font-size:15px;line-height:22px;color:#c1c1c1;}#sharing-our-stories .sharing-caption h3{padding-bottom:20px;line-height:30px;}#sharing-our-stories .sharing-caption h4{padding:20px 0 0 0;}#sharing-our-stories .sharing-caption a{text-decoration: none;color:#a3c3ff;}#sharing-our-stories .sharing-caption a:hover{border-bottom:dotted 1px #a3c3ff;}#sharing-our-stories .sharing-caption h3 a{color:#ffcb0b;}#sharing-our-stories .sharing-caption h3 a:hover,#sharing-our-stories .sharing-caption h4 a:hover{border-bottom:dotted 1px #ffcb0b;}#sharing-our-stories .fa-arrow-circle-right{padding-left:8px;}#sharing-our-stories .sharing-caption h4 a{color:#ffffff;}#sharing-our-stories .sharing-caption a:hover{color:#ffcb0b;}@media only screen and (max-width:959px){#sharing-our-stories .image-wrapper{max-height:800px;}#sharing-our-stories .sharing-caption{margin:10px;}}@media only screen and (max-width:780px){#sharing-our-stories .image-wrapper{max-height:600px;}#sharing-our-stories .sharing-caption{width:auto;padding:20px;}}@media only screen and (max-width:480px){#sharing-our-stories .sharing-caption{padding:10px;}}
/* cleanroom fix: captured pages froze the expandable caption in a partially-collapsed
   state (inline bottom:-Npx) so only a clipped first line peeked above the overflow-hidden
   image, reading as truncated text. Force the caption fully visible on all panels. */
#sharing-our-stories .sharing-caption{bottom:24px !important;}