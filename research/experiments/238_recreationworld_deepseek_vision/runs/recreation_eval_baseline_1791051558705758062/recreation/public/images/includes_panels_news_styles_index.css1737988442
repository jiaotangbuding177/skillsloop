 #news .column{float: left;width:50%;padding:0 20px;}#news .column + .column{border-left:1px solid #555;}#news > .wrapper{padding-bottom:25px;}#news ul{margin:0;padding:0;list-style: none;}#news ul > li{padding:10px 0;font-family: 'Roboto',sans-serif;font-size:16px;line-height:22px;break-inside:avoid;}#news ul > li + li{border-top:1px dotted #8e8c8c;}#news ul > li a{color:#ffcb0b;text-decoration: none;display:block;}#news ul > li a:hover span{border-bottom:1px dotted #ffcb0b;}#news h3{font-size:24px;font-weight: normal;color:#72b4ff;padding-bottom:10px;letter-spacing:2px;text-transform: uppercase;}#news h4{padding:10px 0;font-size:15px;font-weight:bold;letter-spacing:1px;text-transform: uppercase;}#news h4 a{display: inline-block;color:#85beff;text-decoration: none;}#news h4 a span .fa{padding-left:10px;}#news h4 a:hover span{border-bottom:1px dotted #72b4ff;}#news #itn-items ul > li a span.outlet{display:block;color:#ddd;border: none;}@media only screen and (max-width:650px){#news .column{float: none;width:auto;margin:20px;padding:20px;background-color:#4a4a4a;border:1px solid #656565 !important;}#news .column + .column{width:auto;}#news #news-items ul{columns:1;}}