ge: U+370-3FF; font-display: swap; }\n@font-face { font-family: \"Roboto Slab\"; font-style: normal; font-weight: 300; src: url(\"/cf-fonts/s/roboto-slab/5.0.18/greek-ext/300/normal.woff2\"); unicode-range: U+1F00-1FFF; font-display: swap; }\n@font-face { font-family: \"Roboto Slab\"; font-style: normal; font-weight: 300; src: url(\"/cf-fonts/s/roboto-slab/5.0.18/latin/300/normal.woff2\"); unicode-range: U+0-FF, U+131, U+152-153, U+2BB-2BC, U+2C6, U+2DA, U+2DC, U+304, U+308, U+329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; font-display: swap; }\n@font-face { font-family: \"Roboto Slab\"; font-style: normal; font-weight: 300; src: url(\"/cf-fonts/s/roboto-slab/5.0.18/vietnamese/300/normal.woff2\"); unicode-range: U+102-103, U+110-111, U+128-129, U+168-169, U+1A0-1A1, U+1AF-1B0, U+300-301, U+303-304, U+308-309, U+323, U+329, U+1EA0-1EF9, U+20AB; font-display: swap; }\n@font-face { font-family: \"Roboto Slab\"; font-style: normal; font-weight: 300; src: url(\"/cf-fonts/s/roboto-slab/5.0.18/latin-ext/300/normal.woff2\"); unicode-range: U+100-2AF, U+304, U+308, U+329, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF; font-display: swap; }</style><style>*,*::before,*::after{animation-duration:0s!important;animation-delay:0s!important;transition-duration:0s!important;transition-delay:0s!important;scroll-behavior:auto!important;caret-color:transparent!important}</style><style id=\"cleanroom-hp-fix\">\n#features{height:1180px!important;overflow:hidden!important;background:#00274c!important}\n#large-features{height:1180px!important;overflow:hidden!important}\n#large-features>ul{left:0!important;width:100%!important;position:relative!important;display:block!important}\n#large-features>ul>li{display:none!important;float:none!important;width:100%!important;height:1180px!important;max-height:1180px!important}\n#large-features>ul>li:nth-child(2){display:block!important}\n#large-features .background-image{margin-top:0!important;height:1180px!important}\n#large-features .nav{display:none!important}\n#features .wrapper.background-blue{background:transparent!important;position:relative!important;z-index:30!important}\n#features #infographics{display:block!important;position:relative!important;z-index:30!important;margin:-235px auto 45px!important;text-align:center!important;width:100%!important;padding:0!important;list-style:none!important}\n#features #infographics>li{display:inline-block!important;margin:0 10px!important;vertical-align:top!important}\n#features #infographics>li>a{background-image:none!important;background-color:rgba(7,50,98,.94)!important;width:190px!important;height:150px!important;border-radius:6px!important;float:none!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:16px!important;box-sizing:border-box!important;box-shadow:0 4px 14px rgba(0,0,0,.35)!important}\n#features #infographics>li>a:hover{background-color:rgba(7,50,98,.94)!important}\n#features #infographics>li>a em{display:block!important;position:static!important;clip:auto!important;width:auto!important;height:auto!important;overflow:visible!important;color:#fff!important;font-family:'Roboto Condensed',sans-serif!important;font-size:16px!important;line-height:1.4!important;font-style:normal!important;text-align:center!important;letter-spacing:.5px!important}\n#features #infographics .infographic-one span,#features #infographics .drop-down{display:none!important}\n/* Defect: desktop 3-up video titles no longer clamped to baked 51px (3-line title was clipped behind thumbnail); align the three thumbnails via a shared min-height instead */\n@media only screen and (min-width:701px){#videos ul li h3{min-height:72px}}\n/* Round-4 defect: at desktop the NEWS dark section had only 25px bottom padding, so the last link 'Visit the Campus Chronicle' sat right at the NEWS->VIDEOS seam and the yellow VIDEOS band clipped its lower glyphs. Give the two-column news layout robust clearance below the columns so the seam is always clean. */\n@media only screen and (min-width:651px){#news > .wrapper{padding-bottom:48px!important}}\n</style><style id=\"cleanroom-hp-mobile-fix\">\n/* Mobile-only responsive repairs (desktop >=831px is untouched). */\n@media only screen and (max-width:830px){\n  /* Defect #3: hero+infographics natural height (kill 1180px blank band); stack all stat cards, no negative-margin overlap */\n  #features{height:auto!important;overflow:visible!important;background:#00274c!important}\n  #large-features{height:auto!important;overflow:hidden!important}\n  #large-features>ul{left:0!important;width:100%!important;position:relative!important;display:block!important}\n  #large-features>ul>li{display:none!important;float:none!important;width:100%!important;height:auto!important;min-height:0!important;max-height:none!important;overflow:hidden!important}\n  #large-features>ul>li:nth-child(2){display:block!important}\n  #large-features>ul .wrapper{position:relative!important;top:0!important;z-index:10!important}\n  #large-features .feature-copy,#large-features .feature-copy.left{float:none!important;width:auto!important;margin:0!important}\n  #large-features .background-image{position:relative!important;height:220px!important;margin-top:0!important;background-size:cover!important;background-position:center!important}\n  #features .wrapper.background-blue{background:#00274c!important;padding-bottom:1px!important}\n  #features #infographics{margin:0 auto!important;padding:24px 0 10px!important}\n  #features #infographics>li{display:block!important;margin:0 auto 14px!important}\n  #features #infographics>li>a{width:86%!important;max-width:300px!important;height:auto!important;min-height:92px!important;margin:0 auto!important;padding:16px!important}\n\n  /* Defect #1: news columns drop baked fixed height (content overflow/overlap) */\n  #news #news-items,#news #itn-items{height:auto!important}\n\n  /* Defect #2: video titles drop baked 51px clamp so 3rd line isn't hidden behind thumbnail */\n  #videos ul li h3{height:auto!important}\n  /* kill desktop inline-block -4px gap hack that overflows viewport when li is full-width */\n  #videos ul li{margin-right:0!important}\n}\n/* Defect #4: gallery grid fills width and centers (375px = grid-4-only regime) */\n@media only screen and (max-width:490px){\n  #gallery ul{display:flex!important;flex-wrap:wrap!important;justify-content:center!important;align-items:flex-start!important;width:auto!important;max-width:360px!important;margin:0 auto!important;padding:0!important}\n  #gallery ul li.grid-4{float:none!important;flex:0 0 30%!important;width:30%!important;height:104px!important;margin:4px 1.2%!important}\n  #gallery ul li.grid-4.unit8{flex:0 0 96%!important;width:96%!important;height:200px!important}\n}\n</style></head>\n<body data-token=\"_a3a46dd61afa737dc0182ca269cf72d8\">\n<a class=\"skip\" href=\"#content\">Skip to main content</a>\n<div id=\"wrapper\">\n<div class=\"clear\" id=\"header\" role=\"banner\">\n<div id=\"zone-branding\">\n<div class=\"wrapper\">\n<h1 class=\"logo\"><a href=\"/\">Corravale University</a></h1>\n</div>\n</div>\n<div id=\"zone-utility-bar\">\n<div class=\"wrapper\">\n<div class=\"sexual-misconduct\">\n<a href=\"/_404.html\">Report Sexual Misconduct, Discrimination, and Bias Concerns <i class=\"fa fa-arrow-circle-right\"></i></a>\n</div>\n<div class=\"search\">\n<form action=\"/search/\" class=\"wrapper\" method=\"get\" role=\"search\">\n<label for=\"keywords\">\n<span class=\"hidden\">Search for:</span>\n<input id=\"keywords\" name=\"keywords\" placeholder=\"Search\" title=\"Search for:\" type=\"search\"/>\n</label>\n<button type=\"submit\">\n<span class=\"hidden\">Search</span>\n<i aria-hidden=\"true\" class=\"fa fa-search\"></i>\n</button>\n</form>\n</div>\n</div>\n</div>\n<div id=\"zone-audience-quick-links\">\n<div class=\"wrapper\">\n<details id=\"quick-links\">\n<summary>Quick Links</summary>\n<nav aria-labelledby=\"quick-links-action-button\">\n<ul id=\"quick-links-content\">\n<li><a href=\"/_404.html\">Academic Calendar</a></li>\n<li><a href=\"/_404.html\">Courses</a></li>\n<li><a href=\"/_404.html\">Directory</a></li>\n<li><a href=\"/_404.html\">Email</a></li>\n<li><a href=\"/_404.html\">Health Email</a></li>\n<li><a href=\"/_404.html\">Library Catalog</a></li>\n<li><a href=\"/_404.html\">Maps &amp; Directions</a></li>\n<li><a href=\"/schools-colleges/\">Schools &amp; Colleges</a></li>\n<li><a href=\"/_404.html\">Corravale Access</a></li>\n</ul>\n</nav>\n</details>\n<div aria-label=\"Audiences\" class=\"clear\" id=\"audience-nav\" role=\"navigation\">\n<ul class=\"clear\">\n<li aria-hidden=\"true\">For:</li>\n<li><a href=\"/prospective-students/\">Prospective Students</a></li>\n<li><a href=\"/current-students/\">Current Students</a></li>\n<li><a href=\"/faculty-staff/\">Faculty &amp; Staff</a></li>\n<li><a href=\"/parents/\">Parents</a></li>\n<li><a href=\"/alumni/\">Alumni</a></li>\n</ul>\n</div>\n</div>\n</div>\n<div aria-labelledby=\"main-menu-header\" id=\"zone-main-nav\" role=\"navigation\">\n<div class=\"wrapper\">\n<div id=\"main-nav\">\n<a class=\"hamburger-header\" href=\"javascript:void(0);\">\n<h3 id=\"main-menu-header\">Main Menu</h3>\n</a>\n<ul aria-hidden=\"false\" class=\"clear\">\n<li><a aria-current=\"page\" href=\"/\"><i class=\"fa fa-home\"><span class=\"hidden\">Home</span></i></a></li>\n<li><a href=\"/about/\">About</a></li>\n<li><a href=\"/academics/\">Academics</a></li>\n<li><a href=\"/life-at-michigan/\">Life at Corravale</a></li>\n<li><a href=\"/athletics/\">Athletics</a></li>\n<li><a href=\"/research/\">Research</a></li>\n<li><a href=\"/health-medicine/\">Health &amp; Medicine</a></li>\n<li><a href=\"/initiatives/\">Initiatives</a></li>\n<li><a href=\"/giving/\">Giving</a></li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n<div id=\"content\" role=\"main\">\n<div class=\"clear\" id=\"features\">\n<div aria-labelledby=\"large-features-label\" id=\"large-features\" role=\"region\">\n<h2 class=\"hidden\" id=\"large-features-label\">Featured Stories</h2>\n<ul class=\"clear\" style=\"left: -100%; width: 600%;\"><li aria-hidden=\"true\" class=\"cloned\" style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n<div class=\"wrapper\">\n<div class=\"feature-copy left\">\n<h2>Ancient desert reptiles were built to survive drought</h2>\n<p>A Corravale study examining fossilized limb bones of ancient desert lizards has shown that these reptiles were evolving to endure extreme heat more than 5 million years before the region's modern arid climate settled across the continent.</p>\n<p><a href=\"/_404.html\"><span>Read more about this study</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n</div>\n</div>\n<div class=\"background-image cell\" style=\"background-image: url(/_images/8d42f4956c45449e.jpg);\"></div>\n</li>\n<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n<div class=\"wrapper\">\n<div class=\"feature-copy left\">\n<h2>Fighting infection and chronic pain with engineered cells</h2>\n<p>Engineered cells could enable targeted therapies for infection and chronic pain that don't rely on broad medications, which may trigger new side effects or dangerous immune system reactions in some patients.</p>\n<p><a href=\"/_404.html\"><span>Read more about this research</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n</div>\n</div>\n<div class=\"background-image cell\" style=\"background-image: url(/_images/b61e6a7c84cebdf5.jpg);\"></div>\n</li>\n<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n<div class=\"wrapper\">\n<div class=\"feature-copy right\">\n<h2>Rise Up, Corravale!</h2>\n<p>Congratulations to the Corravale Women's Soccer team on capturing the National Championship! Go Ridgebacks!</p>\n<p><a href=\"/_404.html\"><span>Learn more</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n</div>\n</div>\n<div class=\"background-image cell\" style=\"background-image: url(/_images/2571249505b54163.jpg);\"></div>\n</li>\n<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n<div class=\"wrapper\">\n<div class=\"feature-copy left\">\n<h2>Finding Rhythm in Stillness and Light</h2>\n<p>The Corravale Residential College inspires a new generation of artists to find motion in metal and to hear music where there is only silence.</p>\n<p><a href=\"/_404.html\"><span>View the story</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n</div>\n</div>\n<div class=\"background-image cell\" style=\"background-image: url(/_images/894a51cea9f9c6ec.jpg);\"></div>\n</li>\n<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n<div class=\"wrapper\">\n<div class=\"feature-copy left\">\n<h2>Ancient grassland runners were engineered for speed</h2>\n<p>A Corravale study examining the fossilized ankle bones of an ancient grazing mammal has revealed that the animal was already evolving toward greater speed more than 6 million years before its fastest known predator ever appeared on the open plains.</p>\n<p><a href=\"/_404.html\"><span>Read more about this study</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n</div>\n</div>\n<div class=\"background-image cell\" style=\"background-image: url(/_images/8d42f4956c45449e.jpg);\"></div>\n</li>\n<li aria-hidden=\"true\" class=\"cloned\" style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n<div class=\"wrapper\">\n<div class=\"feature-copy left\">\n<h2>Fighting inherited disease and tumors with nanoparticles</h2>\n<p>Nanoparticles could make gene therapies for tumors and inherited disorders possible without relying on modified viruses, which can trigger new cancers or severe immune reactions in a small number of patients.</p>\n<p><a href=\"/_404.html\"><span>Read more about this research</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n</div>\n</div>\n<div class=\"background-image cell\" style=\"background-image: url(/_images/b61e6a7c84cebdf5.jpg);\"></div>\n</li></ul>\n<div aria-hidden=\"true\" class=\"nav\" style=\"display: block;\">\n<ul class=\"wrapper\">\n<li class=\"prev\"><i class=\"fa fa-chevron-left\"></i></li>\n<li class=\"next\"><i class=\"fa fa-chevron-right\"></i></li>\n</ul>\n</div>\n</div>\n<div aria-label=\"Infographics &amp; Special Features\" class=\"wrapper background-blue\" role=\"region\">\n<ul id=\"infographics\">\n<li class=\"always-show\"><a class=\"infographic-one\" href=\"/schools-colleges/\"><em class=\"hidden\">18 schools and colleges — see the full list</em><span>see the full list<i class=\"fa fa-arrow-circle-right\"></i></span></a></li>\n<li><a class=\"infographic-two\" href=\"/_404.html\"><em class=\"hidden\">More than 260 degree programs</em></a></li>\n<li><a class=\"infographic-three\" href=\"/_404.html\"><em class=\"hidden\">Corravale Research: $1.94 billion in research spending (FY2024)</em></a></li>\n<li><a class=\"infographic-four\" href=\"/_404.html\"><em class=\"hidden\"> 95+ Top-Ranked Graduate Programs </em></a></li>\n</ul>\n</div>\n</div>\n<div aria-labelledby=\"news-label\" class=\"panel grey clear\" id=\"news\" role=\"region\">\n<div class=\"header\">\n<h2 id=\"news-label\">News</h2>\n</div>\n<div class=\"wrapper clear\">\n<div class=\"column\" data-row=\"1\" id=\"news-items\">\n<h3>News</h3>\n<ul>\n<li><a href=\"/_404.html\">\n<span>\n                                                Leadership transition update                    </span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span>\n                                                Sky survey completes planned 3D map of the cosmos, keeps exploring                    </span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span>\n                                                Corravale Minds podcast: Fake flavors and real cravings drive our addiction to processed foods                    </span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span>\n                                                Pregnancy-related deaths rose during the pandemic and remain high for many new mothers                    </span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span>\n                                                Regional identity is a personal choice, not always tied to family ancestry                    </span>\n</a></li>\n</ul>\n<h4><a href=\"/_404.html\"><span>Visit Corravale News<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n<h4><a href=\"/_404.html\"><span>Explore Key Issues<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n<h4><a href=\"/_404.html\"><span>Visit the Campus Chronicle<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n</div>\n<div class=\"column\" data-row=\"1\" id=\"itn-items\">\n<h3>In The News</h3>\n<ul>\n<li><a href=\"/_404.html\">\n<span class=\"outlet\">Northshore Public Radio</span>\n<span>As floodwaters rise, aging dams near failure: State needs $1B in repairs</span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span class=\"outlet\">Gaceta Sur (Spain)</span>\n<span>How a breakout artist redefined global fame</span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span class=\"outlet\">Riverside Post</span>\n<span>Commentary: Line-drying clothes and the math of small climate wins</span>\n</a></li>\n<li><a href=\"/_404.html\">\n<span class=\"outlet\">The Daily</span>\n<span>How one cereal maker shaped how the nation ate breakfast</span>\n</a></li>\n</ul>\n<h4><a href=\"/_404.html\"><span>See more In The News<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n</div>\n</div>\n</div>\n<div aria-labelledby=\"videos-label\" class=\"panel maize clear\" id=\"videos\" role=\"region\">\n<div class=\"header\">\n<h2 id=\"videos-label\">Videos</h2>\n</div>\n<div class=\"wrapper clear\">\n<ul>\n<li>\n<a data-vid=\"NNMfNBJ_vHk\" href=\"/_404.html\">\n<h3 data-row=\"1\">Meet the Incoming University President</h3>\n<div class=\"preview\">\n<img alt=\"A welcome message from President-elect Marion Halcombe.\" loading=\"eager\" src=\"/_images/1edd5970e96fbddd.jpg\" style=\"\"/>\n</div>\n</a>\n</li>\n<li>\n<a data-vid=\"0fiK6pISh4M\" href=\"/_404.html\">\n<h3 data-row=\"1\">Harnessing Innovation to Renew the American Dream: The Corravale Task Force</h3>\n<div class=\"preview\">\n<img alt=\"Watch all of the day’s interviews: \nhttps://www.youtube.com/playlist?list=PLR27KmVx-4pQ8sNfLdTbY9wZ2aHcEgJfM\n\nProsperity today feels concentrated in a handful of regions, leaving many people wondering whether the system still works for them. This conversation asks how universities and industry can join forces to confront that pressing challenge.\n\nCan universities help rebuild belief in shared opportunity? Not only by preparing tomorrow’s leaders, but by partnering with industry and generating the ideas, ventures, and sectors that fuel broad-based growth? We will work toward a fuller picture of how research universities can serve as engines of possibility, sending ripple effects across health, technology, and the economy, drawing on examples that show how a breakthrough in one community can leave a lasting mark across the region and around the world. Which models of private-sector collaboration are worth repeating? Where does this partnership most need reinforcement? Which support systems spark the strongest innovations and knit communities together? And how can bold, enterprising alliances help renew prosperity in places that are too often left behind?\n\nPanelists: Renata Alvarado, Co-Founder and Co-C.E.O. of Clearsight Optics; Marcus Delroy, Co-Founder of NetPioneer, Chairman and C.E.O. of Vantage; Owen Traeger, Founder, President and C.E.O. of Ironclad Gear; Priya Menon, Acting C.E.O. of Corravale Depot; Talia Okafor, Founder and C.E.O. of Lendwell\n\nModerator: Adrian Voss, President of Corravale University\n\nFilmed live at the 2025 Horizon Forum\" loading=\"eager\" src=\"/_images/4ae7aa5aaab80c54.jpg\" style=\"\"/>\n</div>\n</a>\n</li>\n<li>\n<a data-vid=\"LsQaE-DX7Rg\" href=\"/_404.html\">\n<h3 data-row=\"1\">Relocating the Historic Founders</h3>\n<div class=\"preview\">\n<img alt=\"With help from many partners, Corravale University slowly and carefully relocated a piece of history Nov. 22, 2025, adding a new chapter to the legacy of alumnus Anders Holmquist.\n\nRead more in The Campus Record: https://record.corravale.edu/articles/inch-by-inch-holmquist-house-moved-onto-campus/\" loading=\"eager\" src=\"/_images/ebf5ca139005cbae.jpg\" style=\"\"/>\n</div>\n</a>\n</li>\n</ul>\n<p class=\"more\"><a href=\"/_404.html\"><span>Watch More Clips <i aria-hidden=\"false\" class=\"fa fa-arrow-circle-right\"></i></span></a></p>\n</div>\n</div>\n<div aria-labelledby=\"events-label\" class=\"panel blue clear\" id=\"events\" role=\"region\">\n<div class=\"header\">\n<h2 id=\"events-label\">Happening @ Corravale</h2>\n</div>\n<div class=\"wrapper clear\">\n<div class=\"column\" id=\"events-list\">\n<h3>Events</h3>\n<ul>\n<li class=\"clear\">\n<div class=\"event-image\">\n<img alt=\"Image about The Corravale Model for Siting Renewable Energy: Policy, Implementation, and Impact\" loading=\"eager\" src=\"/_images/2eb6869096259dcd.jpg\" style=\"\"/>\n</div>\n<a href=\"/_404.html\">\n<span class=\"clear\">\n<span class=\"event-date\">March <span class=\"event-date-day\">17</span></span>\n<span class=\"title\">The Corravale Framework for Siting Renewable Energy: Policy, Practice, and Impact</span>\n<span class=\"subtitle block\">Arts and Architecture Hall</span>\n</span>\n</a>\n</li>\n<li class=\"\">\n<a href=\"/_404.html\">\n<span class=\"clear\">\n<span class=\"event-date\">Mar 12</span>\n<span class=\"title\">SNL: Saturday Night Laughs, a FREE Improv Comedy Show!</span>\n</span>\n</a>\n</li>\n<li class=\"\">\n<a href=\"/_404.html\">\n<span class=\"clear\">\n<span class=\"event-date\">Mar 14</span>\n<span class=\"title\">From Lecture Halls to Language Models: Placing GenAI in Learning</span>\n</span>\n</a>\n</li>\n<li class=\"\">\n<a href=\"/_404.html\">\n<span class=\"clear\">\n<span class=\"event-date\">Apr 17</span>\n<span class=\"title\">Corravale Careers: A Workshop Series for Life After Graduation</span>\n</span>\n</a>\n</li>\n<li class=\"\">\n<a href=\"/_404.html\">\n<span class=\"clear\">\n<span class=\"event-date\">Apr 17</span>\n<span class=\"title\">Green Market: Spring Seedling</span>\n</span>\n</a>\n</li>\n</ul>\n<h4><a href=\"/_404.html\"><span>See What's On @ Corravale<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n</div>\n<div class=\"column\" id=\"academic-calendar\">\n<div>\n<h3>Academic Calendar</h3>\n<ul>\n<li>\n<ul class=\"calendar-date block\">\n<li>Apr 21</li>\n</ul>\n<span>Classes end</span>\n</li>\n<li>\n<ul class=\"calendar-date block\">\n<li>Apr 22, 25-26</li>\n</ul>\n<span>Study days</span>\n</li>\n<li>\n<ul class=\"calendar-date block\">\n<li>Apr 23-30</li>\n</ul>\n<span>Examinations</span>\n</li>\n<li>\n<ul class=\"calendar-date block\">\n<li>May 1-3</li>\n</ul>\n<span>Commencement Activities</span>\n</li>\n</ul>\n<h4><a href=\"/_404.html\"><span>See the Full Calendar<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n</div>\n</div>\n</div>\n</div>\n<div aria-labelledby=\"gallery-label\" class=\"panel white active\" id=\"gallery\" role=\"region\">\n<div class=\"header\">\n<h2 id=\"gallery-label\">Seize Today</h2>\n</div>\n<div class=\"wrapper\">\n<div class=\"clear\" id=\"michigan-time\">\n<div class=\"pusedo-list-item images\">\n<div class=\"border\">\n<img alt=\"Block C\" loading=\"eager\" src=\"/includes/panels/gallery/images/block-m-maize.png\" style=\"\"/>\n</div>\n<div class=\"border\">\n<img alt=\"24 Hours\" loading=\"eager\" src=\"/includes/panels/gallery/images/24-hours.png\" style=\"\"/>\n</div>\n</div>\n<div class=\"pusedo-list-item copy\">\n<h3>All Corravale, all the time</h3>\n<p>There's always something remarkable unfolding at Corravale. Whether it's here on campus or somewhere across the globe, our students, faculty, staff and alumni are out seizing the moment. A selection of images gathered over the years is featured in the gallery below.</p>\n</div>\n</div>\n<ul class=\"clear\">\n<li class=\"grid-4 unit8\" style=\"cursor: pointer; float: right; margin: 4px;\">\n<img alt=\"Rare books are researched and restored at the Aldwin Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/fce6e09caf7dc0ec.jpg\" style=\"\"/>\n<span class=\"time\">8:35 am</span>\n</li>\n<li class=\"grid-4\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A rare book collection at the Aldwin Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/45a75e75b4d19937.jpg\" style=\"\"/>\n<span class=\"time\">8:42 am</span>\n</li>\n<li class=\"grid-4\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"The Harlan T. Meade Reserve provides research and education opportunities in the natural sciences.\" data-credits=\"\" loading=\"eager\" src=\"/_images/a94f8862f8518063.jpg\" style=\"\"/>\n<span class=\"time\">8:32 am</span>\n</li>\n<li class=\"grid-4\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A researcher working in the Rowe and Delia Marsh Cardiovascular Center.\" data-credits=\"\" loading=\"eager\" src=\"/_images/bbb53e02d581e77d.jpg\" style=\"\"/>\n<span class=\"time\">8:11 am</span>\n</li>\n<li class=\"grid-9\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A snowy view of the Law Quad framed by the stone archway.\" data-credits=\"\" loading=\"eager\" src=\"/_images/1fd9c15a12cd459f.jpg\" style=\"\"/>\n<span class=\"time\">8:49 am</span>\n</li>\n<li class=\"grid-9 unit4\" style=\"cursor: pointer; float: right; margin: 4px;\">\n<img alt=\"A graduate leans into a microphone during a student a cappella set on the lawn before the main stage at the 2024 Spring Commencement ceremony.\" data-credits=\"\" loading=\"eager\" src=\"/_images/c32660a5f9b9de25.jpg\" style=\"\"/>\n<span class=\"time\">8:57 am</span>\n</li>\n<li class=\"grid-9 unit4\" style=\"cursor: pointer; float: right; margin: 4px;\">\n<img alt=\"A graduate in a cap decorated with a Block C made of sequins and gold and slate gemstones waves to someone across the crowd outside Corravale Stadium.\" data-credits=\"\" loading=\"eager\" src=\"/_images/32027c7f4e323658.jpg\" style=\"\"/>\n<span class=\"time\">8:02 am</span>\n</li>\n<li class=\"grid-9\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A long exposure shot of students strolling past the Homeward sculpture on an early Fall day with North Campus Hall, Alder Hall, and the Merrow Building rising in the background.\" data-credits=\"\" loading=\"eager\" src=\"/_images/07921e76b7569af8.jpg\" style=\"\"/>\n<span class=\"time\">8:44 am</span>\n</li>\n<li class=\"grid-9\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A group of four students wearing backpacks and each wearing matching tee shirts steps out of the tunnel running through West Hall toward the Green. The building’s tall red brick exterior and ornamental spires loom high above the students in the background. Small trees grow in planted beds on either side of the tunnel entrance.\" data-credits=\"\" loading=\"eager\" src=\"/_images/e6548a7da1e002fc.jpg\" style=\"\"/>\n<span class=\"time\">8:46 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A machinist at work in the College Scientific Instrument Shop.\" data-credits=\"\" loading=\"eager\" src=\"/_images/daba8bbd39dfbe1a.jpg\" style=\"\"/>\n<span class=\"time\">8:31 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A student in a gray sweatshirt writes in a notebook with a yellow pencil at a long table in the Reference Room of the Ashwood Graduate Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/a76adadafe4a040e.jpg\" style=\"\"/>\n<span class=\"time\">9:10 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"ROTC cadets work together to hold and unfold a large American flag outside of the Chemistry building near the Green flag pole during an annual Veterans Day flag raising ceremony. In the background, cadets from the various ROTC programs stand at attention.\" data-credits=\"\" loading=\"eager\" src=\"/_images/044d154eb1914a4a.jpg\" style=\"\"/>\n<span class=\"time\">9:02 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"Students put on face masks for a flu prevention study.\" data-credits=\"\" loading=\"eager\" src=\"/_images/6af4de40ef359f0b.jpg\" style=\"\"/>\n<span class=\"time\">10:15 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A local artist uses oil pastels to capture the peonies at peak bloom in the R.H. Calder Garden at Brightwood Arboretum.\" data-credits=\"\" loading=\"eager\" src=\"/_images/87615bec46077916.jpg\" style=\"\"/>\n<span class=\"time\">10:00 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A professor of applied optics, electrical engineering and computer science holds a chariot posture in his office on the North Ridge campus.\" data-credits=\"\" loading=\"eager\" src=\"/_images/51f64b7f00b7c5b0.jpg\" style=\"\"/>\n<span class=\"time\">10:10 am</span>\n</li>\n<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"A commuter shields herself from the light drizzle while waiting for her\" data-credits=\"\" loading=\"eager\" src=\"/_images/983ddfed9ee4bdd4.jpg\" style=\"\"/>\n<span class=\"time\">10:12 am</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px;\">\n<img alt=\"Corravale scientists have earned a $2 million federal grant to discover and evaluate strains of green algae capable of powering a high-yield, environmentally responsible and affordable process for producing biofuels.\" data-credits=\"\" loading=\"eager\" src=\"/_images/8e50c95652e1b194.jpg\" style=\"\"/>\n<span class=\"time\">11:48 am</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A student tests a prosthetic foot in the Applied Biomechanics and Control Lab.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">12:16 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A student tests a prosthetic foot in the Applied Biomechanics and Control Lab\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">12:34 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A small group of students sit in the grass on the Central Green as others walk along the pathway behind them. In the background, a gold “Welcome to Corravale” banner hangs on stone pillars above a flower garden.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">12:40 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"Two students study on their laptops in the Hartwell Undergraduate Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">12:35 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"Students on the sidewalk beneath the Central Campus Transit Center awning hurry to board a sleek electric blue bus bound for Hollisworth Commons. The arrival boards hanging above the crowd of students on the sidewalk display the route schedule.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">1:42 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A student reads a book while lying in the grass near the Cube sculpture in Founders Plaza on a warm summer afternoon.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">1:39 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A Campus Farm worker in a yellow shirt reading “Grow Together” leads a group of HarvestFest attendees on a tour of the Campus Farm. The group stands before a field filled with large leafy green vegetables. In the distance the Straw Bale House, white vendor tents, and the greenhouses dot the horizon.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">1:42 pm</span>\n</li>\n<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A staff member inspects the pneumatic tubes that carry patient-related messages in a mechanical room at the Corravale Health System.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">1:04 pm</span>\n</li>\n<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A student walks along Meridian Street in front of the eight Doric columns that frame the entrance to Halloran Hall.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">2:18 pm</span>\n</li>\n<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"A staff member hands a blue shirt reading “Corravale Pride” to a student in a brown tee shirt, tan hat, and black backpack at Pride Outside 2024.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">1:15 pm</span>\n</li>\n<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"The Movement Science 210 class fits a student into a motion detection sensor suit for a study on how knee injuries restrict motion.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">1:47 pm</span>\n</li>\n<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"Students play a game of four square on the main lawn.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">2:08 pm</span>\n</li>\n<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n<img alt=\"Members of the women's rowing team work out in the team room at the Campus Sports Building.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n<span class=\"time\">2:52 pm</span>\n</li>\n</ul>\n</div>\n</div>\n</div>\n<div class=\"clear\" id=\"footer\" role=\"contentinfo\">\n<div class=\"wrapper clear\">\n<div class=\"column info\">\n<h1 class=\"logo\"><a href=\"/\">Corravale University</a></h1>\n<nav aria-label=\"Our Campuses\">\n<ul class=\"campuses\">\n<li><a href=\"/\"><span>Fairhaven</span></a></li>\n<li><a href=\"/_404.html\"><span>Westgate</span></a></li>\n<li><a href=\"/_404.html\"><span>Alden</span></a></li>\n</ul>\n</nav>\n<ul class=\"contact\">\n<li>© 2026 <a href=\"/_404.html\"><span>The Board of Regents of Corravale University</span></a> 1240 Larkspur Ave., Fairhaven, MI 48211-1044</li>\n<li><a href=\"/about/privacy/\"><span><i aria-hidden=\"true\" class=\"fa fa-lock\"></i>Privacy Notice</span></a></li>\n<li class=\"phone\"><i class=\"fa fa-phone\"><span class=\"hidden\">Phone</span></i><a href=\"tel:+1-734-764-1817\">+1 (734) 764-1817</a></li>\n<li><a href=\"/contact/\"><span><i aria-hidden=\"true\" class=\"fa fa-envelope\"></i>Contact us</span></a></li>\n</ul>\n</div>\n<div class=\"column language-social\">\n<nav aria-label=\"Careers and Region Specific Websites\">\n<ul class=\"careers-languages clear\">\n<li><a href=\"/_404.html\"><span>Careers</span></a></li>\n</ul>\n</nav>\n<nav aria-label=\"Social Feeds\">\n<ul class=\"social-icons clear\">\n<li><a href=\"/_404.html\" title=\"Streamly\"><i class=\"fab fa-facebook-f\"><span class=\"hidden\">Streamly</span></i></a></li>\n<li><a href=\"/_404.html\" title=\"Z\"><i class=\"fa-brands fa-x-twitter\"><span class=\"hidden\">Z</span></i></a></li>\n<li><a href=\"/_404.html\" title=\"Skylark\"><i class=\"fa-brands fa-bluesky\"><span class=\"hidden\">Skylark</span></i></a></li>\n<li><a href=\"/_404.html\" title=\"Vidcast\"><i class=\"fab fa-youtube\"><span class=\"hidden\">Vidcast</span></i></a></li>\n<li><a href=\"/_404.html\" title=\"Photogram\"><i class=\"fab fa-instagram\"><span class=\"hidden\">Photogram</span></i></a></li>\n<li><a href=\"/_404.html\" title=\"Loopit\"><i class=\"fa-brands fa-tiktok\"></i><em class=\"hidden\">Loopit</em></a></li>\n<li><a href=\"/_404.html\" title=\"Careerly\"><i class=\"fab fa-linkedin-in\"><span class=\"hidden\">Careerly</span></i></a></li>\n</ul>\n</nav>\n</div>\n<div class=\"column mandatory\">\n<nav aria-label=\"Regulatory Compliance Requirements\">\n<ul class=\"clear\">\n<li><a href=\"/_404.html\" title=\"Budget and Financial Transparency Disclosures\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 150 150\" width=\"150\" height=\"150\" style=\"max-width:150px;height:auto;vertical-align:middle\" role=\"img\" aria-label=\"Budget and Financial Transparency Disclosures\"><title>Budget and Financial Transparency Disclosures</title><circle cx=\"75\" cy=\"75\" r=\"70\" fill=\"#2b8de0\" stroke=\"#f2a900\" stroke-width=\"6\"/><text x=\"75\" y=\"45\" text-anchor=\"middle\" font-family=\"Arial, Helvetica, s