{display:block!important;position:static!important;clip:auto!important;width:auto!important;height:auto!important;overflow:visible!important;color:#fff!important;font-family:'Roboto Condensed',sans-serif!important;font-size:16px!important;line-height:1.4!important;font-style:normal!important;text-align:center!important;letter-spacing:.5px!important}\n105\t#features #infographics .infographic-one span,#features #infographics .drop-down{display:none!important}\n106\t/* Defect: desktop 3-up video titles no longer clamped to baked 51px (3-line title was clipped behind thumbnail); align the three thumbnails via a shared min-height instead */\n107\t@media only screen and (min-width:701px){#videos ul li h3{min-height:72px}}\n108\t/* Round-4 defect: at desktop the NEWS dark section had only 25px bottom padding, so the last link 'Visit the Campus Chronicle' sat right at the NEWS->VIDEOS seam and the yellow VIDEOS band clipped its lower glyphs. Give the two-column news layout robust clearance below the columns so the seam is always clean. */\n109\t@media only screen and (min-width:651px){#news > .wrapper{padding-bottom:48px!important}}\n110\t</style><style id=\"cleanroom-hp-mobile-fix\">\n111\t/* Mobile-only responsive repairs (desktop >=831px is untouched). */\n112\t@media only screen and (max-width:830px){\n113\t  /* Defect #3: hero+infographics natural height (kill 1180px blank band); stack all stat cards, no negative-margin overlap */\n114\t  #features{height:auto!important;overflow:visible!important;background:#00274c!important}\n115\t  #large-features{height:auto!important;overflow:hidden!important}\n116\t  #large-features>ul{left:0!important;width:100%!important;position:relative!important;display:block!important}\n117\t  #large-features>ul>li{display:none!important;float:none!important;width:100%!important;height:auto!important;min-height:0!important;max-height:none!important;overflow:hidden!important}\n118\t  #large-features>ul>li:nth-child(2){display:block!important}\n119\t  #large-features>ul .wrapper{position:relative!important;top:0!important;z-index:10!important}\n120\t  #large-features .feature-copy,#large-features .feature-copy.left{float:none!important;width:auto!important;margin:0!important}\n121\t  #large-features .background-image{position:relative!important;height:220px!important;margin-top:0!important;background-size:cover!important;background-position:center!important}\n122\t  #features .wrapper.background-blue{background:#00274c!important;padding-bottom:1px!important}\n123\t  #features #infographics{margin:0 auto!important;padding:24px 0 10px!important}\n124\t  #features #infographics>li{display:block!important;margin:0 auto 14px!important}\n125\t  #features #infographics>li>a{width:86%!important;max-width:300px!important;height:auto!important;min-height:92px!important;margin:0 auto!important;padding:16px!important}\n126\t\n127\t  /* Defect #1: news columns drop baked fixed height (content overflow/overlap) */\n128\t  #news #news-items,#news #itn-items{height:auto!important}\n129\t\n130\t  /* Defect #2: video titles drop baked 51px clamp so 3rd line isn't hidden behind thumbnail */\n131\t  #videos ul li h3{height:auto!important}\n132\t  /* kill desktop inline-block -4px gap hack that overflows viewport when li is full-width */\n133\t  #videos ul li{margin-right:0!important}\n134\t}\n135\t/* Defect #4: gallery grid fills width and centers (375px = grid-4-only regime) */\n136\t@media only screen and (max-width:490px){\n137\t  #gallery ul{display:flex!important;flex-wrap:wrap!important;justify-content:center!important;align-items:flex-start!important;width:auto!important;max-width:360px!important;margin:0 auto!important;padding:0!important}\n138\t  #gallery ul li.grid-4{float:none!important;flex:0 0 30%!important;width:30%!important;height:104px!important;margin:4px 1.2%!important}\n139\t  #gallery ul li.grid-4.unit8{flex:0 0 96%!important;width:96%!important;height:200px!important}\n140\t}\n141\t</style></head>\n142\t<body data-token=\"_a3a46dd61afa737dc0182ca269cf72d8\">\n143\t<a class=\"skip\" href=\"#content\">Skip to main content</a>\n144\t<div id=\"wrapper\">\n145\t<div class=\"clear\" id=\"header\" role=\"banner\">\n146\t<div id=\"zone-branding\">\n147\t<div class=\"wrapper\">\n148\t<h1 class=\"logo\"><a href=\"/\">Corravale University</a></h1>\n149\t</div>\n150\t</div>\n151\t<div id=\"zone-utility-bar\">\n152\t<div class=\"wrapper\">\n153\t<div class=\"sexual-misconduct\">\n154\t<a href=\"/_404.html\">Report Sexual Misconduct, Discrimination, and Bias Concerns <i class=\"fa fa-arrow-circle-right\"></i></a>\n155\t</div>\n156\t<div class=\"search\">\n157\t<form action=\"/search/\" class=\"wrapper\" method=\"get\" role=\"search\">\n158\t<label for=\"keywords\">\n159\t<span class=\"hidden\">Search for:</span>\n160\t<input id=\"keywords\" name=\"keywords\" placeholder=\"Search\" title=\"Search for:\" type=\"search\"/>\n161\t</label>\n162\t<button type=\"submit\">\n163\t<span class=\"hidden\">Search</span>\n164\t<i aria-hidden=\"true\" class=\"fa fa-search\"></i>\n165\t</button>\n166\t</form>\n167\t</div>\n168\t</div>\n169\t</div>\n170\t<div id=\"zone-audience-quick-links\">\n171\t<div class=\"wrapper\">\n172\t<details id=\"quick-links\">\n173\t<summary>Quick Links</summary>\n174\t<nav aria-labelledby=\"quick-links-action-button\">\n175\t<ul id=\"quick-links-content\">\n176\t<li><a href=\"/_404.html\">Academic Calendar</a></li>\n177\t<li><a href=\"/_404.html\">Courses</a></li>\n178\t<li><a href=\"/_404.html\">Directory</a></li>\n179\t<li><a href=\"/_404.html\">Email</a></li>\n180\t<li><a href=\"/_404.html\">Health Email</a></li>\n181\t<li><a href=\"/_404.html\">Library Catalog</a></li>\n182\t<li><a href=\"/_404.html\">Maps &amp; Directions</a></li>\n183\t<li><a href=\"/schools-colleges/\">Schools &amp; Colleges</a></li>\n184\t<li><a href=\"/_404.html\">Corravale Access</a></li>\n185\t</ul>\n186\t</nav>\n187\t</details>\n188\t<div aria-label=\"Audiences\" class=\"clear\" id=\"audience-nav\" role=\"navigation\">\n189\t<ul class=\"clear\">\n190\t<li aria-hidden=\"true\">For:</li>\n191\t<li><a href=\"/prospective-students/\">Prospective Students</a></li>\n192\t<li><a href=\"/current-students/\">Current Students</a></li>\n193\t<li><a href=\"/faculty-staff/\">Faculty &amp; Staff</a></li>\n194\t<li><a href=\"/parents/\">Parents</a></li>\n195\t<li><a href=\"/alumni/\">Alumni</a></li>\n196\t</ul>\n197\t</div>\n198\t</div>\n199\t</div>\n200\t<div aria-labelledby=\"main-menu-header\" id=\"zone-main-nav\" role=\"navigation\">\n201\t<div class=\"wrapper\">\n202\t<div id=\"main-nav\">\n203\t<a class=\"hamburger-header\" href=\"javascript:void(0);\">\n204\t<h3 id=\"main-menu-header\">Main Menu</h3>\n205\t</a>\n206\t<ul aria-hidden=\"false\" class=\"clear\">\n207\t<li><a aria-current=\"page\" href=\"/\"><i class=\"fa fa-home\"><span class=\"hidden\">Home</span></i></a></li>\n208\t<li><a href=\"/about/\">About</a></li>\n209\t<li><a href=\"/academics/\">Academics</a></li>\n210\t<li><a href=\"/life-at-michigan/\">Life at Corravale</a></li>\n211\t<li><a href=\"/athletics/\">Athletics</a></li>\n212\t<li><a href=\"/research/\">Research</a></li>\n213\t<li><a href=\"/health-medicine/\">Health &amp; Medicine</a></li>\n214\t<li><a href=\"/initiatives/\">Initiatives</a></li>\n215\t<li><a href=\"/giving/\">Giving</a></li>\n216\t</ul>\n217\t</div>\n218\t</div>\n219\t</div>\n220\t</div>\n221\t<div id=\"content\" role=\"main\">\n222\t<div class=\"clear\" id=\"features\">\n223\t<div aria-labelledby=\"large-features-label\" id=\"large-features\" role=\"region\">\n224\t<h2 class=\"hidden\" id=\"large-features-label\">Featured Stories</h2>\n225\t<ul class=\"clear\" style=\"left: -100%; width: 600%;\"><li aria-hidden=\"true\" class=\"cloned\" style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n226\t<div class=\"wrapper\">\n227\t<div class=\"feature-copy left\">\n228\t<h2>Ancient desert reptiles were built to survive drought</h2>\n229\t<p>A Corravale study examining fossilized limb bones of ancient desert lizards has shown that these reptiles were evolving to endure extreme heat more than 5 million years before the region's modern arid climate settled across the continent.</p>\n230\t<p><a href=\"/_404.html\"><span>Read more about this study</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n231\t</div>\n232\t</div>\n233\t<div class=\"background-image cell\" style=\"background-image: url(/_images/8d42f4956c45449e.jpg);\"></div>\n234\t</li>\n235\t<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n236\t<div class=\"wrapper\">\n237\t<div class=\"feature-copy left\">\n238\t<h2>Fighting infection and chronic pain with engineered cells</h2>\n239\t<p>Engineered cells could enable targeted therapies for infection and chronic pain that don't rely on broad medications, which may trigger new side effects or dangerous immune system reactions in some patients.</p>\n240\t<p><a href=\"/_404.html\"><span>Read more about this research</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n241\t</div>\n242\t</div>\n243\t<div class=\"background-image cell\" style=\"background-image: url(/_images/b61e6a7c84cebdf5.jpg);\"></div>\n244\t</li>\n245\t<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n246\t<div class=\"wrapper\">\n247\t<div class=\"feature-copy right\">\n248\t<h2>Rise Up, Corravale!</h2>\n249\t<p>Congratulations to the Corravale Women's Soccer team on capturing the National Championship! Go Ridgebacks!</p>\n250\t<p><a href=\"/_404.html\"><span>Learn more</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n251\t</div>\n252\t</div>\n253\t<div class=\"background-image cell\" style=\"background-image: url(/_images/2571249505b54163.jpg);\"></div>\n254\t</li>\n255\t<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n256\t<div class=\"wrapper\">\n257\t<div class=\"feature-copy left\">\n258\t<h2>Finding Rhythm in Stillness and Light</h2>\n259\t<p>The Corravale Residential College inspires a new generation of artists to find motion in metal and to hear music where there is only silence.</p>\n260\t<p><a href=\"/_404.html\"><span>View the story</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n261\t</div>\n262\t</div>\n263\t<div class=\"background-image cell\" style=\"background-image: url(/_images/894a51cea9f9c6ec.jpg);\"></div>\n264\t</li>\n265\t<li style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n266\t<div class=\"wrapper\">\n267\t<div class=\"feature-copy left\">\n268\t<h2>Ancient grassland runners were engineered for speed</h2>\n269\t<p>A Corravale study examining the fossilized ankle bones of an ancient grazing mammal has revealed that the animal was already evolving toward greater speed more than 6 million years before its fastest known predator ever appeared on the open plains.</p>\n270\t<p><a href=\"/_404.html\"><span>Read more about this study</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n271\t</div>\n272\t</div>\n273\t<div class=\"background-image cell\" style=\"background-image: url(/_images/8d42f4956c45449e.jpg);\"></div>\n274\t</li>\n275\t<li aria-hidden=\"true\" class=\"cloned\" style=\"width: 1440px; display: block; min-height: 841px; max-height: 1600px; height: 1131px;\">\n276\t<div class=\"wrapper\">\n277\t<div class=\"feature-copy left\">\n278\t<h2>Fighting inherited disease and tumors with nanoparticles</h2>\n279\t<p>Nanoparticles could make gene therapies for tumors and inherited disorders possible without relying on modified viruses, which can trigger new cancers or severe immune reactions in a small number of patients.</p>\n280\t<p><a href=\"/_404.html\"><span>Read more about this research</span><i class=\"fa fa-arrow-circle-right\"></i></a></p>\n281\t</div>\n282\t</div>\n283\t<div class=\"background-image cell\" style=\"background-image: url(/_images/b61e6a7c84cebdf5.jpg);\"></div>\n284\t</li></ul>\n285\t<div aria-hidden=\"true\" class=\"nav\" style=\"display: block;\">\n286\t<ul class=\"wrapper\">\n287\t<li class=\"prev\"><i class=\"fa fa-chevron-left\"></i></li>\n288\t<li class=\"next\"><i class=\"fa fa-chevron-right\"></i></li>\n289\t</ul>\n290\t</div>\n291\t</div>\n292\t<div aria-label=\"Infographics &amp; Special Features\" class=\"wrapper background-blue\" role=\"region\">\n293\t<ul id=\"infographics\">\n294\t<li class=\"always-show\"><a class=\"infographic-one\" href=\"/schools-colleges/\"><em class=\"hidden\">18 schools and colleges — see the full list</em><span>see the full list<i class=\"fa fa-arrow-circle-right\"></i></span></a></li>\n295\t<li><a class=\"infographic-two\" href=\"/_404.html\"><em class=\"hidden\">More than 260 degree programs</em></a></li>\n296\t<li><a class=\"infographic-three\" href=\"/_404.html\"><em class=\"hidden\">Corravale Research: $1.94 billion in research spending (FY2024)</em></a></li>\n297\t<li><a class=\"infographic-four\" href=\"/_404.html\"><em class=\"hidden\"> 95+ Top-Ranked Graduate Programs </em></a></li>\n298\t</ul>\n299\t</div>\n300\t</div>\n301\t<div aria-labelledby=\"news-label\" class=\"panel grey clear\" id=\"news\" role=\"region\">\n302\t<div class=\"header\">\n303\t<h2 id=\"news-label\">News</h2>\n304\t</div>\n305\t<div class=\"wrapper clear\">\n306\t<div class=\"column\" data-row=\"1\" id=\"news-items\">\n307\t<h3>News</h3>\n308\t<ul>\n309\t<li><a href=\"/_404.html\">\n310\t<span>\n311\t                                                Leadership transition update                    </span>\n312\t</a></li>\n313\t<li><a href=\"/_404.html\">\n314\t<span>\n315\t                                                Sky survey completes planned 3D map of the cosmos, keeps exploring                    </span>\n316\t</a></li>\n317\t<li><a href=\"/_404.html\">\n318\t<span>\n319\t                                                Corravale Minds podcast: Fake flavors and real cravings drive our addiction to processed foods                    </span>\n320\t</a></li>\n321\t<li><a href=\"/_404.html\">\n322\t<span>\n323\t                                                Pregnancy-related deaths rose during the pandemic and remain high for many new mothers                    </span>\n324\t</a></li>\n325\t<li><a href=\"/_404.html\">\n326\t<span>\n327\t                                                Regional identity is a personal choice, not always tied to family ancestry                    </span>\n328\t</a></li>\n329\t</ul>\n330\t<h4><a href=\"/_404.html\"><span>Visit Corravale News<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n331\t<h4><a href=\"/_404.html\"><span>Explore Key Issues<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n332\t<h4><a href=\"/_404.html\"><span>Visit the Campus Chronicle<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n333\t</div>\n334\t<div class=\"column\" data-row=\"1\" id=\"itn-items\">\n335\t<h3>In The News</h3>\n336\t<ul>\n337\t<li><a href=\"/_404.html\">\n338\t<span class=\"outlet\">Northshore Public Radio</span>\n339\t<span>As floodwaters rise, aging dams near failure: State needs $1B in repairs</span>\n340\t</a></li>\n341\t<li><a href=\"/_404.html\">\n342\t<span class=\"outlet\">Gaceta Sur (Spain)</span>\n343\t<span>How a breakout artist redefined global fame</span>\n344\t</a></li>\n345\t<li><a href=\"/_404.html\">\n346\t<span class=\"outlet\">Riverside Post</span>\n347\t<span>Commentary: Line-drying clothes and the math of small climate wins</span>\n348\t</a></li>\n349\t<li><a href=\"/_404.html\">\n350\t<span class=\"outlet\">The Daily</span>\n351\t<span>How one cereal maker shaped how the nation ate breakfast</span>\n352\t</a></li>\n353\t</ul>\n354\t<h4><a href=\"/_404.html\"><span>See more In The News<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n355\t</div>\n356\t</div>\n357\t</div>\n358\t<div aria-labelledby=\"videos-label\" class=\"panel maize clear\" id=\"videos\" role=\"region\">\n359\t<div class=\"header\">\n360\t<h2 id=\"videos-label\">Videos</h2>\n361\t</div>\n362\t<div class=\"wrapper clear\">\n363\t<ul>\n364\t<li>\n365\t<a data-vid=\"NNMfNBJ_vHk\" href=\"/_404.html\">\n366\t<h3 data-row=\"1\">Meet the Incoming University President</h3>\n367\t<div class=\"preview\">\n368\t<img alt=\"A welcome message from President-elect Marion Halcombe.\" loading=\"eager\" src=\"/_images/1edd5970e96fbddd.jpg\" style=\"\"/>\n369\t</div>\n370\t</a>\n371\t</li>\n372\t<li>\n373\t<a data-vid=\"0fiK6pISh4M\" href=\"/_404.html\">\n374\t<h3 data-row=\"1\">Harnessing Innovation to Renew the American Dream: The Corravale Task Force</h3>\n375\t<div class=\"preview\">\n376\t<img alt=\"Watch all of the day’s interviews: \n377\thttps://www.youtube.com/playlist?list=PLR27KmVx-4pQ8sNfLdTbY9wZ2aHcEgJfM\n378\t\n379\tProsperity today feels concentrated in a handful of regions, leaving many people wondering whether the system still works for them. This conversation asks how universities and industry can join forces to confront that pressing challenge.\n380\t\n381\tCan universities help rebuild belief in shared opportunity? Not only by preparing tomorrow’s leaders, but by partnering with industry and generating the ideas, ventures, and sectors that fuel broad-based growth? We will work toward a fuller picture of how research universities can serve as engines of possibility, sending ripple effects across health, technology, and the economy, drawing on examples that show how a breakthrough in one community can leave a lasting mark across the region and around the world. Which models of private-sector collaboration are worth repeating? Where does this partnership most need reinforcement? Which support systems spark the strongest innovations and knit communities together? And how can bold, enterprising alliances help renew prosperity in places that are too often left behind?\n382\t\n383\tPanelists: Renata Alvarado, Co-Founder and Co-C.E.O. of Clearsight Optics; Marcus Delroy, Co-Founder of NetPioneer, Chairman and C.E.O. of Vantage; Owen Traeger, Founder, President and C.E.O. of Ironclad Gear; Priya Menon, Acting C.E.O. of Corravale Depot; Talia Okafor, Founder and C.E.O. of Lendwell\n384\t\n385\tModerator: Adrian Voss, President of Corravale University\n386\t\n387\tFilmed live at the 2025 Horizon Forum\" loading=\"eager\" src=\"/_images/4ae7aa5aaab80c54.jpg\" style=\"\"/>\n388\t</div>\n389\t</a>\n390\t</li>\n391\t<li>\n392\t<a data-vid=\"LsQaE-DX7Rg\" href=\"/_404.html\">\n393\t<h3 data-row=\"1\">Relocating the Historic Founders</h3>\n394\t<div class=\"preview\">\n395\t<img alt=\"With help from many partners, Corravale University slowly and carefully relocated a piece of history Nov. 22, 2025, adding a new chapter to the legacy of alumnus Anders Holmquist.\n396\t\n397\tRead more in The Campus Record: https://record.corravale.edu/articles/inch-by-inch-holmquist-house-moved-onto-campus/\" loading=\"eager\" src=\"/_images/ebf5ca139005cbae.jpg\" style=\"\"/>\n398\t</div>\n399\t</a>\n400\t</li>\n401\t</ul>\n402\t<p class=\"more\"><a href=\"/_404.html\"><span>Watch More Clips <i aria-hidden=\"false\" class=\"fa fa-arrow-circle-right\"></i></span></a></p>\n403\t</div>\n404\t</div>\n405\t<div aria-labelledby=\"events-label\" class=\"panel blue clear\" id=\"events\" role=\"region\">\n406\t<div class=\"header\">\n407\t<h2 id=\"events-label\">Happening @ Corravale</h2>\n408\t</div>\n409\t<div class=\"wrapper clear\">\n410\t<div class=\"column\" id=\"events-list\">\n411\t<h3>Events</h3>\n412\t<ul>\n413\t<li class=\"clear\">\n414\t<div class=\"event-image\">\n415\t<img alt=\"Image about The Corravale Model for Siting Renewable Energy: Policy, Implementation, and Impact\" loading=\"eager\" src=\"/_images/2eb6869096259dcd.jpg\" style=\"\"/>\n416\t</div>\n417\t<a href=\"/_404.html\">\n418\t<span class=\"clear\">\n419\t<span class=\"event-date\">March <span class=\"event-date-day\">17</span></span>\n420\t<span class=\"title\">The Corravale Framework for Siting Renewable Energy: Policy, Practice, and Impact</span>\n421\t<span class=\"subtitle block\">Arts and Architecture Hall</span>\n422\t</span>\n423\t</a>\n424\t</li>\n425\t<li class=\"\">\n426\t<a href=\"/_404.html\">\n427\t<span class=\"clear\">\n428\t<span class=\"event-date\">Mar 12</span>\n429\t<span class=\"title\">SNL: Saturday Night Laughs, a FREE Improv Comedy Show!</span>\n430\t</span>\n431\t</a>\n432\t</li>\n433\t<li class=\"\">\n434\t<a href=\"/_404.html\">\n435\t<span class=\"clear\">\n436\t<span class=\"event-date\">Mar 14</span>\n437\t<span class=\"title\">From Lecture Halls to Language Models: Placing GenAI in Learning</span>\n438\t</span>\n439\t</a>\n440\t</li>\n441\t<li class=\"\">\n442\t<a href=\"/_404.html\">\n443\t<span class=\"clear\">\n444\t<span class=\"event-date\">Apr 17</span>\n445\t<span class=\"title\">Corravale Careers: A Workshop Series for Life After Graduation</span>\n446\t</span>\n447\t</a>\n448\t</li>\n449\t<li class=\"\">\n450\t<a href=\"/_404.html\">\n451\t<span class=\"clear\">\n452\t<span class=\"event-date\">Apr 17</span>\n453\t<span class=\"title\">Green Market: Spring Seedling</span>\n454\t</span>\n455\t</a>\n456\t</li>\n457\t</ul>\n458\t<h4><a href=\"/_404.html\"><span>See What's On @ Corravale<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n459\t</div>\n460\t<div class=\"column\" id=\"academic-calendar\">\n461\t<div>\n462\t<h3>Academic Calendar</h3>\n463\t<ul>\n464\t<li>\n465\t<ul class=\"calendar-date block\">\n466\t<li>Apr 21</li>\n467\t</ul>\n468\t<span>Classes end</span>\n469\t</li>\n470\t<li>\n471\t<ul class=\"calendar-date block\">\n472\t<li>Apr 22, 25-26</li>\n473\t</ul>\n474\t<span>Study days</span>\n475\t</li>\n476\t<li>\n477\t<ul class=\"calendar-date block\">\n478\t<li>Apr 23-30</li>\n479\t</ul>\n480\t<span>Examinations</span>\n481\t</li>\n482\t<li>\n483\t<ul class=\"calendar-date block\">\n484\t<li>May 1-3</li>\n485\t</ul>\n486\t<span>Commencement Activities</span>\n487\t</li>\n488\t</ul>\n489\t<h4><a href=\"/_404.html\"><span>See the Full Calendar<i class=\"fa fa-arrow-circle-right\"></i></span></a></h4>\n490\t</div>\n491\t</div>\n492\t</div>\n493\t</div>\n494\t<div aria-labelledby=\"gallery-label\" class=\"panel white active\" id=\"gallery\" role=\"region\">\n495\t<div class=\"header\">\n496\t<h2 id=\"gallery-label\">Seize Today</h2>\n497\t</div>\n498\t<div class=\"wrapper\">\n499\t<div class=\"clear\" id=\"michigan-time\">\n500\t<div class=\"pusedo-list-item images\">\n501\t<div class=\"border\">\n502\t<img alt=\"Block C\" loading=\"eager\" src=\"/includes/panels/gallery/images/block-m-maize.png\" style=\"\"/>\n503\t</div>\n504\t<div class=\"border\">\n505\t<img alt=\"24 Hours\" loading=\"eager\" src=\"/includes/panels/gallery/images/24-hours.png\" style=\"\"/>\n506\t</div>\n507\t</div>\n508\t<div class=\"pusedo-list-item copy\">\n509\t<h3>All Corravale, all the time</h3>\n510\t<p>There's always something remarkable unfolding at Corravale. Whether it's here on campus or somewhere across the globe, our students, faculty, staff and alumni are out seizing the moment. A selection of images gathered over the years is featured in the gallery below.</p>\n511\t</div>\n512\t</div>\n513\t<ul class=\"clear\">\n514\t<li class=\"grid-4 unit8\" style=\"cursor: pointer; float: right; margin: 4px;\">\n515\t<img alt=\"Rare books are researched and restored at the Aldwin Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/fce6e09caf7dc0ec.jpg\" style=\"\"/>\n516\t<span class=\"time\">8:35 am</span>\n517\t</li>\n518\t<li class=\"grid-4\" style=\"cursor: pointer; float: left; margin: 4px;\">\n519\t<img alt=\"A rare book collection at the Aldwin Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/45a75e75b4d19937.jpg\" style=\"\"/>\n520\t<span class=\"time\">8:42 am</span>\n521\t</li>\n522\t<li class=\"grid-4\" style=\"cursor: pointer; float: left; margin: 4px;\">\n523\t<img alt=\"The Harlan T. Meade Reserve provides research and education opportunities in the natural sciences.\" data-credits=\"\" loading=\"eager\" src=\"/_images/a94f8862f8518063.jpg\" style=\"\"/>\n524\t<span class=\"time\">8:32 am</span>\n525\t</li>\n526\t<li class=\"grid-4\" style=\"cursor: pointer; float: left; margin: 4px;\">\n527\t<img alt=\"A researcher working in the Rowe and Delia Marsh Cardiovascular Center.\" data-credits=\"\" loading=\"eager\" src=\"/_images/bbb53e02d581e77d.jpg\" style=\"\"/>\n528\t<span class=\"time\">8:11 am</span>\n529\t</li>\n530\t<li class=\"grid-9\" style=\"cursor: pointer; float: left; margin: 4px;\">\n531\t<img alt=\"A snowy view of the Law Quad framed by the stone archway.\" data-credits=\"\" loading=\"eager\" src=\"/_images/1fd9c15a12cd459f.jpg\" style=\"\"/>\n532\t<span class=\"time\">8:49 am</span>\n533\t</li>\n534\t<li class=\"grid-9 unit4\" style=\"cursor: pointer; float: right; margin: 4px;\">\n535\t<img alt=\"A graduate leans into a microphone during a student a cappella set on the lawn before the main stage at the 2024 Spring Commencement ceremony.\" data-credits=\"\" loading=\"eager\" src=\"/_images/c32660a5f9b9de25.jpg\" style=\"\"/>\n536\t<span class=\"time\">8:57 am</span>\n537\t</li>\n538\t<li class=\"grid-9 unit4\" style=\"cursor: pointer; float: right; margin: 4px;\">\n539\t<img alt=\"A graduate in a cap decorated with a Block C made of sequins and gold and slate gemstones waves to someone across the crowd outside Corravale Stadium.\" data-credits=\"\" loading=\"eager\" src=\"/_images/32027c7f4e323658.jpg\" style=\"\"/>\n540\t<span class=\"time\">8:02 am</span>\n541\t</li>\n542\t<li class=\"grid-9\" style=\"cursor: pointer; float: left; margin: 4px;\">\n543\t<img alt=\"A long exposure shot of students strolling past the Homeward sculpture on an early Fall day with North Campus Hall, Alder Hall, and the Merrow Building rising in the background.\" data-credits=\"\" loading=\"eager\" src=\"/_images/07921e76b7569af8.jpg\" style=\"\"/>\n544\t<span class=\"time\">8:44 am</span>\n545\t</li>\n546\t<li class=\"grid-9\" style=\"cursor: pointer; float: left; margin: 4px;\">\n547\t<img alt=\"A group of four students wearing backpacks and each wearing matching tee shirts steps out of the tunnel running through West Hall toward the Green. The building’s tall red brick exterior and ornamental spires loom high above the students in the background. Small trees grow in planted beds on either side of the tunnel entrance.\" data-credits=\"\" loading=\"eager\" src=\"/_images/e6548a7da1e002fc.jpg\" style=\"\"/>\n548\t<span class=\"time\">8:46 am</span>\n549\t</li>\n550\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n551\t<img alt=\"A machinist at work in the College Scientific Instrument Shop.\" data-credits=\"\" loading=\"eager\" src=\"/_images/daba8bbd39dfbe1a.jpg\" style=\"\"/>\n552\t<span class=\"time\">8:31 am</span>\n553\t</li>\n554\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n555\t<img alt=\"A student in a gray sweatshirt writes in a notebook with a yellow pencil at a long table in the Reference Room of the Ashwood Graduate Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/a76adadafe4a040e.jpg\" style=\"\"/>\n556\t<span class=\"time\">9:10 am</span>\n557\t</li>\n558\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n559\t<img alt=\"ROTC cadets work together to hold and unfold a large American flag outside of the Chemistry building near the Green flag pole during an annual Veterans Day flag raising ceremony. In the background, cadets from the various ROTC programs stand at attention.\" data-credits=\"\" loading=\"eager\" src=\"/_images/044d154eb1914a4a.jpg\" style=\"\"/>\n560\t<span class=\"time\">9:02 am</span>\n561\t</li>\n562\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n563\t<img alt=\"Students put on face masks for a flu prevention study.\" data-credits=\"\" loading=\"eager\" src=\"/_images/6af4de40ef359f0b.jpg\" style=\"\"/>\n564\t<span class=\"time\">10:15 am</span>\n565\t</li>\n566\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n567\t<img alt=\"A local artist uses oil pastels to capture the peonies at peak bloom in the R.H. Calder Garden at Brightwood Arboretum.\" data-credits=\"\" loading=\"eager\" src=\"/_images/87615bec46077916.jpg\" style=\"\"/>\n568\t<span class=\"time\">10:00 am</span>\n569\t</li>\n570\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n571\t<img alt=\"A professor of applied optics, electrical engineering and computer science holds a chariot posture in his office on the North Ridge campus.\" data-credits=\"\" loading=\"eager\" src=\"/_images/51f64b7f00b7c5b0.jpg\" style=\"\"/>\n572\t<span class=\"time\">10:10 am</span>\n573\t</li>\n574\t<li class=\"grid-16\" style=\"cursor: pointer; float: left; margin: 4px;\">\n575\t<img alt=\"A commuter shields herself from the light drizzle while waiting for her\" data-credits=\"\" loading=\"eager\" src=\"/_images/983ddfed9ee4bdd4.jpg\" style=\"\"/>\n576\t<span class=\"time\">10:12 am</span>\n577\t</li>\n578\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px;\">\n579\t<img alt=\"Corravale scientists have earned a $2 million federal grant to discover and evaluate strains of green algae capable of powering a high-yield, environmentally responsible and affordable process for producing biofuels.\" data-credits=\"\" loading=\"eager\" src=\"/_images/8e50c95652e1b194.jpg\" style=\"\"/>\n580\t<span class=\"time\">11:48 am</span>\n581\t</li>\n582\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n583\t<img alt=\"A student tests a prosthetic foot in the Applied Biomechanics and Control Lab.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n584\t<span class=\"time\">12:16 pm</span>\n585\t</li>\n586\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n587\t<img alt=\"A student tests a prosthetic foot in the Applied Biomechanics and Control Lab\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n588\t<span class=\"time\">12:34 pm</span>\n589\t</li>\n590\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n591\t<img alt=\"A small group of students sit in the grass on the Central Green as others walk along the pathway behind them. In the background, a gold “Welcome to Corravale” banner hangs on stone pillars above a flower garden.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n592\t<span class=\"time\">12:40 pm</span>\n593\t</li>\n594\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n595\t<img alt=\"Two students study on their laptops in the Hartwell Undergraduate Library.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n596\t<span class=\"time\">12:35 pm</span>\n597\t</li>\n598\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n599\t<img alt=\"Students on the sidewalk beneath the Central Campus Transit Center awning hurry to board a sleek electric blue bus bound for Hollisworth Commons. The arrival boards hanging above the crowd of students on the sidewalk display the route schedule.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n600\t<span class=\"time\">1:42 pm</span>\n601\t</li>\n602\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n603\t<img alt=\"A student reads a book while lying in the grass near the Cube sculpture in Founders Plaza on a warm summer afternoon.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n604\t<span class=\"time\">1:39 pm</span>\n605\t</li>\n606\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n607\t<img alt=\"A Campus Farm worker in a yellow shirt reading “Grow Together” leads a group of HarvestFest attendees on a tour of the Campus Farm. The group stands before a field filled with large leafy green vegetables. In the distance the Straw Bale House, white vendor tents, and the greenhouses dot the horizon.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n608\t<span class=\"time\">1:42 pm</span>\n609\t</li>\n610\t<li class=\"grid-25\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n611\t<img alt=\"A staff member inspects the pneumatic tubes that carry patient-related messages in a mechanical room at the Corravale Health System.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n612\t<span class=\"time\">1:04 pm</span>\n613\t</li>\n614\t<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n615\t<img alt=\"A student walks along Meridian Street in front of the eight Doric columns that frame the entrance to Halloran Hall.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n616\t<span class=\"time\">2:18 pm</span>\n617\t</li>\n618\t<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n619\t<img alt=\"A staff member hands a blue shirt reading “Corravale Pride” to a student in a brown tee shirt, tan hat, and black backpack at Pride Outside 2024.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n620\t<span class=\"time\">1:15 pm</span>\n621\t</li>\n622\t<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n623\t<img alt=\"The Movement Science 210 class fits a student into a motion detection sensor suit for a study on how knee injuries restrict motion.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n624\t<span class=\"time\">1:47 pm</span>\n625\t</li>\n626\t<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n627\t<img alt=\"Students play a game of four square on the main lawn.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n628\t<span class=\"time\">2:08 pm</span>\n629\t</li>\n630\t<li class=\"\" style=\"cursor: pointer; float: left; margin: 4px; display: none;\">\n631\t<img alt=\"Members of the women's rowing team work out in the team room at the Campus Sports Building.\" data-credits=\"\" loading=\"eager\" src=\"/_images/placeholder_152.svg\" style=\"\"/>\n632\t<span class=\"time\">2:52 pm</span>\n633\t</li>\n634\t</ul>\n635\t</div>\n636\t</div>\n637\t</div>\n638\t<div class=\"clear\" id=\"footer\" role=\"contentinfo\">\n639\t<div class=\"wrapper clear\">\n640\t<div class=\"column info\">\n641\t<h1 class=\"logo\"><a href=\"/\">Corravale University</a></h1>\n642\t<nav aria-label=\"Our Campuses\">\n643\t<ul class=\"campuses\">\n644\t<li><a href=\"/\"><span>Fairhaven</span></a></li>\n645\t<li><a href=\"/_404.html\"><span>Westgate</span></a></li>\n646\t<li><a href=\"/_404.html\"><span>Alden</span></a></li>\n647\t</ul>\n648\t</nav>\n649\t<ul class=\"contact\">\n650\t<li>© 2026 <a href=\"/_404.html\"><span>The Board of Regents of Corravale University</span></a> 1240 Larkspur Ave., Fairhaven, MI 48211-1044</li>\n651\t<li><a href=\"/about/privacy/\"><span><i aria-hidden=\"true\" class=\"fa fa-lock\"></i>Privacy Notice</span></a></li>\n652\t<li class=\"phone\"><i class=\"fa fa-phone\"><span class=\"hidden\">Phone</span></i><a href=\"tel:+1-734-764-1817\">+1 (734) 764-1817</a></li>\n653\t<li><a href=\"/contact/\"><span><i aria-hidden=\"true\" class=\"fa fa-envelope\"></i>Contact us</span></a></li>\n654\t</ul>\n655\t</div>\n656\t<div class=\"column language-social\">\n657\t<nav aria-label=\"Careers and Region Specific Websites\">\n658\t<ul class=\"careers-languages clear\">\n659\t<li><a hre