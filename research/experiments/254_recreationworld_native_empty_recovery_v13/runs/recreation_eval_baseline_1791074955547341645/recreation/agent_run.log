{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_kQOSHsmwoxV5IHDqmFNK5532","type":"tool_result","content":"60\t  { name: \"Aid & Funding\", to: \"/_404.html\", phone: \"734-763-6600\", email: \"financial.aid@corravale.edu\" },\n61\t  { name: \"Housing & Residence\", to: \"/_404.html\", phone: \"734-763-3164\", email: \"housing@corravale.edu\" },\n62\t  { name: \"Technology Support Desk\", to: \"/_404.html\", phone: \"734-764-HELP (4357)\", email: \"ithelp@corravale.edu\", chat: \"Chat with a support agent\" },\n63\t  { name: \"Web Accessibility\", to: \"/_404.html\", website: \"Report a Web Accessibility Issue\" },\n64\t  { name: \"Corravale News\", to: \"/_404.html\", phone: \"734-764-7260\" },\n65\t  { name: \"Social Media Listings\", to: \"/_404.html\" },\n66\t  { name: \"Corravale Health\", to: \"/_404.html\", phone: \"734-936-6641\" },\n67\t];\n68\t\n69\texport function ContactPage() {\n70\t  return (\n71\t    <>\n72\t      <PageTitle>Contact Us</PageTitle>\n73\t      <section className=\"bg-[#333] py-8\">\n74\t        <div className=\"mx-auto max-w-[1100px] px-5\">\n75\t          <p className=\"mb-8 text-[15px] leading-relaxed text-white/85\">\n76\t            Have a question but unsure where to start or whom to reach? To point you in the right direction,\n77\t            we've gathered some of the most frequently contacted Corravale departments in the table below.\n78\t            Should you not find the office tied to your particular need, please try our site search to locate\n79\t            the right resource.\n80\t          </p>\n81\t          <h4 className=\"mb-4 font-cond text-[15px] tracking-[0.1em] text-white uppercase\">\n82\t            Most Frequently Reached Campus\n83\t          </h4>\n84\t          <ul className=\"mb-8 divide-y divide-white/15 border-y border-white/15\">\n85\t            {departments.map((d) => (\n86\t              <li key={d.name} className=\"grid gap-1 py-3 sm:grid-cols-[1fr_auto] sm:items-center\">\n87\t                <span className=\"text-[15px] text-maize\">\n88\t                  {d.to ? <Link to={d.to} className=\"hover:underline\">{d.name}</Link> : d.name}\n89\t                </span>\n90\t                <span className=\"flex flex-wrap gap-x-6 text-[13px] text-white/85\">\n91\t                  {d.phone && <span>{d.phone}</span>}\n92\t                  {d.email && <span>{d.email}</span>}\n93\t                  {d.website && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.website}</Link>}\n94\t                  {d.chat && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.chat}</Link>}\n95\t                </span>\n96\t              </li>\n97\t            ))}\n98\t          </ul>\n99\t          <h4 className=\"mb-3 font-cond text-[15px] tracking-[0.1em] text-white uppercase\">\n100\t            More Contact Options and Links\n101\t          </h4>\n102\t          <ul className=\"mb-6 space-y-1\">\n103\t            {[\n104\t              [\"Find a Department or Unit\", \"/schools-colleges/\"],\n105\t              [\"Find People on Campus\", \"/_404.html\"],\n106\t              [\"Request Transcripts\", \"/_404.html\"],\n107\t              [\"Public Records Requests\", \"/_404.html\"],\n108\t            ].map(([l, to]) => (\n109\t              <li key={l}>\n110\t                <Link to={to} className=\"flex items-center gap-2 text-[14px] text-maize hover:underline\">\n111\t                  {l} <CircleArrowRight size={13} />\n112\t                </Link>\n113\t              </li>\n114\t            ))}\n115\t          </ul>\n116\t          <h4 className=\"mb-2 font-cond text-[15px] tracking-[0.1em] text-white uppercase\">Mailing Addresses</h4>\n117\t          <p className=\"mb-6 text-[14px] text-white/85\">\n118\t            Every campus office at Corravale maintains a unique mailing address. Please{\" \"}\n119\t            <Link to=\"/search/\" className=\"text-maize underline\">browse</Link> our website for a college or\n120\t            unit page to locate the mailing addresses for specific offices.\n121\t          </p>\n122\t          <h4>\n123\t            <Link to=\"/_404.html\" className=\"flex items-center gap-2 font-cond text-[15px] tracking-[0.1em] text-maize uppercase hover:underline\">\n124\t              Getting Here/Maps/Directions <CircleArrowRight size={13} />\n125\t            </Link>\n126\t          </h4>\n127\t        </div>\n128\t      </section>\n129\t    </>\n130\t  );\n131\t}\n132\t\n133\t/* ---------------- Search ---------------- */\n134\texport function SearchPage() {\n135\t  return (\n136\t    <>\n137\t      <PageTitle>Search</PageTitle>\n138\t      <section className=\"bg-[#f4f4f4] py-10\">\n139\t        <div className=\"mx-auto max-w-[760px] px-5\">\n140\t          <form className=\"flex flex-wrap items-end gap-4\" onSubmit={(e) => e.preventDefault()} role=\"search\">\n141\t            <label className=\"flex flex-col gap-1 text-[15px] text-[#333]\">\n142\t              Keywords\n143\t              <input\n144\t                type=\"text\"\n145\t                className=\"h-[30px] w-[320px] border border-[#999] bg-white px-2 outline-none\"\n146\t              />\n147\t            </label>\n148\t            <button\n149\t              type=\"submit\"\n150\t              className=\"flex items-center gap-2 bg-[#e8e8e8] px-4 py-[6px] text-[15px] text-[#333] hover:bg-[#ddd]\"\n151\t            >\n152\t              <SearchGlyph /> Search\n153\t            </button>\n154\t          </form>\n155\t        </div>\n156\t      </section>\n157\t    </>\n158\t  );\n159\t}\n160\t\n161\t/* ---------------- Privacy Notice ---------------- */\n162\texport function PrivacyPage() {\n163\t  return (\n164\t    <ProsePage title=\"Corravale Privacy Notice\">\n165\t      <p className=\"mb-4\">Last Revision Date — May 12, 2024</p>\n166\t      <p className=\"mb-6\">\n167\t        Corravale University recognizes and values the privacy of its community members and guests. We work\n168\t        to set the standard in the ways we handle your personal information. We are dedicated to transparency\n169\t        by helping you understand what personal information we gather, how we make use of it, and when we\n170\t        choose to share it.\n171\t      </p>\n172\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">At a Glance</h4>\n173\t      <p className=\"mb-3\">If you don't have time for the full privacy notice below, here is what you should know:</p>\n174\t      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n175\t        <li>Corravale University is a large institution that operates many different websites. This notice applies to our primary website, corravale.edu. Individual Corravale units and organizations may maintain their own privacy notices.</li>\n176\t        <li>Our aim is to limit the information we gather to only what we need to support our academic, research, and healthcare missions.</li>\n177\t        <li>We are committed to using your personal information only for the purposes for which it was originally gathered.</li>\n178\t        <li>We never sell your personal information, and when we share it beyond Corravale, we do so only to enable operations and services carried out on the university's behalf, to satisfy legal obligations, or to protect the safety, property, or rights of the university, its community and guests.</li>\n179\t        <li>We aim to provide you <Link to=\"/about/privacy/#choices\" className=\"text-[#1a5fa8] underline\">choices</Link> regarding the personal information gathered on our website.</li>\n180\t        <li>If you have questions or concerns about your privacy on the corravale.edu website, please contact the <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Data Privacy Office</Link>.</li>\n181\t      </ul>\n182\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Reach</h4>\n183\t      <p className=\"mb-3\">\n184\t        This privacy notice explains how we handle personal information gathered on the Corravale primary\n185\t        website (corravale.edu). The broader <Link to=\"/about/privacy-statement/\" className=\"text-[#1a5fa8] underline\">privacy overview</Link>{\" \"}\n186\t        outlines the activities carried out across Corravale that involve the gathering and processing of your\n187\t        personal information.\n188\t      </p>\n189\t      <p className=\"mb-6\">\n190\t        Corravale schools, departments, units, clubs, labs, and other groups may keep privacy notices specific\n191\t        to their own collection and processing of your personal information, especially where it differs from\n192\t        the practices set out in this notice.\n193\t      </p>\n194\t      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Information That We Gather</h4>\n195\t      <p className=\"mb-3\">The Corravale website gathers personal information through the following channels:</p>\n196\t      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n197\t        <li>When you provide it to us directly, such as when you subscribe to a newsletter. This information may include your name and contact details.</li>\n198\t        <li>\n199\t          When technology records your information <em>in real time</em>, such as when a small file is stored\n200\t          on your device. Information gathered this way may include:\n201\t          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n202\t            <li>The network domain you use</li>\n203\t            <li>The device's IP address</li>\n204\t            <li>The browser you use</li>\n205\t            <li>The visit's date and time</li>\n206\t            <li>The address of the site that referred you to corravale.edu.</li>\n207\t          </ul>\n208\t        </li>\n209\t        <li>\n210\t          Once <em>external advertising and analytics partners</em>, such as PageMetrics, gather your\n211\t          information on our behalf. Examples of the details collected by these external service partners\n212\t          include:\n213\t          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n214\t            <li>Pages viewed during the session</li>\n215\t            <li>Time and date of access</li>\n216\t            <li>Total time spent browsing the site</li>\n217\t            <li>Approximate location from IP address</li>\n218\t            <li>General demographic data</li>\n219\t            <li>Search queries typed into the site.</li>"}]},"parent_tool_use_id":null,"session_id":"4f294820-3d93-47f5-9a04-120fee6677b4","uuid":"24ead141-4028-4d26-87a6-ca9d08770840","timestamp":"2026-10-04T00:55:31.833Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/recreation/src/pages/MorePages.tsx","content":"  { name: \"Aid & Funding\", to: \"/_404.html\", phone: \"734-763-6600\", email: \"financial.aid@corravale.edu\" },\n  { name: \"Housing & Residence\", to: \"/_404.html\", phone: \"734-763-3164\", email: \"housing@corravale.edu\" },\n  { name: \"Technology Support Desk\", to: \"/_404.html\", phone: \"734-764-HELP (4357)\", email: \"ithelp@corravale.edu\", chat: \"Chat with a support agent\" },\n  { name: \"Web Accessibility\", to: \"/_404.html\", website: \"Report a Web Accessibility Issue\" },\n  { name: \"Corravale News\", to: \"/_404.html\", phone: \"734-764-7260\" },\n  { name: \"Social Media Listings\", to: \"/_404.html\" },\n  { name: \"Corravale Health\", to: \"/_404.html\", phone: \"734-936-6641\" },\n];\n\nexport function ContactPage() {\n  return (\n    <>\n      <PageTitle>Contact Us</PageTitle>\n      <section className=\"bg-[#333] py-8\">\n        <div className=\"mx-auto max-w-[1100px] px-5\">\n          <p className=\"mb-8 text-[15px] leading-relaxed text-white/85\">\n            Have a question but unsure where to start or whom to reach? To point you in the right direction,\n            we've gathered some of the most frequently contacted Corravale departments in the table below.\n            Should you not find the office tied to your particular need, please try our site search to locate\n            the right resource.\n          </p>\n          <h4 className=\"mb-4 font-cond text-[15px] tracking-[0.1em] text-white uppercase\">\n            Most Frequently Reached Campus\n          </h4>\n          <ul className=\"mb-8 divide-y divide-white/15 border-y border-white/15\">\n            {departments.map((d) => (\n              <li key={d.name} className=\"grid gap-1 py-3 sm:grid-cols-[1fr_auto] sm:items-center\">\n                <span className=\"text-[15px] text-maize\">\n                  {d.to ? <Link to={d.to} className=\"hover:underline\">{d.name}</Link> : d.name}\n                </span>\n                <span className=\"flex flex-wrap gap-x-6 text-[13px] text-white/85\">\n                  {d.phone && <span>{d.phone}</span>}\n                  {d.email && <span>{d.email}</span>}\n                  {d.website && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.website}</Link>}\n                  {d.chat && <Link to=\"/_404.html\" className=\"text-maize hover:underline\">{d.chat}</Link>}\n                </span>\n              </li>\n            ))}\n          </ul>\n          <h4 className=\"mb-3 font-cond text-[15px] tracking-[0.1em] text-white uppercase\">\n            More Contact Options and Links\n          </h4>\n          <ul className=\"mb-6 space-y-1\">\n            {[\n              [\"Find a Department or Unit\", \"/schools-colleges/\"],\n              [\"Find People on Campus\", \"/_404.html\"],\n              [\"Request Transcripts\", \"/_404.html\"],\n              [\"Public Records Requests\", \"/_404.html\"],\n            ].map(([l, to]) => (\n              <li key={l}>\n                <Link to={to} className=\"flex items-center gap-2 text-[14px] text-maize hover:underline\">\n                  {l} <CircleArrowRight size={13} />\n                </Link>\n              </li>\n            ))}\n          </ul>\n          <h4 className=\"mb-2 font-cond text-[15px] tracking-[0.1em] text-white uppercase\">Mailing Addresses</h4>\n          <p className=\"mb-6 text-[14px] text-white/85\">\n            Every campus office at Corravale maintains a unique mailing address. Please{\" \"}\n            <Link to=\"/search/\" className=\"text-maize underline\">browse</Link> our website for a college or\n            unit page to locate the mailing addresses for specific offices.\n          </p>\n          <h4>\n            <Link to=\"/_404.html\" className=\"flex items-center gap-2 font-cond text-[15px] tracking-[0.1em] text-maize uppercase hover:underline\">\n              Getting Here/Maps/Directions <CircleArrowRight size={13} />\n            </Link>\n          </h4>\n        </div>\n      </section>\n    </>\n  );\n}\n\n/* ---------------- Search ---------------- */\nexport function SearchPage() {\n  return (\n    <>\n      <PageTitle>Search</PageTitle>\n      <section className=\"bg-[#f4f4f4] py-10\">\n        <div className=\"mx-auto max-w-[760px] px-5\">\n          <form className=\"flex flex-wrap items-end gap-4\" onSubmit={(e) => e.preventDefault()} role=\"search\">\n            <label className=\"flex flex-col gap-1 text-[15px] text-[#333]\">\n              Keywords\n              <input\n                type=\"text\"\n                className=\"h-[30px] w-[320px] border border-[#999] bg-white px-2 outline-none\"\n              />\n            </label>\n            <button\n              type=\"submit\"\n              className=\"flex items-center gap-2 bg-[#e8e8e8] px-4 py-[6px] text-[15px] text-[#333] hover:bg-[#ddd]\"\n            >\n              <SearchGlyph /> Search\n            </button>\n          </form>\n        </div>\n      </section>\n    </>\n  );\n}\n\n/* ---------------- Privacy Notice ---------------- */\nexport function PrivacyPage() {\n  return (\n    <ProsePage title=\"Corravale Privacy Notice\">\n      <p className=\"mb-4\">Last Revision Date — May 12, 2024</p>\n      <p className=\"mb-6\">\n        Corravale University recognizes and values the privacy of its community members and guests. We work\n        to set the standard in the ways we handle your personal information. We are dedicated to transparency\n        by helping you understand what personal information we gather, how we make use of it, and when we\n        choose to share it.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">At a Glance</h4>\n      <p className=\"mb-3\">If you don't have time for the full privacy notice below, here is what you should know:</p>\n      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n        <li>Corravale University is a large institution that operates many different websites. This notice applies to our primary website, corravale.edu. Individual Corravale units and organizations may maintain their own privacy notices.</li>\n        <li>Our aim is to limit the information we gather to only what we need to support our academic, research, and healthcare missions.</li>\n        <li>We are committed to using your personal information only for the purposes for which it was originally gathered.</li>\n        <li>We never sell your personal information, and when we share it beyond Corravale, we do so only to enable operations and services carried out on the university's behalf, to satisfy legal obligations, or to protect the safety, property, or rights of the university, its community and guests.</li>\n        <li>We aim to provide you <Link to=\"/about/privacy/#choices\" className=\"text-[#1a5fa8] underline\">choices</Link> regarding the personal information gathered on our website.</li>\n        <li>If you have questions or concerns about your privacy on the corravale.edu website, please contact the <Link to=\"/_404.html\" className=\"text-[#1a5fa8] underline\">Data Privacy Office</Link>.</li>\n      </ul>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Reach</h4>\n      <p className=\"mb-3\">\n        This privacy notice explains how we handle personal information gathered on the Corravale primary\n        website (corravale.edu). The broader <Link to=\"/about/privacy-statement/\" className=\"text-[#1a5fa8] underline\">privacy overview</Link>{\" \"}\n        outlines the activities carried out across Corravale that involve the gathering and processing of your\n        personal information.\n      </p>\n      <p className=\"mb-6\">\n        Corravale schools, departments, units, clubs, labs, and other groups may keep privacy notices specific\n        to their own collection and processing of your personal information, especially where it differs from\n        the practices set out in this notice.\n      </p>\n      <h4 className=\"mt-6 mb-2 font-cond text-[18px] text-[#00274c]\">Information That We Gather</h4>\n      <p className=\"mb-3\">The Corravale website gathers personal information through the following channels:</p>\n      <ul className=\"mb-6 list-disc space-y-2 pl-6\">\n        <li>When you provide it to us directly, such as when you subscribe to a newsletter. This information may include your name and contact details.</li>\n        <li>\n          When technology records your information <em>in real time</em>, such as when a small file is stored\n          on your device. Information gathered this way may include:\n          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n            <li>The network domain you use</li>\n            <li>The device's IP address</li>\n            <li>The browser you use</li>\n            <li>The visit's date and time</li>\n            <li>The address of the site that referred you to corravale.edu.</li>\n          </ul>\n        </li>\n        <li>\n          Once <em>external advertising and analytics partners</em>, such as PageMetrics, gather your\n          information on our behalf. Examples of the details collected by these external service partners\n          include:\n          <ul className=\"mt-2 list-disc space-y-1 pl-6\">\n            <li>Pages viewed during the session</li>\n            <li>Time and date of access</li>\n            <li>Total time spent browsing the site</li>\n            <li>Approximate location from IP address</li>\n            <li>General demographic data</li>\n            <li>Search queries typed into the site.</li>","numLines":160,"startLine":60,"totalLines":367}}}
