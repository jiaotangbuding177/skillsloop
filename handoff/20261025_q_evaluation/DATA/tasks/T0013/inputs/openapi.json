{
  "openapi": "3.0.3",
  "info": {
    "title": "桥湾报告API",
    "version": "1.3"
  },
  "servers": [
    {
      "url": "https://api.example.com",
      "description": "模拟接口地址，不执行连接"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "x-rate-limit": {
    "requests_per_minute": 60
  },
  "paths": {
    "/v1/reports": {
      "post": {
        "operationId": "createReport",
        "summary": "创建报告任务",
        "description": "异步创建；client_ref在同一合作方内唯一，重复提交返回409。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReport"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "任务已接受，尚未完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedReport"
                }
              }
            }
          },
          "400": {
            "description": "材料无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportError"
                },
                "example": {
                  "error": "invalid_material"
                }
              }
            }
          },
          "409": {
            "description": "当前合作方client_ref已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportError"
                },
                "example": {
                  "error": "duplicate_client_ref"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports/{task_id}": {
      "get": {
        "operationId": "getReport",
        "summary": "查询报告状态",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前报告任务状态；完成时才有下载链接",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque token",
        "description": "Authorization: Bearer <token>；DEMO_TOKEN_NOT_VALID仅示例"
      }
    },
    "schemas": {
      "CreateReport": {
        "type": "object",
        "required": [
          "client_ref",
          "material_ids"
        ],
        "properties": {
          "client_ref": {
            "type": "string",
            "minLength": 1,
            "description": "同合作方内唯一"
          },
          "material_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "language": {
            "type": "string",
            "enum": [
              "zh-CN",
              "en"
            ],
            "default": "zh-CN"
          }
        }
      },
      "AcceptedReport": {
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued"
            ]
          }
        }
      },
      "ReportStatus": {
        "type": "object",
        "required": [
          "status",
          "download_url",
          "error_code"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "done",
              "failed"
            ]
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "只有status=done可用，其他状态为null"
          },
          "error_code": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ReportError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_material",
              "duplicate_client_ref"
            ]
          }
        }
      }
    }
  }
}
